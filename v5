	function menu.SetVisible(v: boolean)
		shown = v
		showToken += 1
		local token = showToken
		if v then
			gui.Enabled = true
			body.GroupTransparency = 1
			scale.Scale = Config.MenuScale * 0.9
			tween(body, med, { GroupTransparency = 0 })
			tween(scale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = Config.MenuScale })
		else
			tween(body, fast, { GroupTransparency = 1 })
			tween(scale, fast, { Scale = Config.MenuScale * 0.94 })
			task.delay(0.16, function()
				if token == showToken then
