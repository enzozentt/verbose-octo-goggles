		-- Returns the row and a hover binder. A refcount keeps hover stable when
		-- the cursor moves between the row and the buttons layered on top of it.
		local function makeRow(height: number, text: string): (Frame, (GuiObject) -> ())
			if not curSection then
				tab.Section("General")
			end
			local sec = curSection
			sec.Order += 1
			local r = New("Frame", {
				Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = sec.Order,
			}, sec.Card)
			local hv = New("Frame", {
				Position = UDim2.fromOffset(5, 2), Size = UDim2.new(1, -10, 1, -4), BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 1, BorderSizePixel = 0,
			}, r)
			New("UICorner", { CornerRadius = UDim.new(0, 8) }, hv)
			local edge = New("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 5, 0.5, 0), Size = UDim2.new(0, 3, 0, 0), BorderSizePixel = 0,
			}, r)
			accent(edge, "BackgroundColor3")
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, edge)
			New("Frame", {
				AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, 0), Size = UDim2.new(1, -28, 0, 1),
				BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.6, BorderSizePixel = 0,
			}, r)
			table.insert(sec.Rows, { Row = r, Text = (text .. " " .. sec.Title):lower() })

			local count = 0
			local function setHover(on: boolean)
				tween(hv, fast, { BackgroundTransparency = if on then 0.93 else 1 })
				tween(edge, fast, { Size = if on then UDim2.new(0, 3, 0.55, 0) else UDim2.new(0, 3, 0, 0) })
				menu.SetTip(if on then (Tips[text] or "") else "")
			end
			local function hov(obj: GuiObject)
				janitor:Add(obj.MouseEnter:Connect(function()
					count += 1
					if count == 1 then
						setHover(true)
					end
				end))
				janitor:Add(obj.MouseLeave:Connect(function()
					count = math.max(0, count - 1)
					if count == 0 then
						setHover(false)
					end
				end))
			end
			hov(r)
			return r, hov
		end
