-- Builds every GUI container and object pool. Called once at startup and again by
-- _rebuildVisuals when a round change (or anything else) destroys part of the HUD.
function HUDManager._createVisuals(self: any)
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	self._playerGui = playerGui
	self._folder = New("Folder", { Name = "TacticalHUD_Tags" }, playerGui)
	self._chamFolder = New("Folder", { Name = "TacticalHUD_Chams" }, Workspace)
	self._overlay = New("ScreenGui", {
		Name = "TacticalHUD_Overlay", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	self._static = New("ScreenGui", {
		Name = "TacticalHUD_Static", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	-- If anything pulls a container out of the world, heal shortly after.
	for _, inst in { self._folder, self._chamFolder, self._overlay, self._static } do
		inst.AncestryChanged:Connect(function()
			if not inst.Parent then
				self:_scheduleHeal(0.2)
			end
		end)
	end

	local folder, overlay, chamFolder = self._folder, self._overlay, self._chamFolder
	self._pool = Pool.new(Config.PoolSize, function()
		return createTag(folder, overlay, chamFolder)
	end, resetTag, destroyTag)
	self._arrowPool = Pool.new(Config.ArrowPoolSize, function()
		return createArrow(overlay)
	end, function(a: TextLabel)
		a.Visible = false
	end, function(a: TextLabel)
		a:Destroy()
	end)

	-- Skeletons: 24 reusable line Frames per item. Joint projections go into
	-- preallocated arrays, so drawing a skeleton allocates nothing.
	self._skelPool = Pool.new(Config.SkeletonPoolSize, function()
		local lines: { Frame } = {}
		for i = 1, 24 do
			lines[i] = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 1, Visible = false,
			}, overlay)
		end
		return { Lines = lines, Used = 0 }
	end, function(item: any)
		for _, l in item.Lines do
			l.Visible = false
		end
		item.Used = 0
	end, function(item: any)
		for _, l in item.Lines do
			l:Destroy()
		end
	end)
end

function HUDManager._scheduleHeal(self: any, delay: number)
	if self._destroyed then
		return
	end
	self._healToken += 1
	local token = self._healToken
	task.delay(delay, function()
		if token == self._healToken and not self._destroyed then
			self:_heal()
		end
	end)
end

-- Throws away the pooled visuals and rebuilds them. Targets keep their bindings and
-- simply re-acquire fresh tags on the next frame.
function HUDManager._rebuildVisuals(self: any)
	self._healCount += 1
	for _, rec in self._list do
		rec.Tag, rec.Arrow, rec.Skel, rec.ArrowAccent, rec.SkelColor = nil, nil, nil, nil, nil
		rec.Alpha, rec.AppliedAlpha, rec.Tier, rec.AppliedCfg, rec.SkelTr = 0, 0, -1, -1, -1
	end
	for _, inst in { self._folder, self._chamFolder, self._overlay, self._static } do
		pcall(function()
			inst:Destroy()
		end)
	end
	self:_createVisuals()
	self:_buildStatic()
	self:_applyStatic()
	self._chamsDirty = true
end

-- Runs every second (and on camera swaps / respawns / container loss): verifies the HUD is
-- intact, recovers leaked pool items, and rebuilds everything if any piece was destroyed.
function HUDManager._heal(self: any)
	local playerGui = localPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end
	local broken = playerGui ~= self._playerGui
	if not broken then
		for _, inst in { self._folder, self._overlay, self._static } do
			if inst.Parent ~= playerGui then
				-- can it be put back? (a destroyed instance refuses to be re-parented)
				local ok = pcall(function()
					inst.Parent = playerGui
				end)
				if not ok or inst.Parent ~= playerGui then
					broken = true
				end
			end
		end
		if self._chamFolder.Parent ~= Workspace then
			local ok = pcall(function()
				self._chamFolder.Parent = Workspace
			end)
			if not ok or self._chamFolder.Parent ~= Workspace then
				broken = true
			end
		end
		self._overlay.Enabled = true
		self._static.Enabled = true
		-- pooled objects that were individually destroyed (e.g. a cleanup that wipes
		-- every Highlight in Workspace, or every Frame it finds)
		if not broken then
			for _, tag in self._pool._all do
				if not (tag.Gui.Parent and tag.Group.Parent and tag.Box.Parent and tag.Tracer.Parent and tag.Chams.Parent) then
					broken = true
					break
				end
			end
		end
		if not broken then
			for _, a in self._arrowPool._all do
				if not a.Parent then
					broken = true
					break
				end
			end
		end
		if not broken then
			for _, item in self._skelPool._all do
				if not item.Lines[1].Parent then
					broken = true
					break
				end
			end
		end
	end
	if broken then
		self:_rebuildVisuals()
		return
	end

	-- leak recovery
	local heldTags, heldArrows, heldSkels = {}, {}, {}
	for _, rec in self._list do
		if rec.Tag then
			heldTags[rec.Tag] = true
		end
		if rec.Arrow then
			heldArrows[rec.Arrow] = true
		end
		if rec.Skel then
			heldSkels[rec.Skel] = true
		end
	end
	self._reclaimed += self._pool:Reclaim(heldTags) + self._arrowPool:Reclaim(heldArrows) + self._skelPool:Reclaim(heldSkels)
end

-- Logs a render-loop error once and schedules a heal, instead of letting it silently
-- kill the visuals every frame.
function HUDManager._reportError(self: any, where: string, err: any)
	self._errCount += 1
	if self._errCount <= 3 then
		warn(("[TacticalHUD] error in %s (visuals self-heal; paste this if it keeps happening): %s"):format(where, tostring(err)))
	end
	self:_scheduleHeal(0.3)
end

-- Highlights: Roblox only renders ~31 at once, so enable the nearest ChamsMax and switch
-- the rest off, instead of letting the engine pick arbitrarily.
function HUDManager._updateChams(self: any)
	local list = self._chamList
	table.clear(list)
	for _, rec in self._list do
		rec.ChamWant = false
		if Config.ShowChams and rec.Tag and rec.Tier >= 0 and rec.Tier <= 1 then
			table.insert(list, rec)
		end
	end
	table.sort(list, function(a: Record, b: Record)
		return a.LastDist < b.LastDist
	end)
	for i = 1, math.min(#list, Config.ChamsMax) do
		list[i].ChamWant = true
	end
	for _, rec in self._list do
		local tag = rec.Tag
		if tag and tag.Chams.Enabled ~= rec.ChamWant then
			tag.Chams.Enabled = rec.ChamWant
		end
	end
end

function HUDManager._invalidate(self: any)
	self._cfgVersion += 1
	self:_applyStatic()
end

-- Camera / viewport -----------------------------------------------------
function HUDManager._setCamera(self: any, camera: Camera?)
	self._camJanitor:Clean()
	self._camera = camera
	if not camera then
		return
	end
	local function updateCenter()
		local vs = camera.ViewportSize
		self._cx, self._cy, self._vh = vs.X * 0.5, vs.Y * 0.5, vs.Y
	end
	updateCenter()
	self._camJanitor:Add(camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateCenter))
end

-- Tag lifecycle ---------------------------------------------------------
function HUDManager._bindTag(self: any, rec: Record, tag: Tag)
	tag.Gui.StudsOffset = rec.TagOffset
	tag.Chams.Adornee = rec.Character
	local p = rec.Player
	local shownName = tostring(p.DisplayName or "")
	tag.Name.Text = if shownName ~= "" then shownName else tostring(p.Name or "?")
	self:_applyTagMode(rec, tag)
	rec.GhostFrac = rec.HealthFrac
	applyHealth(tag, rec.HealthFrac, rec.GhostFrac)
	tag.Group.GroupTransparency = 1
	tag.Box.GroupTransparency = 1
	rec.Tag = tag
	rec.Alpha, rec.AppliedAlpha = 0, 0
	rec.Tier, rec.AppliedCfg, rec.LastDistM = -1, -1, -1 -- forces a full restyle
end

-- Puts the tag content where the current TagMode wants it. Safe to call repeatedly.
function HUDManager._applyTagMode(self: any, rec: Record, tag: Tag)
	if Config.TagMode == "Screen" then
		tag.Gui.Enabled = false
		tag.Gui.Adornee = nil
		if tag.Group.Parent ~= self._overlay then
			tag.Group.Parent = self._overlay
		end
		tag.Group.AnchorPoint = Vector2.new(0.5, 1)
		tag.Group.Size = Config.TagSize
	else
		if tag.Group.Parent ~= tag.Gui then
			tag.Group.Parent = tag.Gui
		end
		tag.Group.AnchorPoint = Vector2.zero
		tag.Group.Position = UDim2.new()
		tag.Group.Size = UDim2.fromScale(1, 1)
		-- Adornee must be a part that is really in the world; fall back to the root
		local a = rec.Anchor
		if not (a and a:IsDescendantOf(Workspace)) then
			a = rec.Root
		end
		tag.Gui.Adornee = a
		tag.Gui.Enabled = a ~= nil
	end
end

function HUDManager._releaseTag(self: any, rec: Record)
	local tag = rec.Tag
	self:_releaseSkel(rec)
	if tag then
		rec.Tag = nil
		self._pool:Release(tag)
	end
	rec.Alpha, rec.AppliedAlpha = 0, 0
end

function HUDManager._releaseArrow(self: any, rec: Record)
	local arrow = rec.Arrow
	if arrow then
		rec.Arrow = nil
		rec.ArrowAccent = nil
		self._arrowPool:Release(arrow)
	end
end

-- Character handling ----------------------------------------------------
function HUDManager._unbindCharacter(self: any, rec: Record)
	rec.BindToken += 1
	rec.CharJanitor:Clean()
	rec.Character, rec.Anchor, rec.Root = nil, nil, nil
	rec.Pending, rec.Refresh, rec.Polled = nil, nil, false
	rec.Verify, rec.HeadPart, rec.HasHealth = nil, nil, false
	table.clear(rec.BoneParts)
	table.clear(rec.BoneAtt)
	table.clear(rec.BoneIdx)
	rec.Alive = false
	rec.Occluded = false
	self:_releaseTag(rec) -- immediate: the anchor is gone, nothing to fade
	self:_releaseArrow(rec)
end

-- Finds a player's character: custom hook, then Player.Character, then a model
-- named after the player in the configured folder (or Workspace).
function HUDManager._resolveCharacter(self: any, player: any): Model?
	if type(player) == "table" then
		return player.Model -- entity: the model is the target
	end
	local hook = Hooks.GetCharacter
	if hook then
		local ok, result = pcall(hook, player)
		return if ok and typeof(result) == "Instance" and result:IsA("Model") then result else nil
	end
	-- 1. the standard property
	local c = player.Character
	if c and c:IsDescendantOf(Workspace) then
		return c
	end
	-- 2. a model named after the player (or their display name) in the character
	--    folder / Workspace, then one level down inside container folders/models
	local name, dname = player.Name, player.DisplayName
	local folder = Hooks.CharacterFolder or Workspace
	local f = folder:FindFirstChild(name) or folder:FindFirstChild(dname)
	if f and f:IsA("Model") and Utils.Plausible(f) then
		return f
	end
	for _, child in folder:GetChildren() do
		if child:IsA("Folder") or child:IsA("Model") then
			local g = child:FindFirstChild(name) or child:FindFirstChild(dname)
			if g and g:IsA("Model") and Utils.Plausible(g) then -- never a map prop that just shares a name
				return g
			end
		end
	end
	-- 3. a rig the discovery pass linked to this player by attribute / ObjectValue
	local mapped = self._ownerMap[player]
	if mapped and mapped:IsDescendantOf(Workspace) and Utils.Plausible(mapped) then
		return mapped
	end
	return nil
end

-- Does this model claim to belong to a Player? Checks the usual attributes
-- (UserId / PlayerId / OwnerId, Player / Owner / PlayerName / OwnerName) and
-- ObjectValues named Player / Owner.
function HUDManager._findOwner(self: any, model: Model): Player?
	for _, key in { "UserId", "PlayerId", "OwnerId", "OwnerUserId" } do
		local v = model:GetAttribute(key)
		if type(v) == "number" then
			local p = Players:GetPlayerByUserId(v)
			if p then
				return p
			end
		end
	end
	for _, key in { "Player", "Owner", "PlayerName", "OwnerName" } do
		local v = model:GetAttribute(key)
		if type(v) == "string" then
			local p = Players:FindFirstChild(v)
			if p and p:IsA("Player") then
				return p
			end
		end
	end
	for _, key in { "Player", "Owner" } do
		local ov = model:FindFirstChild(key)
		if ov and ov:IsA("ObjectValue") and typeof(ov.Value) == "Instance" and ov.Value:IsA("Player") then
			return ov.Value :: Player
		end
	end
	return nil
end

-- Box size / centre / tag height from the model's real bounding box.
-- Skeleton bones = the rig's Motor6D joints (accessories / tools skipped). Rigs
-- without joints fall back to root-to-limb lines. Runs at ~1 Hz, only when the
-- skeleton is on.
function HUDManager._collectBones(self: any, rec: Record)
	local ch, root = rec.Character, rec.Root
	if not (ch and root) then
		return
	end
	local parts, atts, idx = rec.BoneParts, rec.BoneAtt, rec.BoneIdx
	table.clear(parts)
	table.clear(atts)
	table.clear(idx)
	local MAX_BONES = 24
	local map: { [Instance]: number } = {}
	local seen: { [number]: boolean } = {}

	-- A "point" is a BasePart (its Position) or an Attachment/Bone (its WorldPosition).
	local function owner(o: Instance): BasePart?
		if o:IsA("BasePart") then
			return o
		elseif o:IsA("Attachment") then
			local p = o.Parent
			return if p and p:IsA("BasePart") then p else nil
		end
		return nil
	end
	local function usable(o: Instance?): boolean
		if not o then
			return false
		end
		local p = owner(o)
		if not p or not p:IsDescendantOf(ch) then
			return false
		end
		-- accessories, tools and held items are not part of the skeleton
		return p.Name ~= "Handle" and p:FindFirstAncestorWhichIsA("Accessory") == nil and p:FindFirstAncestorWhichIsA("Tool") == nil
	end
	local function pid(o: Instance): number
		local i = map[o]
		if not i then
			table.insert(parts, o)
			table.insert(atts, o:IsA("Attachment"))
			i = #parts
			map[o] = i
		end
		return i
	end
	local function addBone(a: Instance?, b: Instance?)
		if #idx >= MAX_BONES * 2 or a == b or not usable(a) or not usable(b) then
			return
		end
		local ia, ib = pid(a :: Instance), pid(b :: Instance)
		local key = math.min(ia, ib) * 1000 + math.max(ia, ib)
		if seen[key] then
			return
		end
		seen[key] = true
		table.insert(idx, ia)
		table.insert(idx, ib)
	end

	-- 1. Real joints: Motor6D, constraints with attachments (AnimationConstraint, ball/hinge
	--    sockets used by ragdolls...), and Bone hierarchies on skinned meshes.
	for _, d in ch:GetDescendants() do
		if d:IsA("Motor6D") then
			addBone(d.Part0, d.Part1)
		elseif d:IsA("Constraint") then
			addBone(d.Attachment0, d.Attachment1)
		elseif d:IsA("Bone") then
			local p = d.Parent
			if p and p:IsA("Bone") then
				addBone(p, d)
			end
		end
	end
	-- 2. Welded rigs: only if the joints above gave too little to draw.
	if #idx < 8 then
		for _, d in ch:GetDescendants() do
			if d:IsA("Weld") or d:IsA("ManualWeld") or d:IsA("WeldConstraint") then
				addBone(d.Part0, d.Part1)
			end
		end
	end
	-- 3. Universal fallback for ANY rig: a minimum spanning tree over the body's largest
	--    parts, grown from the root. No joint type or naming needed.
	if #idx < 8 then
		table.clear(parts)
		table.clear(atts)
		table.clear(idx)
		table.clear(map)
		table.clear(seen)
		local cand: { BasePart } = {}
		local rp = root.Position
		for _, d in ch:GetDescendants() do
			if d:IsA("BasePart") and d ~= root and usable(d) and (d.Position - rp).Magnitude <= 12 then
				table.insert(cand, d)
			end
		end
		table.sort(cand, function(a: BasePart, b: BasePart)
			local sa, sb = a.Size, b.Size
			return sa.X * sa.Y * sa.Z > sb.X * sb.Y * sb.Z
		end)
		local nodes: { BasePart } = { root }
		for i = 1, math.min(#cand, 13) do
			table.insert(nodes, cand[i])
		end
		local inTree: { [number]: boolean } = { [1] = true }
		for _ = 2, #nodes do
			local bestA, bestB, bestD = 0, 0, math.huge
			for i = 1, #nodes do
				if inTree[i] then
					for j = 1, #nodes do
						if not inTree[j] then
							local dd = (nodes[i].Position - nodes[j].Position).Magnitude
							if dd < bestD then
								bestA, bestB, bestD = i, j, dd
							end
						end
					end
				end
			end
			if bestB == 0 then
				break
			end
			inTree[bestB] = true
			addBone(nodes[bestA], nodes[bestB])
		end
	end
end

function HUDManager._releaseSkel(self: any, rec: Record)
	local s = rec.Skel
	if s then
		rec.Skel = nil
		rec.SkelColor = nil
		rec.SkelTr = -1
		self._skelPool:Release(s)
	end
end

-- Draws the bones as 2D lines. One WorldToViewportPoint per unique joint part.
function HUDManager._drawSkeleton(self: any, rec: Record, color: Color3)
	local parts, idx = rec.BoneParts, rec.BoneIdx
	local nIdx = #idx
	local camera = self._camera :: Camera?
	if nIdx == 0 or not camera then
		return
	end
	local skel = rec.Skel
	if not skel then
		skel = self._skelPool:Acquire()
		if not skel then
			return -- all skeleton slots are in use
		end
		rec.Skel = skel
		rec.SkelColor, rec.SkelTr = nil, -1
	end
	local xs, ys, ok = self._projX, self._projY, self._projOk
	local atts = rec.BoneAtt
	local camPos, right, up, look = self._pPos, self._pRight, self._pUp, self._pLook
	local cx, cy, k = self._cx, self._cy, self._k
	for i = 1, #parts do
		local p = parts[i]
		if p.Parent then
			-- same manual projection as the main loop (works regardless of Camera.ViewportSize)
			local d = (if atts[i] then (p :: Attachment).WorldPosition else (p :: BasePart).Position) - camPos
			local z = d:Dot(look)
			if z > 0.1 then
				xs[i], ys[i], ok[i] = cx + d:Dot(right) / z * k, cy - d:Dot(up) / z * k, true
			else
				ok[i] = false
			end
		else
			ok[i] = false
		end
	end
	local lines = skel.Lines
	local tr = 1 - rec.Alpha * 0.9
	if color ~= rec.SkelColor then
		rec.SkelColor = color
		for _, l in lines do
			l.BackgroundColor3 = color
		end
	end
	if tr ~= rec.SkelTr then
		rec.SkelTr = tr
		for _, l in lines do
			l.BackgroundTransparency = tr
		end
	end
	local thick = Config.SkeletonThickness
	local used = 0
	for b = 1, nIdx, 2 do
		local ia, ib = idx[b], idx[b + 1]
		if ok[ia] and ok[ib] then
			used += 1
			local line = lines[used]
			if not line then
				used -= 1
				break
			end
			local x1, y1, x2, y2 = xs[ia], ys[ia], xs[ib], ys[ib]
			local dx, dy = x2 - x1, y2 - y1
			line.Position = UDim2.fromOffset((x1 + x2) * 0.5, (y1 + y2) * 0.5)
			line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thick)
			line.Rotation = math.deg(math.atan2(dy, dx))
			line.Visible = true
		end
	end
	for i = used + 1, skel.Used do -- hide lines that were visible last frame but not now
		lines[i].Visible = false
	end
	skel.Used = used
end

function HUDManager._measure(self: any, rec: Record)
	if Config.ShowSkeleton then
		self:_collectBones(rec)
	end
	local ch, root, anchor = rec.Character, rec.Root, rec.Anchor
	if not (ch and root and anchor) or not Config.BoxFromModel then
		return
	end
	-- Own AABB over the body parts near the root. Model:GetBoundingBox would include
	-- stray far-away parts (effects, hitbox clones, welded props) and drag the box
	-- to the wrong place, so anything beyond 14 studs of the root is ignored.
	local rp = root.Position
	local minY, maxY, minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge, math.huge, -math.huge
	local n = 0
	for _, d in ch:GetDescendants() do
		if d:IsA("BasePart") then
			local cf, s = d.CFrame, d.Size * 0.5
			local p = cf.Position
			if (p - rp).Magnitude <= 14 then
				local rx, ry, rz = cf.RightVector, cf.UpVector, cf.LookVector
				local ex = math.abs(rx.X) * s.X + math.abs(ry.X) * s.Y + math.abs(rz.X) * s.Z
				local ey = math.abs(rx.Y) * s.X + math.abs(ry.Y) * s.Y + math.abs(rz.Y) * s.Z
				local ez = math.abs(rx.Z) * s.X + math.abs(ry.Z) * s.Y + math.abs(rz.Z) * s.Z
				minX, maxX = math.min(minX, p.X - ex), math.max(maxX, p.X + ex)
				minY, maxY = math.min(minY, p.Y - ey), math.max(maxY, p.Y + ey)
				minZ, maxZ = math.min(minZ, p.Z - ez), math.max(maxZ, p.Z + ez)
				n += 1
			end
		end
	end
	local h = maxY - minY
	if n == 0 or h < 1 or h > 30 then
		-- nothing sensible to measure: fixed size centred on the root
		rec.BoxW, rec.BoxH, rec.CenterY = Config.BoxWidthStuds, Config.BoxHeightStuds, 0
		rec.HeadOffset = Config.BoxHeightStuds * 0.5 - 0.7
		rec.TagOffset = Vector3.new(0, math.max(Config.BoxHeightStuds * 0.5 + 0.8 - (anchor.Position.Y - rp.Y), 0.5), 0)
	else
		h *= 1.04
		rec.BoxH = h
		rec.BoxW = math.clamp(math.max(maxX - minX, maxZ - minZ) * 0.8, h * 0.3, h * 0.7)
		rec.CenterY = math.clamp((minY + maxY) * 0.5 - rp.Y, -h, h)
		-- "head level" for rigs with no head part: just under the top of the body
		rec.HeadOffset = math.max(maxY - math.min(0.7, h * 0.12) - rp.Y, 0.5)
		rec.TagOffset = Vector3.new(0, math.max(maxY - anchor.Position.Y, 0.5) + 0.3, 0)
	end
	local tag = rec.Tag
	if tag then
		tag.Gui.StudsOffset = rec.TagOffset
	end
end

-- Frees one tag held by a non-Player (entity) target so a real Player can use it.
function HUDManager._stealEntityTag(self: any): Tag?
	local list = self._list
	for i = #list, 1, -1 do
		local r = list[i]
		if r.Tag and type(r.Player) == "table" then
			self:_releaseTag(r)
			return self._pool:Acquire()
		end
	end
	return nil
end

-- Time-sliced re-check, one target per frame: catches characters that custom
-- systems spawn/replace without firing CharacterAdded, refreshes box size, and
-- polls health when a GetHealth hook is used.
function HUDManager._rescan(self: any, rec: Record, now: number)
	if now < rec.NextScan then
		return
	end
	rec.NextScan = now + RigConfig.RescanInterval
	local p = rec.Player
	if type(p) == "table" then -- entity: drop it when the model is gone or the discovery mode no longer allows it
		local m: Model = p.Model
		local tagged = CollectionService:HasTag(m, Config.TargetTag)
		local mode = Config.Discovery
		if not m:IsDescendantOf(Workspace) or (not tagged and (mode == "Players" or mode == "Tagged")) then
			self:_removePlayer(m)
			return
		end
		local tn = m:GetAttribute("Team") or m:GetAttribute("TeamName")
		p.Team = if type(tn) == "string" then Teams:FindFirstChild(tn) else nil
		p.DisplayName = tostring(m:GetAttribute("DisplayName") or m.Name)
	end
	local resolved = self:_resolveCharacter(rec.Player)
	local cur = rec.Character
	if cur and not cur:IsDescendantOf(Workspace) then
		self:_unbindCharacter(rec)
		cur = nil
	end
	if resolved and resolved ~= cur and resolved ~= rec.Pending then
		local dup = self._records[resolved] -- an entity already tracks this rig: the Player wins
		if dup and dup ~= rec then
			self:_removePlayer(resolved)
		end
		self:_bindCharacter(rec, resolved)
	elseif not resolved and cur then
		self:_unbindCharacter(rec)
	elseif cur then
		-- the rig's parts were replaced inside the same model (round reset): re-bind
		if rec.Root and not rec.Root:IsDescendantOf(cur) then
			self:_bindCharacter(rec, cur)
			return
		end
		-- the real root may have replicated after we bound a fallback: re-bind once
		local better = Utils.ResolveRoot(cur, false)
		if better and better ~= rec.Root then
			self:_bindCharacter(rec, cur)
			return
		end
		self:_measure(rec)
		-- No usable health source yet (it may appear late): keep looking, once a second.
		if not rec.HasHealth then
			self:_setupHealth(rec, cur, cur:FindFirstChildWhichIsA("Humanoid", true))
			if rec.HasHealth then
				rec.RigInfo = rec.RigInfo:gsub("health=[^\n]*$", "health=" .. rec.HealthSourceName)
			end
		end
		-- Health safety net: re-read every second even for event-driven sources (catches
		-- a renamed attribute / swapped Humanoid), and re-detect if the watchdog objects.
		if rec.Refresh then
			rec.Refresh()
		end
		local verify = rec.Verify
		if verify and verify() then
			self:_bindCharacter(rec, cur)
		end
	end
end

-- Health ------------------------------------------------------------------
-- Collects EVERY health source this rig exposes, in priority order:
--   Hook (Hooks.GetHealth) > Humanoid > attributes (character, then player) > Value objects.
-- Each candidate: { Group, Name, Get() -> (health, max), Connect(janitor, refresh)?, Polled? }
function HUDManager._healthCandidates(self: any, player: any, character: Model, hum: Humanoid?): { any }
	local list: { any } = {}
	local hook = Hooks.GetHealth
	if hook then
		table.insert(list, {
			Group = "Hook", Name = "Hooks.GetHealth (polled)", Polled = true,
			Get = function()
				local ok, h, m = pcall(hook, player, character)
				if ok then
					return h, m
				end
				return nil, nil
			end,
		})
	end
	if hum then
		table.insert(list, {
			Group = "Humanoid", Name = "Humanoid",
			Get = function()
				return hum.Health, hum.MaxHealth
			end,
			Connect = function(j: Janitor, refresh: () -> ())
				j:Add(hum.HealthChanged:Connect(refresh))
				j:Add(hum:GetPropertyChangedSignal("MaxHealth"):Connect(refresh))
			end,
		})
	end
	for _, holder in { { character, "character" }, { player, "player" } } do
		local obj: any = holder[1]
		for _, hn in RigConfig.HealthAttributes do
			if type(obj:GetAttribute(hn)) == "number" then
				local mn: string? = nil
				for _, cand in RigConfig.MaxHealthAttributes do
					if type(obj:GetAttribute(cand)) == "number" then
						mn = cand
						break
					end
				end
				table.insert(list, {
					Group = "Attributes", Name = ("%s attribute '%s'"):format(holder[2], hn),
					Get = function()
						return obj:GetAttribute(hn), if mn then obj:GetAttribute(mn) else nil
					end,
					Connect = function(j: Janitor, refresh: () -> ())
						j:Add(obj:GetAttributeChangedSignal(hn):Connect(refresh))
						if mn then
							j:Add(obj:GetAttributeChangedSignal(mn):Connect(refresh))
						end
					end,
				})
				break
			end
		end
	end
	for _, hn in RigConfig.HealthValueNames do
		local hv: Instance? = character:FindFirstChild(hn, true)
		if not (hv and hv:IsA("ValueBase")) and typeof(player) == "Instance" then
			hv = player:FindFirstChild(hn, true)
		end
		if hv and hv:IsA("ValueBase") and type((hv :: any).Value) == "number" then
			local mv: Instance? = nil
			for _, mn in RigConfig.MaxHealthValueNames do
				local c = if hv.Parent then hv.Parent:FindFirstChild(mn) else nil
				if c and c:IsA("ValueBase") then
					mv = c
					break
				end
			end
			table.insert(list, {
				Group = "Values", Name = ("Value '%s'"):format(hv.Name),
				Get = function()
					return (hv :: any).Value, if mv then (mv :: any).Value else nil
				end,
				Connect = function(j: Janitor, refresh: () -> ())
					j:Add((hv :: any).Changed:Connect(refresh))
					if mv then
						j:Add((mv :: any).Changed:Connect(refresh))
					end
				end,
			})
			break
		end
	end
	return list
end

-- Picks a source, wires it up, and installs the watchdog (rec.Verify) that the
-- rescan uses to catch a source that went bad or a better one that appeared.
function HUDManager._setupHealth(self: any, rec: Record, character: Model, hum: Humanoid?)
	-- Only sources that currently return a real number are eligible, so a dead source
	-- (nil/NaN) is skipped instead of being picked, failing, and re-picked forever.
	local cands: { any } = {}
	for _, c in self:_healthCandidates(rec.Player, character, hum) do
		local h = c.Get()
		if type(h) == "number" and h == h then
			table.insert(cands, c)
		end
	end
	local mode = Config.HealthSource
	local chosen: any = nil
	if mode == "Auto" then
		chosen = cands[1]
		-- A stock Humanoid parked at 100/100 while the game keeps real health elsewhere
		-- is the classic custom-health setup: prefer the first other source with a number.
		if chosen and chosen.Group == "Humanoid" and hum and hum.Health == 100 and hum.MaxHealth == 100 then
			for i = 2, #cands do
				if type(cands[i].Get()) == "number" then
					chosen = cands[i]
					break
				end
			end
		end
	else
		for _, c in cands do
			if c.Group == mode then
				chosen = c
				break
			end
		end
		chosen = chosen or cands[1]
	end

	rec.HealthSourceName = if chosen then chosen.Name else "none found"
	rec.HasHealth = chosen ~= nil
	rec.Polled = chosen ~= nil and chosen.Polled == true
	rec.ObservedMax, rec.BadReads = 0, 0

	local first = true
	local function refresh()
		local h, m = rec.Health, rec.MaxHealth
		if chosen then
			local rh, rm = chosen.Get()
			if type(rh) == "number" then
				h = rh
				rec.ObservedMax = math.max(rec.ObservedMax, h)
				-- no max supplied: fall back to the highest health ever seen
				m = if type(rm) == "number" and rm > 0 then rm else math.max(rec.ObservedMax, 1)
				rec.BadReads = 0
			else
				rec.BadReads += 1 -- keep the last good values
			end
		else
			h, m = 100, 100
		end
		local frac = math.clamp(h / m, 0, 1)
		if frac > rec.GhostFrac or first then
			rec.GhostFrac = frac -- heals / first read: no damage trail
		elseif frac < rec.HealthFrac then
			rec.GhostHold = os.clock() + Config.GhostDelay
		end
		first = false
		rec.Health, rec.MaxHealth = h, m
		rec.HealthFrac = frac
		rec.Alive = Config.IgnoreHealth or chosen == nil or h > 0
		rec.LastDistM = -1 -- re-render the info line on the next tick
		local tag = rec.Tag
		if tag then
			applyHealth(tag, frac, rec.GhostFrac)
		end
	end
	rec.Refresh = refresh
	refresh()
	if chosen and chosen.Connect then
		chosen.Connect(rec.CharJanitor, refresh)
	end

	-- Watchdog: returns a reason string when this source should be re-detected.
	rec.Verify = function()
		if rec.BadReads >= 3 then
			return "source stopped returning numbers"
		end
		if mode == "Auto" and chosen and chosen.Group == "Humanoid" and hum
			and hum.Health == 100 and hum.MaxHealth == 100 then
			for i = 2, #cands do
				if type(cands[i].Get()) == "number" then
					return "a custom health source is available"
				end
			end
		end
		return nil
	end
end

function HUDManager._bindCharacter(self: any, rec: Record, character: Model)
	self:_unbindCharacter(rec)
	local token = rec.BindToken
	rec.Pending = character
	-- Custom rigs can stream parts in late: wait (off the hot path) for a root part.
	task.spawn(function()
		local root: BasePart? = nil
		for i = 1, 30 do -- up to ~3 s; "largest part" is only a fallback after 1.5 s
			root = Utils.ResolveRoot(character, i > 15)
			if root or self._destroyed or rec.BindToken ~= token then
				break
			end
			task.wait(0.1)
		end
		if self._destroyed or rec.BindToken ~= token then
			return
		end
		if not root then
			rec.Pending = nil -- nothing usable yet; the rescan will retry
			return
		end

		local head = Utils.ResolveHead(character)
		local hum = character:FindFirstChildWhichIsA("Humanoid", true)
		if not hum then -- stock rigs add the Humanoid a moment after the parts
			for _ = 1, 10 do
				task.wait(0.1)
				hum = character:FindFirstChildWhichIsA("Humanoid", true)
				if hum or self._destroyed or rec.BindToken ~= token then
					break
				end
			end
			if self._destroyed or rec.BindToken ~= token then
				return
			end
		end
		-- Sanity: a Humanoid's RootPart is authoritative, and a "head" far from the
		-- root is some other part that shares the name, so tags attach to the root.
		local hrp = hum and hum.RootPart
		if hrp and hrp:IsDescendantOf(character) then
			root = hrp
		end
		if head and (head.Position - (root :: BasePart).Position).Magnitude > 10 then
			head = nil
		end
		rec.Character, rec.Anchor, rec.Root = character, head or root, root
		rec.Pending = nil
		self._teamIds[rec.Player] = self:_computeTeamId(rec.Player, character) -- before anything can draw

		rec.HeadPart = head
		self:_setupHealth(rec, character, hum)
		rec.RigInfo = ("root=%s  head=%s  health=%s"):format(
			root.Name, if head then head.Name else "none (head level estimated)", rec.HealthSourceName
		)
		self:_measure(rec)
	end)
end

-- Player handling -------------------------------------------------------
-- `player` is a Player, or an entity table (Utils.MakeEntity) for non-Player targets.
function HUDManager._addPlayer(self: any, player: any)
	local isEntity = type(player) == "table"
	local key: Instance = if isEntity then player.Model else player
	if player == localPlayer or self._records[key] then
		return
	end
	local rec: Record = {
		Player = player, Character = nil, Anchor = nil, Root = nil, Tag = nil, Arrow = nil, ArrowAccent = nil,
		Alpha = 0, AppliedAlpha = 0, Health = 100, MaxHealth = 100, HealthFrac = 1, GhostFrac = 1, GhostHold = 0,
		Alive = false, Occluded = false,
		NextOcclusionCheck = os.clock() + math.random() * Config.OcclusionInterval, -- spread raycasts across frames
		BindToken = 0, Tier = -1, Focused = false, Accent = nil, AppliedCfg = -1, LastDistM = -1,
		Pending = nil, Refresh = nil, Polled = false, NextScan = 0,
		BoxW = Config.BoxWidthStuds, BoxH = Config.BoxHeightStuds, CenterY = 0,
		TagOffset = Config.TagStudsOffset, RigInfo = "not bound yet",
		HealthSourceName = "none yet", HeadPart = nil, HeadOffset = 1.6, HasHealth = false, BadReads = 0, ObservedMax = 0, Verify = nil,
		BoneParts = {}, BoneAtt = {}, BoneIdx = {}, LastDist = 1e9, ChamWant = false,
		Skel = nil, SkelColor = nil, SkelTr = -1,
		CharJanitor = Utils.NewJanitor(), PlayerJanitor = Utils.NewJanitor(),
	}
	self._records[key] = rec
	self._teamIds[player] = self:_computeTeamId(player, nil)
	table.insert(self._list, rec)
	self._count += 1
	if isEntity then
		self._entityCount += 1
	else
		-- team changes take effect immediately, not on the next 1 s sweep
		for _, prop in { "Team", "TeamColor", "Neutral" } do
			rec.PlayerJanitor:Add(player:GetPropertyChangedSignal(prop):Connect(function()
				self._teamIds[player] = self:_computeTeamId(player, rec.Character)
			end))
		end
		rec.PlayerJanitor:Add(player.CharacterAdded:Connect(function(char)
			self:_bindCharacter(rec, char)
		end))
		rec.PlayerJanitor:Add(player.CharacterRemoving:Connect(function()
			self:_unbindCharacter(rec)
		end))
	end
	local existing = self:_resolveCharacter(player)
	if existing then
		self:_bindCharacter(rec, existing)
	end
	if not isEntity then -- the spectate list only shows real Players
		self:_playersChanged()
	end
end

-- `key` is the Player, or the Model for entities.
function HUDManager._removePlayer(self: any, key: Instance)
	local rec = self._records[key]
	if not rec then
		return
	end
	self._records[key] = nil
	local idx = table.find(self._list, rec)
	if idx then
		table.remove(self._list, idx)
	end
	self._count -= 1
	if type(rec.Player) == "table" then
		self._entityCount -= 1
	end
	if self._focusRec == rec then
		self._focusRec = nil
	end
	if self._specPlayer == rec.Player then
		self:Spectate(nil)
	end
	self:_unbindCharacter(rec) -- tag returns to the pool immediately
	rec.PlayerJanitor:Clean()
	if type(rec.Player) ~= "table" then
		self:_playersChanged()
	end
end

function HUDManager._playersChanged(self: any)
	if self._rebuildList then
		self._rebuildList()
	end
end

-- Classification / culling helpers ----------------------------------------
-- Team detection --------------------------------------------------------------
-- Everything that can say "which team is this?" is normalised to a lowercase string
-- id so different sources compare equal: a Team instance and an attribute
-- "Red" both become "red".
local TeamKeys = { "Team", "TeamName", "TeamId", "TeamID", "team", "Side", "Faction" }

local function normTeam(v: any): string?
	local t = typeof(v)
	if t == "Instance" then
		if v:IsA("Team") then
			return v.Name:lower()
		elseif v:IsA("ValueBase") then
			return normTeam((v :: any).Value)
		end
		return v.Name:lower()
	elseif t == "string" then
		return if v == "" then nil else v:lower()
	elseif t == "number" then
		return tostring(v)
	elseif t == "BrickColor" then
		return "color:" .. v.Name
	elseif t == "Color3" then
		return "color:" .. v:ToHex()
	end
	return nil
end

-- Deep team lookup, in priority order: Hooks.GetTeam, Roblox Team, attributes on the
-- player then the character, Value objects in the character, and finally TeamColor.
-- Returns nil only when NO source knows the team.
function HUDManager._computeTeamId(self: any, p: any, character: Model?): string?
	local hook = Hooks.GetTeam
	if hook then
		local ok, r = pcall(hook, p, character)
		if ok then
			local id = normTeam(r)
			if id then
				return id
			end
		end
	end
	local id = normTeam(p.Team)
	if id then
		return id
	end
	for _, key in TeamKeys do
		id = normTeam(p:GetAttribute(key))
		if id then
			return id
		end
		if character then
			id = normTeam(character:GetAttribute(key))
			if id then
				return id
			end
		end
	end
	if character then
		for _, key in TeamKeys do
			local o = character:FindFirstChild(key)
			if o and o:IsA("ValueBase") then
				id = normTeam(o)
				if id then
					return id
				end
			end
		end
	end
	if typeof(p) == "Instance" and not p.Neutral then
		return normTeam(p.TeamColor)
	end
	return nil
end

-- Recomputes our own team and every target's team. Cheap (a few property reads per
-- target); runs every second, on team-change signals, and when the filter changes.
function HUDManager._refreshTeams(self: any)
	self._localTeamId = self:_computeTeamId(localPlayer, self:_resolveCharacter(localPlayer))
	for _, rec in self._list do
		self._teamIds[rec.Player] = self:_computeTeamId(rec.Player, rec.Character)
	end
end

-- 0 neutral (nobody on a team), 1 ally (same team id), 2 enemy
function HUDManager._relation(self: any, player: any): number
	local theirs, mine = self._teamIds[player], self._localTeamId
	if theirs == nil and mine == nil then
		return 0
	end
	return if theirs ~= nil and theirs == mine then 1 else 2
end

-- Is this target a teammate the filter must never draw?
function HUDManager._blockedTeammate(self: any, player: any): boolean
	if not Config.TeamFilter then
		return false
	end
	local r = self:_relation(player)
	return r == 1 or (r == 0 and Config.NeutralCountsAsTeam)
end

-- Should this target be drawn at all? (team filter first, then Mode)
function HUDManager._passesMode(self: any, player: any): boolean
	if Config.TeamFilter then
		return not self:_blockedTeammate(player)
	end
	if Config.Mode == "All" then
		return true
	end
	local r = self:_relation(player)
	if r == 0 then
		return Config.NeutralCountsAsTeam
	end
	return r == 1
end

function HUDManager._accentFor(self: any, player: Player): Color3
	local r = self:_relation(player)
	if r == 1 then
		return Config.AllyColor
	elseif r == 2 then
		return Config.EnemyColor
	end
	return Config.NeutralColor
end

-- Raycasts are the priciest cull: they run last, only for targets that
-- already passed distance + screen tests, and are throttled per target.
function HUDManager._isOccluded(self: any, rec: Record, camPos: Vector3, targetPos: Vector3, now: number): boolean
	if now >= rec.NextOcclusionCheck then
		rec.NextOcclusionCheck = now + Config.OcclusionInterval
		local hit = Workspace:Raycast(camPos, targetPos - camPos, self._rayParams)
		local character = rec.Character
		rec.Occluded = hit ~= nil and character ~= nil and not hit.Instance:IsDescendantOf(character)
	end
	return rec.Occluded
end

-- Style: runs only when tier, focus, relation colour or menu config changes.
function HUDManager._restyle(self: any, rec: Record, tag: Tag, tier: number, focused: boolean, accent: Color3)
	rec.Tier, rec.Focused, rec.Accent = tier, focused, accent
	rec.AppliedCfg = self._cfgVersion
	rec.LastDistM = -1
	self:_applyTagMode(rec, tag) -- picks up a TagMode change from the menu

	local color = if focused then Config.FocusColor else accent
	local full = Config.BoxStyle == "Full"
	local T = Config.BracketThickness
	for i, b in tag.Brackets do
		b.BackgroundColor3 = color
		if tag.BracketH[i] then
			b.Size = UDim2.new(if full then 1 else Config.BracketLenX, 0, 0, T)
		else
			b.Size = UDim2.new(0, T, if full then 1 else Config.BracketLenY, 0)
		end
	end
	tag.BoxFill.BackgroundColor3 = color
	tag.BoxFill.BackgroundTransparency = if focused then Config.FocusFillTransparency else Config.BoxFillTransparency
	tag.Tracer.BackgroundColor3 = color
	tag.Name.TextColor3 = color

	tag.Box.Visible = Config.ShowBoxes
	tag.Tracer.Visible = Config.ShowTracers
	tag.Name.Visible = Config.ShowNames and tier <= 1
	tag.BarBack.Visible = Config.ShowHealth and tier == 0 and rec.HasHealth
	tag.Info.Visible = Config.ShowDistance

	local chams = tag.Chams
	chams.FillColor, chams.OutlineColor = color, color
	chams.FillTransparency = 1 - rec.Alpha * (1 - Config.ChamsFillTransparency)
	chams.OutlineTransparency = 1 - rec.Alpha
	-- On/off is decided by _updateChams (nearest ChamsMax get it): just make sure it can
	-- turn off immediately, and ask for a re-rank now that this target changed.
	if not Config.ShowChams then
		chams.Enabled = false
	end
	self._chamsDirty = true
end

-- Positions the screen-space pieces for one visible target.
function HUDManager._layout(self: any, rec: Record, tag: Tag, vx: number, vy: number, depth: number, dist: number)
	rec.LastDist = dist
	local tier = if dist <= Config.NearDetailDistance then 0 elseif dist <= Config.MidDetailDistance then 1 else 2
	local focused = rec == self._focusRec
	local accent = self:_accentFor(rec.Player)
	if tier ~= rec.Tier or focused ~= rec.Focused or accent ~= rec.Accent or rec.AppliedCfg ~= self._cfgVersion then
		self:_restyle(rec, tag, tier, focused, accent)
	end

	-- Pixel size from FOV: studs * (viewportH / (2 * depth * tan(fov/2))).
	local s = self._k / depth
	local bw, bh = Config.BoxWidthStuds, Config.BoxHeightStuds
	if Config.BoxFromModel then
		bw, bh = rec.BoxW, rec.BoxH
	end
	local w = math.max(s * bw, Config.MinBoxWidth)
	local h = math.max(s * bh, Config.MinBoxHeight)

	if Config.ShowBoxes then
		tag.Box.Position = UDim2.fromOffset(vx, vy)
		tag.Box.Size = UDim2.fromOffset(w, h)
	end

	-- Screen-mode name tag sits on top of the box: independent of any rig part.
	if Config.TagMode == "Screen" then
		tag.Group.Position = UDim2.fromOffset(vx, vy - h * 0.5 - 2)
	end

	if Config.ShowSkeleton and tier <= 1 and dist <= Config.SkeletonMaxDistance then
		self:_drawSkeleton(rec, if rec.Focused then Config.FocusColor else rec.Accent or Config.EnemyColor)
	elseif rec.Skel then
		self:_releaseSkel(rec)
	end

	if Config.ShowTracers then
		local ox, oy = self._cx, self._tracerY
		local tx = vx
		local ty = if oy >= self._cy then vy + h * 0.5 else vy - h * 0.5
		local dx, dy = tx - ox, ty - oy
		tag.Tracer.Position = UDim2.fromOffset((tx + ox) * 0.5, (ty + oy) * 0.5)
		tag.Tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), Config.TracerThickness)
		tag.Tracer.Rotation = math.deg(math.atan2(dy, dx))
	end

	-- Info text allocates, so it updates on the 10 Hz tick and only when the shown value changed.
	if self._distTick and Config.ShowDistance then
		local m = math.floor(dist * Config.StudsToMeters)
		if m ~= rec.LastDistM then
			rec.LastDistM = m
			if tier == 0 and Config.ShowHealth and rec.HasHealth then
				tag.Info.Text = string.format("%dm  |  %d HP", m, math.ceil(rec.Health))
			else
				tag.Info.Text = string.format("%dm", m)
			end
		end
	end
end

-- Static overlay (crosshair, ring, watermark, radar, focus card) --------
