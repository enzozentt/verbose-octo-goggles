			local step: number? = o.Step
			local isLog: boolean = o.Log == true
			local fmt: (number) -> string = o.Format or function(v: number)
				return tostring(math.floor(v * 100 + 0.5) / 100)
			end
			local row, hov = makeRow(50, text)
			rowLabel(row, text, -100).Position = UDim2.fromOffset(14, -7)
			local value = New("TextLabel", {
				AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Position = UDim2.new(1, -14, 0, 8),
				Size = UDim2.fromOffset(120, 16), Font = Enum.Font.GothamBold, TextSize = 12,
