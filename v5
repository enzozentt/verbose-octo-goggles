			jan:Add(hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					grow(true)
					activeSlider = fromX
					activeEnd = function()
						dragging = false
						grow(false)
					end
					fromX(input.Position.X)
				end
			end))
