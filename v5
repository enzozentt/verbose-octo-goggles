		return shown
	end
	jan:Add(close.Activated:Connect(function()
		menu.SetVisible(false)
	end))
	function menu.SetAccent(c)
		Theme.Accent = c
		for _, r in accentRefs do
			r[1][r[2]] = c
		end
		refreshAll()
	end
	function menu.Destroy()
		gui:Destroy()
	end

	-- key / mouse capture for binds
	function menu.HandleInput(input)
		local l = listening
		if not l then
			return false
		end
		local t = input.UserInputType
		local bind
		if t == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = nil
				refreshAll()
				return true
			end
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				bind = input.KeyCode
			end
		elseif l.mouse and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3) then
			if t == Enum.UserInputType.MouseButton1 then
				local m = UserInputService:GetMouseLocation()
				local p, s = l.button.AbsolutePosition, l.button.AbsoluteSize
				if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y then
					listening = nil -- clicking the chip again cancels
					refreshAll()
					return true
				end
			end
			bind = t
		else
			return false
		end
		listening = nil
		if bind then
			l.set(bind)
			onChange()
		end
		refreshAll()
		return true
	end

