local function createTag(overlay, chamFolder)
	local box = New("Frame", {
		Name = "Box", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false,
	}, overlay)
	local fill = New("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundTransparency = 0.95 }, box)
	local brackets, horiz = {}, {}
	for _, c in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		for _, h in { true, false } do
			brackets[#brackets + 1] = New("Frame", {
				AnchorPoint = Vector2.new(c[1], c[2]), Position = UDim2.fromScale(c[1], c[2]), BorderSizePixel = 0,
			}, box)
			horiz[#horiz + 1] = h
		end
	end

	local label = New("Frame", {
		Name = "Label", AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(150, 34), BackgroundTransparency = 1,
		Visible = false,
	}, overlay)
	local name = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Font = FONT_BOLD, TextSize = 14,
		TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.55, TextTruncate = Enum.TextTruncate.AtEnd, Text = "",
	}, label)
	local barBack = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 17), Size = UDim2.fromOffset(72, 4),
		BackgroundColor3 = Color3.fromRGB(8, 8, 10), BackgroundTransparency = 0.3, BorderSizePixel = 0,
	}, label)
	local ghost = New("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, BorderSizePixel = 0,
	}, barBack)
	local hp = New("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 2 }, barBack)
	local info = New("TextLabel", {
		Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Font = FONT, TextSize = 12,
		TextColor3 = Color3.fromRGB(214, 216, 220), TextStrokeTransparency = 0.6, Text = "",
	}, label)

	local tracer = New("Frame", {
		Name = "Tracer", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 0.55, Visible = false,
	}, overlay)
	local chams = New("Highlight", {
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillTransparency = 0.75, OutlineTransparency = 0.1, Enabled = false,
	}, chamFolder)
	return {
		Box = box, Fill = fill, Brackets = brackets, Horiz = horiz, Label = label, Name = name, BarBack = barBack,
		Ghost = ghost, Hp = hp, Info = info, Tracer = tracer, Chams = chams,
	}
end

local function resetTag(t)
	t.Box.Visible, t.Label.Visible, t.Tracer.Visible = false, false, false
	t.Chams.Enabled = false
	t.Chams.Adornee = nil
end

local function destroyTag(t)
	t.Box:Destroy()
	t.Label:Destroy()
	t.Tracer:Destroy()
	t.Chams:Destroy()
end

local function createArrow(overlay)
	return New("Frame", {
		Name = "Arrow", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 3), BorderSizePixel = 0, Visible = false,
	}, overlay)
end

local function createSkeleton(overlay)
	local lines = {}
	for i = 1, BONES do
		lines[i] = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 0.1, Visible = false,
		}, overlay)
		-- a hairline dark outline keeps thin bones readable against any background
		New("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.55 }, lines[i])
	end
	return { Lines = lines, Used = 0, Color = nil }
end

