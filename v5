-- Config <-> text, so settings survive a rejoin (Roblox gives scripts no storage of their own).
local function encodeValue(v)
	local t = typeof(v)
	if t == "Color3" then
		return "#" .. v:ToHex()
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "number" or t == "boolean" or t == "string" then
		return v
	end
	return nil
end

local function decodeValue(current, v)
	local t = typeof(current)
	if t == "Color3" and type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, (v:gsub("^#", "")))
		return ok and c or nil
	elseif t == "EnumItem" and type(v) == "string" then
		local a, b = v:match("^Enum%.(%w+)%.(%w+)$")
		if a == "KeyCode" or a == "UserInputType" then
			local ok, item = pcall(function()
				return Enum[a][b]
			end)
			if ok and typeof(item) == "EnumItem" then
				return item
			end
		end
		return nil
	elseif type(v) == t then
		return v
	end
	return nil
end

function HUD:ExportConfig()
	local out = {}
	for k, v in Config do
		local e = encodeValue(v)
		if e ~= nil then
			out[k] = e
		end
	end
	return HttpService:JSONEncode(out)
end

function HUD:ImportConfig(text)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	if not ok or type(data) ~= "table" then
		return 0
	end
	local applied = 0
	for k, v in data do
		local cur = Config[k]
		if cur ~= nil then
			local dv = decodeValue(cur, v)
			if dv ~= nil then
				if k == "MenuScale" then
					dv = math.clamp(dv, 0.7, 1.3)
				end
				Config[k] = dv
				applied += 1
			end
		end
	end
	self.lockHeld, self.lockToggled = false, false
	self.menu.SetAccent(Config.Accent)
	self.menu.Fit()
	self:_bump()
	self.menu.Refresh()
	return applied
end

