-- Discovery (non-Player targets, and rigs the Player path can't find) ------
-- Event-driven: new Humanoids / rig-shaped parts / tagged models are picked up
-- as they appear, plus a one-time chunked scan and a slow sweep for anything
-- the events missed (e.g. a head streaming in after the root).
function HUDManager._consider(self: any, model: Model)
	if self._records[model] or not model:IsDescendantOf(Workspace) then
		return
	end
	local mode = Config.Discovery
	local tagged = CollectionService:HasTag(model, Config.TargetTag)
	if mode == "Players" and not tagged then
		return
	end
	local rejectedAt = self._rejected[model]
	if rejectedAt and os.clock() - rejectedAt < 4 then
		return
	end
	if self._entityCount >= Config.MaxEntities or model.Name == localPlayer.Name or Players:GetPlayerFromCharacter(model) then
		return
	end
	local lc = self:_resolveCharacter(localPlayer)
	if lc and (model == lc or model:IsDescendantOf(lc) or lc:IsDescendantOf(model)) then
		return
	end
	local named = Players:FindFirstChild(model.Name)
	if named and named:IsA("Player") then
		return -- the Player path owns this one
	end
	for _, rec in self._list do
		local ch = rec.Character
		if model == rec.Pending or (ch and (model == ch or model:IsDescendantOf(ch))) then
			return
		end
	end
	-- Claimed by a Player (attribute / ObjectValue)? Link it instead of duplicating.
	local owner = self:_findOwner(model)
	if owner then
		if owner ~= localPlayer then
			self._ownerMap[owner] = model
			local rec = self._records[owner]
			if rec then
				rec.NextScan = 0
			end
		end
		return
	end
	local ok = tagged
	if not ok and mode ~= "Tagged" then
		ok = model:FindFirstChildOfClass("Humanoid") ~= nil or (mode == "Aggressive" and Utils.LooksLikeRig(model))
	end
	if not ok then
		self._rejected[model] = os.clock()
		return
	end
	self:_addPlayer(Utils.MakeEntity(model))
end

function HUDManager._onDescendant(self: any, inst: Instance)
	local mode = Config.Discovery
	if mode == "Players" or mode == "Tagged" then
		return
	end
	local isHumanoid = inst:IsA("Humanoid")
	if isHumanoid or (mode == "Aggressive" and inst:IsA("BasePart") and (self._rootNames[inst.Name] or self._headNames[inst.Name])) then
		local m = inst.Parent
		if m and m:IsA("Model") then
			self:_consider(m)
		end
	end
end

function HUDManager._startSweep(self: any)
	self._sweepToken += 1
	local token = self._sweepToken
	task.spawn(function()
		while not self._destroyed and token == self._sweepToken do
			local n = 0
			local function visit(container: Instance)
				for _, c in container:GetChildren() do
					if self._destroyed or token ~= self._sweepToken then
						return
					end
					if c:IsA("Model") then
						self:_consider(c)
						if not self._records[c] then -- maybe a container: look one level inside
							for _, g in c:GetChildren() do
								if g:IsA("Model") then
									self:_consider(g)
								end
							end
						end
					elseif c:IsA("Folder") then
						for _, g in c:GetChildren() do
							if g:IsA("Model") then
								self:_consider(g)
							end
						end
					end
					n += 1
					if n % 25 == 0 then
						task.wait()
					end
				end
			end
			if Config.Discovery ~= "Players" then
				visit(Workspace)
				if Hooks.CharacterFolder then
					visit(Hooks.CharacterFolder)
				end
			end
			for _, t in CollectionService:GetTagged(Config.TargetTag) do
				if t:IsA("Model") then
					self:_consider(t)
				end
			end
			task.wait(6)
		end
	end)
end

function HUDManager._startDiscovery(self: any)
	local function setOf(names: { string }): { [string]: boolean }
		local s = {}
		for _, n in names do
			s[n] = true
		end
		return s
	end
	self._rootNames, self._headNames = setOf(RigConfig.RootPartNames), setOf(RigConfig.HeadPartNames)
	local j = self._janitor
	j:Add(Workspace.DescendantAdded:Connect(function(inst)
		self:_onDescendant(inst)
	end))
	j:Add(CollectionService:GetInstanceAddedSignal(Config.TargetTag):Connect(function(inst)
		if inst:IsA("Model") then
			self:_consider(inst)
		end
	end))
	-- one-time pass over everything already in the world, chunked to avoid a hitch
	task.spawn(function()
		local n = 0
		for _, d in Workspace:GetDescendants() do
			if self._destroyed then
				return
			end
			self:_onDescendant(d)
			n += 1
			if n % 1500 == 0 then
				task.wait()
			end
		end
	end)
	self:_startSweep()
end

-- Re-run discovery from scratch (menu button / mode change).
function HUDManager._rescanAll(self: any)
	for _, rec in self._list do
		rec.NextScan = 0
	end
	table.clear(self._rejected)
	self:_startSweep()
end

-- Re-runs character binding (and with it health/skeleton detection) for every target.
function HUDManager._rebindAll(self: any)
	for _, rec in self._list do
		if rec.Character then
			self:_bindCharacter(rec, rec.Character)
		end
	end
end

-- Health self-test: for every bound target, prints each health source the rig exposes,
-- its current reading, and which one the HUD is using.
function HUDManager.PrintHealthProbe(self: any)
	local out = { ("[TacticalHUD] health probe | HealthSource=%s"):format(Config.HealthSource) }
	for _, rec in self._list do
		local ch = rec.Character
		if ch then
			local hum = ch:FindFirstChildWhichIsA("Humanoid", true)
			local found = {}
			for _, c in self:_healthCandidates(rec.Player, ch, hum) do
				local h, m = c.Get()
				table.insert(found, ("%s = %s / %s"):format(c.Name, tostring(h), tostring(m)))
			end
			table.insert(out, ("%s | using: %s | bar shows %d%% | sources: %s"):format(
				tostring(rec.Player.Name), rec.HealthSourceName, math.floor(rec.HealthFrac * 100 + 0.5),
				if #found > 0 then table.concat(found, "; ") else "NONE FOUND"
			))
		end
	end
	print(table.concat(out, "\n"))
end

-- Prints why each target is (or isn't) being tracked. Use it when a rig won't show.
function HUDManager.PrintReport(self: any)
	local out = {
		("[TacticalHUD] rig report | discovery=%s | records=%d (entities=%d) | players online=%d"):format(
			Config.Discovery, #self._list, self._entityCount, #Players:GetPlayers()
		),
	}
	for _, p in Players:GetPlayers() do
		if p ~= localPlayer then
			local rec = self._records[p]
			local found = self:_resolveCharacter(p)
			table.insert(out, ("PLAYER %s | Player.Character=%s | resolved=%s | %s"):format(
				p.Name,
				if p.Character then p.Character:GetFullName() else "nil",
				if found then found:GetFullName() else "NOT FOUND",
				if rec then rec.RigInfo else "no record"
			))
		end
	end
	for _, rec in self._list do
		if type(rec.Player) == "table" then
			table.insert(out, ("ENTITY %s | alive=%s | %s"):format(rec.Player.Model:GetFullName(), tostring(rec.Alive), rec.RigInfo))
		end
	end
	local s = self._stats
	table.insert(out, ("pipeline: bound=%d tracked=%d mode=%d range=%d screen=%d radius=%d visible=%d"):format(
		s.Bound, s.Total, s.Mode, s.Range, s.Screen, s.Radius, s.Visible
	))
	print(table.concat(out, "\n"))
end

-- Lifecycle -------------------------------------------------------------
function HUDManager.Start(self: any)
	local j = self._janitor

	-- Keep our own character out of occlusion rays; stop spectating on respawn
	-- (the default camera script resets the subject anyway).
	local function onLocalChar(char: Model?)
		self._rayParams.FilterDescendantsInstances = if char then { char } else {}
		if self._specPlayer then
			self._specPlayer = nil
			self._specJanitor:Clean()
			self:_playersChanged()
		end
	end
	onLocalChar(localPlayer.Character)
	j:Add(localPlayer.CharacterAdded:Connect(onLocalChar))
	-- Round changes usually respawn us and/or swap the camera: re-verify the HUD right after.
	j:Add(localPlayer.CharacterAdded:Connect(function()
		self:_scheduleHeal(1)
	end))
	j:Add(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		self:_scheduleHeal(0.5)
	end))

	-- Know our own team before any target can be drawn; react to our own team changes.
	self:_refreshTeams()
	for _, prop in { "Team", "TeamColor", "Neutral" } do
		j:Add(localPlayer:GetPropertyChangedSignal(prop):Connect(function()
			self:_refreshTeams()
		end))
	end

	self:_buildStatic()
	self:_buildMenu()
	self:_applyStatic()

	j:Add(Players.PlayerAdded:Connect(function(p)
		self:_addPlayer(p)
	end))
	j:Add(Players.PlayerRemoving:Connect(function(p)
		self:_removePlayer(p)
	end))
	for _, p in Players:GetPlayers() do
		self:_addPlayer(p)
	end
	self:_startDiscovery()

	local menu = self._menu
	j:Add(UserInputService.InputBegan:Connect(function(input, processed)
		if menu.HandleKey(input) then
			return
		end
		if self._freecam and input.UserInputType == Enum.UserInputType.MouseButton2 then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
		-- Soft-lock bind: a key OR a mouse button. Checked before the keyboard-only
		-- gate below; `processed` keeps clicks on the menu itself from triggering it.
		if not processed and Utils.BindMatches(input, Config.AssistKey) then
			if Config.AssistMode == "Hold" then
				self._assistHeld = true
			elseif Config.AssistMode == "Toggle" then
				self._assistToggled = not self._assistToggled
				menu.Toast(if self._assistToggled then "Soft-lock ON" else "Soft-lock OFF")
			end
		end
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local k = input.KeyCode
		if k == Config.ToggleHudKey then
			Config.Enabled = not Config.Enabled
			menu.Refresh()
		elseif k == Config.ToggleMenuKey then
			menu.Toggle()
		elseif k == Config.SpectateNextKey then
			self:_specCycle(1)
		elseif k == Config.SpectatePrevKey then
			self:_specCycle(-1)
		elseif k == Config.FreecamKey then
			self:SetFreecam(not self._freecam)
		end
	end))
	j:Add(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and self._freecam then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if Utils.BindMatches(input, Config.AssistKey) then
			self._assistHeld = false
		end
	end))
	j:Add(UserInputService.InputChanged:Connect(function(input)
		if self._freecam and input.UserInputType == Enum.UserInputType.MouseMovement
			and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			self._fcYaw -= input.Delta.X * 0.003
			self._fcPitch = math.clamp(self._fcPitch - input.Delta.Y * 0.003, -1.5, 1.5)
		end
	end))

	-- Camera priority + 1: runs after the camera moved this frame, so
	-- projected positions match what is rendered.
	RunService:BindToRenderStep("TacticalHUD", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:Update(dt)
	end)
end

function HUDManager.Destroy(self: any)
	if self._destroyed then
		return
	end
	self._destroyed = true
	RunService:UnbindFromRenderStep("TacticalHUD")
	if self._freecam then
		self:SetFreecam(false)
	end
	self._specJanitor:Clean()
	self._janitor:Clean()
	self._camJanitor:Clean()
	for player in self._records do
		self:_removePlayer(player)
	end
	self._pool:Destroy()
	self._arrowPool:Destroy()
	self._skelPool:Destroy()
	self._chamFolder:Destroy()
	self._folder:Destroy()
	self._overlay:Destroy()
	self._static:Destroy()
	if self._menu then
		self._menu.Destroy()
	end
end

