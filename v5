			end
			janitor:Add(hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					tween(knob, fast, { Size = UDim2.fromOffset(19, 19) })
					tween(kStroke, fast, { Transparency = 0, Thickness = 3 })
					activeDrag = function(i)
						fromX(i.Position.X)
					end
					activeEnd = function()
						tween(knob, fast, { Size = UDim2.fromOffset(14, 14) })
						tween(kStroke, fast, { Transparency = 0.4, Thickness = 2 })
					end
					fromX(input.Position.X)
				end
			end))
			janitor:Add(value.FocusLost:Connect(function()
				tween(vStroke, fast, { Transparency = 1 })
				local typed = tonumber(value.Text:match("-?%d+%.?%d*"))
				if typed then
					-- infer the display scale (e.g. 35 shown for 0.35 -> 100x) from the current value
					local v = get()
					local shownN = tonumber(fmt(v):match("-?%d+%.?%d*"))
					local sc = if shownN and math.abs(v) > 1e-9 then shownN / v else 1
					if sc == 0 or sc ~= sc then
						sc = 1
					end
					commit(typed / sc)
				else
					refreshAll()
				end
			end))
			register(function()
				local v = get()
				local a = if isLog then math.log(v / min) / math.log(max / min) else (v - min) / (max - min)
				a = math.clamp(a, 0, 1)
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.fromScale(a, 0.5)
				if not value:IsFocused() then
					value.Text = fmt(v)
				end
			end)
		end

		function tab.Cycle(text: string, options: { string }, get: () -> string, set: (string) -> ())
			local row, hov = makeRow(36, text)
			rowLabel(row, text, -170)
			local btn = small(row, "", UDim2.fromOffset(140, 26))
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -14, 0.5, 0)
			accent(btn, "TextColor3")
			hov(btn)
			register(function()
				btn.Text = "<  " .. get() .. "  >"
			end)
			janitor:Add(btn.Activated:Connect(function()
				local idx = table.find(options, get()) or 0
				set(options[idx % #options + 1])
				onChange()
				refreshAll()
			end))
		end

		function tab.Swatches(text: string, get: () -> Color3, set: (Color3) -> ())
			local row, hov = makeRow(36, text)
			rowLabel(row, text, -250)
			local holder = New("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(#Palette * 22, 24),
				BackgroundTransparency = 1,
			}, row)
			New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			}, holder)
			hov(holder)
			local strokes = {} :: { UIStroke }
			for i, color in Palette do
				local sw = New("TextButton", {
					Size = UDim2.fromOffset(18, 18), BackgroundColor3 = color, Text = "", AutoButtonColor = false,
					BorderSizePixel = 0, LayoutOrder = i,
				}, holder)
				New("UICorner", { CornerRadius = UDim.new(1, 0) }, sw)
				strokes[i] = New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Enabled = false }, sw)
				hov(sw)
				janitor:Add(sw.MouseEnter:Connect(function()
					tween(sw, fast, { Size = UDim2.fromOffset(22, 22) })
				end))
				janitor:Add(sw.MouseLeave:Connect(function()
					tween(sw, fast, { Size = UDim2.fromOffset(18, 18) })
				end))
				janitor:Add(sw.Activated:Connect(function()
					set(color)
					onChange()
					refreshAll()
				end))
			end
			register(function()
				local cur = get()
				for i, color in Palette do
					strokes[i].Enabled = color == cur
				end
			end)
		end

		-- Bind chip. Click, then press a key (or a mouse button when allowMouse).
		function tab.Keybind(text: string, get: () -> EnumItem, set: (EnumItem) -> (), allowMouse: boolean?)
			local row, hov = makeRow(36, text)
			rowLabel(row, text, -170)
			local btn = small(row, "", UDim2.fromOffset(140, 26))
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -14, 0.5, 0)
			local chipStroke = New("UIStroke", { Thickness = 1.5, Transparency = 1 }, btn)
			accent(chipStroke, "Color")
			hov(btn)
			register(function()
				local l = listening
				if l and l.Button == btn then
					btn.Text = if allowMouse then "key / mouse..." else "press a key..."
					btn.TextColor3 = Theme.Accent
					chipStroke.Transparency = 0
				else
					btn.Text = Utils.BindName(get())
					btn.TextColor3 = Theme.Text
					chipStroke.Transparency = 1
				end
			end)
			janitor:Add(btn.Activated:Connect(function()
				listening = { Button = btn, Set = set, AllowMouse = allowMouse == true }
				refreshAll()
			end))
		end

		function tab.Button(text: string, onClick: () -> (), danger: boolean?)
			local row, hov = makeRow(42, text)
			local btn = New("TextButton", {
				Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 1, -12), BackgroundColor3 = Theme.Off,
				BackgroundTransparency = 0.4, Text = text, Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false,
				TextColor3 = if danger then Config.EnemyColor else Theme.Text, BorderSizePixel = 0,
			}, row)
			New("UICorner", { CornerRadius = UDim.new(0, 8) }, btn)
			local s = New("UIStroke", { Thickness = 1, Transparency = 0.45 }, btn)
			if danger then
				s.Color = Config.EnemyColor
			else
				accent(s, "Color")
			end
			hov(btn)
			janitor:Add(btn.Activated:Connect(function()
				-- click flash: snap to the accent colour, ease back
				btn.BackgroundColor3 = if danger then Config.EnemyColor else Theme.Accent
				btn.BackgroundTransparency = 0.1
				tween(btn, med, { BackgroundColor3 = Theme.Off, BackgroundTransparency = 0.4 })
				onClick()
			end))
		end

		-- Multi-line text area. Returns the label so callers can stream text into it.
		function tab.Info(height: number, getText: (() -> string)?): TextLabel
			local row = makeRow(height, "")
			local l = New("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 6), Size = UDim2.new(1, -36, 1, -12),
				Font = Enum.Font.Code, TextSize = 12, TextColor3 = Theme.Muted, TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "",
			}, row)
			if getText then
				register(function()
					l.Text = getText()
				end)
			end
			return l
		end

		function tab.Container(height: number): Frame
			return (makeRow(height, ""))
		end

		return tab
	end

	return menu
end

----------------------------------------------------------------------
-- HUD MANAGER
----------------------------------------------------------------------
export type Tag = {
	-- world-space name tag
	Gui: BillboardGui,
	Group: CanvasGroup,
	Name: TextLabel,
	Info: TextLabel,
	BarBack: Frame,
	Ghost: Frame,
	Fill: Frame,
	-- screen-space overlay
	Box: CanvasGroup,
	BoxFill: Frame,
	Brackets: { Frame },
	BracketH: { boolean }, -- parallel to Brackets: true = horizontal arm
	Tracer: Frame,
	Chams: Highlight,
}

type Record = {
	Player: any, -- a Player, or an entity table (see Utils.MakeEntity) for non-Player targets
	Character: Model?,
	Anchor: BasePart?, -- Head: name tag attachment
	Root: BasePart?, -- HumanoidRootPart: culling + box centre
	Tag: Tag?,
	Arrow: TextLabel?,
	ArrowAccent: Color3?,
	Alpha: number,
	AppliedAlpha: number,
	Health: number,
	MaxHealth: number,
	HealthFrac: number,
	GhostFrac: number,
	GhostHold: number,
	Alive: boolean,
	Occluded: boolean,
	NextOcclusionCheck: number,
	BindToken: number,
	-- custom-rig data
	Pending: Model?, -- character currently being bound (stops the rescan re-binding it)
	Refresh: (() -> ())?, -- health refresher (polled for Hooks.GetHealth)
	Polled: boolean,
	NextScan: number,
	BoxW: number, -- studs, from the model's bounding box
	BoxH: number,
	CenterY: number, -- bounding-box centre relative to the root part
	TagOffset: Vector3, -- name tag offset above the anchor part
	RigInfo: string, -- shown in Misc: which parts / health source were found
	HealthSourceName: string,
	HeadPart: BasePart?, -- the real head part, if the rig has one
	HeadOffset: number, -- studs above the root to aim/anchor "head level" when there is no head part
	HasHealth: boolean, -- false = no health source found (bar and HP text are hidden)
	BadReads: number, -- consecutive invalid health reads (3 = re-detect the source)
	ObservedMax: number, -- highest health seen; max-health fallback for sources without one
	Verify: (() -> string?)?, -- health watchdog, called on each rescan
	BoneParts: { Instance }, -- unique joint points used by the skeleton (BaseParts or Attachments/Bones)
	BoneAtt: { boolean }, -- parallel to BoneParts: true = Attachment (use WorldPosition)
	BoneIdx: { number }, -- pairs of indices into BoneParts
	LastDist: number, -- last on-screen distance (chams ranking)
	ChamWant: boolean,
	Skel: any, -- pooled skeleton item while one is shown
	SkelColor: Color3?,
	SkelTr: number,
	-- style cache: properties are only rewritten when one of these changes
	Tier: number,
	Focused: boolean,
	Accent: Color3?,
	AppliedCfg: number,
	LastDistM: number,
	CharJanitor: Janitor,
	PlayerJanitor: Janitor,
}

local HUDManager = {}
HUDManager.__index = HUDManager

local function createTag(tagParent: Instance, overlay: Instance, chamParent: Instance): Tag
	local gui = New("BillboardGui", {
		Name = "Tag", Size = Config.TagSize, StudsOffset = Config.TagStudsOffset,
		-- Bottom edge sits on the anchor so the tag stays above the box at any range.
		-- If it sits below instead, negate the Y.
		SizeOffset = Vector2.new(0, 0.5), AlwaysOnTop = true, LightInfluence = 0, ResetOnSpawn = false,
		MaxDistance = math.huge, -- distance culling is ours, not the engine's
		Enabled = false,
	})
	local group = New("CanvasGroup", {
		Name = "Group", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), GroupTransparency = 1,
	}, gui)
	local nameLabel = New("TextLabel", {
		Name = "Name", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Config.NameTextSize + 2),
		Font = Config.NameFont, TextSize = Config.NameTextSize, TextStrokeTransparency = 0.4,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = "",
	}, group)

	local back = New("Frame", {
		Name = "BarBack", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, Config.NameTextSize + 5),
		Size = UDim2.new(0.8, 0, 0, Config.BarHeight), BackgroundColor3 = Config.BarBackColor,
		BackgroundTransparency = Config.BarBackTransparency, BorderSizePixel = 0,
	}, group)
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, back)
	New("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.35, Thickness = 1 }, back)

	local ghost = New("Frame", {
		Name = "Ghost", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.GhostColor,
		BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 1,
	}, back)
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ghost)
	local fill = New("Frame", {
		Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.ColorFull, BorderSizePixel = 0, ZIndex = 2,
	}, back)
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
	New("UIGradient", {
		Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)),
	}, fill)
	for i = 1, 3 do -- 25/50/75% tick marks
		New("Frame", {
			Size = UDim2.new(0, 1, 1, 0), Position = UDim2.fromScale(i / 4, 0), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 3,
		}, back)
	end

	local info = New("TextLabel", {
		Name = "Info", BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, Config.NameTextSize + Config.BarHeight + 8), Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.fromRGB(205, 210, 220),
		TextStrokeTransparency = 0.5, Text = "",
	}, group)
	gui.Parent = tagParent

	-- Screen-space box ------------------------------------------------------
	local box = New("CanvasGroup", {
		Name = "Box", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false,
	}, overlay)
	local boxFill = New("Frame", {
		Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundTransparency = Config.BoxFillTransparency,
		BackgroundColor3 = Config.AllyColor,
	}, box)

	local brackets: { Frame } = {}
	local bracketH: { boolean } = {}
	for _, corner in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		for _, horizontal in { true, false } do
			table.insert(brackets, New("Frame", {
				AnchorPoint = Vector2.new(corner[1], corner[2]), Position = UDim2.fromScale(corner[1], corner[2]),
				BorderSizePixel = 0, BackgroundColor3 = Config.AllyColor,
			}, box))
			table.insert(bracketH, horizontal)
		end
	end

	local tracer = New("Frame", {
		Name = "Tracer", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 1, Visible = false,
	}, overlay)

	local chams = New("Highlight", {
		Name = "Chams", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillTransparency = 1,
		OutlineTransparency = 1, Enabled = false,
	}, chamParent) -- a client-only folder in Workspace: Highlights render reliably from there

	return {
		Gui = gui, Group = group, Name = nameLabel, Info = info, BarBack = back, Ghost = ghost, Fill = fill,
		Box = box, BoxFill = boxFill, Brackets = brackets, BracketH = bracketH, Tracer = tracer, Chams = chams,
	}
end

local function resetTag(tag: Tag)
	tag.Gui.Enabled = false
	tag.Gui.Adornee = nil
	-- the tag content may have been moved to the screen overlay: bring it home
	tag.Group.Parent = tag.Gui
	tag.Group.AnchorPoint = Vector2.zero
	tag.Group.Position = UDim2.new()
	tag.Group.Size = UDim2.fromScale(1, 1)
	tag.Group.GroupTransparency = 1
	tag.Box.Visible = false
	tag.Box.GroupTransparency = 1
	tag.Tracer.Visible = false
	tag.Chams.Enabled = false
	tag.Chams.Adornee = nil
end

local function destroyTag(tag: Tag)
	tag.Group:Destroy() -- may live in the overlay, outside the BillboardGui
	tag.Gui:Destroy()
	tag.Box:Destroy()
	tag.Tracer:Destroy()
	tag.Chams:Destroy()
end

local function applyHealth(tag: Tag, frac: number, ghostFrac: number)
	tag.Fill.Size = UDim2.fromScale(frac, 1)
	tag.Fill.BackgroundColor3 = Utils.HealthColor(frac)
	tag.Ghost.Size = UDim2.fromScale(ghostFrac, 1)
end

local function createArrow(overlay: Instance): TextLabel
	return New("TextLabel", {
		Name = "Arrow", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextSize = 22, Text = "▲", TextStrokeTransparency = 0.3, Visible = false,
	}, overlay)
end

