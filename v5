		TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Text = "Festering Felix",
	}, bar)
	New("TextLabel", {
		Position = UDim2.fromOffset(150, 2), Size = UDim2.new(0, 60, 1, 0), BackgroundTransparency = 1, Font = FONT, TextSize = 12,
		TextColor3 = Theme.Off, TextXAlignment = Enum.TextXAlignment.Left, Text = "v17",
	}, bar)
	local close = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1,
		Font = FONT, TextSize = 20, TextColor3 = Theme.Muted, Text = "×", AutoButtonColor = false,
	}, bar)
	jan:Add(close.MouseEnter:Connect(function()
		tween(close, fast, { TextColor3 = Theme.Text })
	end))
	jan:Add(close.MouseLeave:Connect(function()
		tween(close, fast, { TextColor3 = Theme.Muted })
	end))

	-- tab strip + sliding underline
	local strip = New("Frame", { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, win)
	New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2),
	}, strip)
	New("UIPadding", { PaddingLeft = UDim.new(0, 10) }, strip)
	New("Frame", { Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Line, BorderSizePixel = 0 }, win)
