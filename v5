local HUD = {}
HUD.__index = HUD

function HUD.new()
	local self = setmetatable({}, HUD)
	self.destroyed = false
	self.jan = Janitor()
	self.recs, self.list = {}, {}
	self.teamIds = setmetatable({}, { __mode = "k" })
	self.localTeam = nil
	self.cursor, self.visCursor = 0, 0
	self.cfgVer = 0
	self.ctx = { bestRec = nil, bestScore = math.huge }
	self.stats = { errors = 0, rebuilds = 0, reclaimed = 0 }
	self.tick, self.tickTimer, self.slowTimer, self.chamTimer, self.fpsTimer = false, 0, 0, 0, 0
	self.peekHeld = false
	self.lockHeld, self.lockToggled, self.lockW, self.lockRec, self.lockAim = false, false, 0, nil, nil
	self.losTimer, self.losOk = 0, true
	self.specPlayer, self.specJan, self.freecam = nil, Janitor(), false
	self.fcPos, self.fcPitch, self.fcYaw, self.fcSaved = Vector3.zero, 0, 0, Enum.CameraType.Custom
	self.healToken = 0
	self.chamList = {}

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	params.RespectCanCollide = true -- ghost / non-colliding parts don't count as cover
	self.rayParams = params

	self:_createVisuals()
	return self
end

function HUD:_err(where, e)
	self.stats.errors += 1
	if self.stats.errors <= 3 then
		warn(("[TacticalHUD] error in %s (self-heals): %s"):format(where, tostring(e)))
	end
	self:_scheduleHeal(0.3)
end

function HUD:_bump()
	self.cfgVer += 1
	if self.hudGui then
		self:_applyHud()
	end
	if self.menu then
		self.menu.Fit() -- the menu-size slider
	end
	-- switching the skeleton on: build bones for everyone soon, not at their next 1 s rescan
	if Config.Skeleton and not self.skelWas then
		for _, r in self.list do
			r.NextScan = 0
		end
	end
	self.skelWas = Config.Skeleton
	self:_applyWorld()
end

----------------------------------------------------------------------
-- Containers + pools (also rebuilt by the self-heal)
----------------------------------------------------------------------
function HUD:_createVisuals()
	local pg = localPlayer:WaitForChild("PlayerGui")
	self.playerGui = pg
	-- leftovers from an earlier copy of this script would double-draw
	for _, n in { "TacticalHUD_Overlay", "TacticalHUD_Hud" } do
		local old = pg:FindFirstChild(n)
		if old then
			old:Destroy()
		end
	end
	local oldC = Workspace:FindFirstChild("TacticalHUD_Chams")
	if oldC then
		oldC:Destroy()
	end

	self.overlay = New("ScreenGui", {
		Name = "TacticalHUD_Overlay", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, pg)
	self.hudGui = New("ScreenGui", {
		Name = "TacticalHUD_Hud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 7,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, pg)
	self.chamFolder = New("Folder", { Name = "TacticalHUD_Chams" }, Workspace)
	for _, inst in { self.overlay, self.hudGui, self.chamFolder } do
		inst.AncestryChanged:Connect(function()
			if not inst.Parent then
				self:_scheduleHeal(0.2)
			end
		end)
	end

	local overlay, chamFolder = self.overlay, self.chamFolder
	self.tagPool = Pool.new(80, function()
		return createTag(overlay, chamFolder)
	end, resetTag, destroyTag)
	self.arrowPool = Pool.new(24, function()
		return createArrow(overlay)
	end, function(a)
		a.Visible = false
	end, function(a)
		a:Destroy()
	end)
	self.skelPool = Pool.new(10, function()
		return createSkeleton(overlay)
	end, function(s)
		for _, l in s.Lines do
			l.Visible = false
		end
		s.Used, s.Color = 0, nil
	end, function(s)
		for _, l in s.Lines do
			l:Destroy()
		end
	end)
	self:_buildHud()
	self:_applyHud()
end

function HUD:_rebuild()
	self.stats.rebuilds += 1
	for _, rec in self.list do
		rec.Tag, rec.Arrow, rec.Skel, rec.Applied = nil, nil, nil, nil
	end
	for _, inst in { self.overlay, self.hudGui, self.chamFolder } do
		pcall(function()
			inst:Destroy()
		end)
	end
	self:_createVisuals()
end

function HUD:_scheduleHeal(delay)
	if self.destroyed then
		return
	end
	self.healToken += 1
	local token = self.healToken
	task.delay(delay, function()
		if token == self.healToken and not self.destroyed then
			local ok, e = pcall(self._heal, self)
			if not ok then
				warn("[TacticalHUD] heal error: " .. tostring(e))
			end
		end
	end)
end

-- Every second: verify nothing was destroyed (round cleanups, other scripts), rebuild if so,
-- and recover pool items that leaked.
function HUD:_heal()
	local pg = localPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return
	end
	local broken = pg ~= self.playerGui
	if not broken then
		for _, inst in { self.overlay, self.hudGui } do
			if inst.Parent ~= pg then
				local ok = pcall(function()
					inst.Parent = pg
				end)
				if not ok or inst.Parent ~= pg then
					broken = true
				end
			end
			inst.Enabled = true
		end
		if self.chamFolder.Parent ~= Workspace then
			local ok = pcall(function()
				self.chamFolder.Parent = Workspace
			end)
			if not ok or self.chamFolder.Parent ~= Workspace then
				broken = true
			end
		end
		if not broken then
			for _, t in self.tagPool.all do
				if not (t.Box.Parent and t.Label.Parent and t.Tracer.Parent and t.Chams.Parent) then
					broken = true
					break
				end
			end
			for _, a in self.arrowPool.all do
				if not a.Parent then
					broken = true
					break
				end
			end
			for _, s in self.skelPool.all do
				if not s.Lines[1].Parent then
					broken = true
					break
				end
			end
		end
	end
	if broken then
		self:_rebuild()
		return
	end
	local ht, ha, hs = {}, {}, {}
	for _, rec in self.list do
		if rec.Tag then ht[rec.Tag] = true end
		if rec.Arrow then ha[rec.Arrow] = true end
		if rec.Skel then hs[rec.Skel] = true end
	end
	self.stats.reclaimed += self.tagPool:Reclaim(ht) + self.arrowPool:Reclaim(ha) + self.skelPool:Reclaim(hs)
end

