	-- Tabs ---------------------------------------------------------------
	local function selectTab(index: number, instant: boolean?)
		current = index
		for i, t in tabsData do
			if i == index then
				t.Wrapper.Visible = true
				if instant then
					t.Wrapper.GroupTransparency = 0
					t.Wrapper.Position = UDim2.new()
				else
					t.Wrapper.GroupTransparency = 1
					t.Wrapper.Position = UDim2.fromOffset(0, 14)
					tween(t.Wrapper, med, { GroupTransparency = 0, Position = UDim2.new() })
				end
			else
				t.Wrapper.Visible = false
			end
		end
		local target = UDim2.new(0, 8, 0, tabsData[index].Y)
		if instant then
			selector.Position = target
		else
			tween(selector, TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = target })
		end
		updateTabColors()
	end

	-- Search + section collapse share one visibility pass.
	local function applyFilter()
		local q = search.Text:lower()
		local firstHit: number? = nil
		for i, t in tabsData do
			local count = 0
			for _, r in t.Rows do
				local match = q == "" or r.Text:find(q, 1, true) ~= nil
				if match then
					count += 1
				end
				local collapsed = q == "" and r.Section ~= nil and r.Section.Collapsed
				r.Row.Visible = match and not collapsed
			end
			for _, h in t.Headers do
				h.Visible = q == ""
			end
			t.Count = count
			t.Badge.Visible = q ~= "" and count > 0
			t.Badge.Text = tostring(count)
			local dim = if q ~= "" and count == 0 then 0.65 else 0
			t.Label.TextTransparency, t.Icon.TextTransparency = dim, dim
			if q ~= "" and count > 0 and not firstHit then
				firstHit = i
			end
		end
		if q ~= "" and current > 0 and tabsData[current].Count == 0 and firstHit then
			selectTab(firstHit)
		end
	end
	janitor:Add(search:GetPropertyChangedSignal("Text"):Connect(applyFilter))

