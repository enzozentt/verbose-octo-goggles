			local row, hov = makeRow(34, text)
			rowLabel(row, text, -150)
			local btn = small(row, "", UDim2.fromOffset(124, 24))
			btn.AnchorPoint = Vector2.new(1, 0.5)
			btn.Position = UDim2.new(1, -10, 0.5, 0)
			hov(btn)
			register(function()
				local l = listening
				if l and l.Button == btn then
					btn.Text = "press a key..."
					btn.TextColor3 = Theme.Accent
				else
					btn.Text = get().Name
					btn.TextColor3 = Theme.Text
				end
			end)
			janitor:Add(btn.Activated:Connect(function()
				listening = { Button = btn, Set = set }
				refreshAll()
			end))
		end

		function tab.Button(text: string, onClick: () -> (), danger: boolean?)
			local row, hov = makeRow(34, text)
			local btn = New("TextButton", {
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamBold,
				TextSize = 12, AutoButtonColor = false, TextColor3 = if danger then Config.EnemyColor else Theme.Text,
			}, row)
			local s = New("UIStroke", { Thickness = 1, Transparency = 0.5 }, row)
			if danger then
				s.Color = Config.EnemyColor
			else
				accent(s, "Color")
			end
			hov(btn)
			janitor:Add(btn.Activated:Connect(function()
				-- click flash: snap to the accent colour, ease back
				row.BackgroundColor3 = if danger then Config.EnemyColor else Theme.Accent
				tween(row, med, { BackgroundColor3 = Theme.RowHover })
				onClick()
			end))
		end

		-- Multi-line text area. Returns the label so callers can stream text into it.
		function tab.Info(height: number, getText: (() -> string)?): TextLabel
			local row = makeRow(height, "")
			local l = New("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 1, -12),
				Font = Enum.Font.Code, TextSize = 12, TextColor3 = Theme.Muted, TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "",
			}, row)
			if getText then
				register(function()
					l.Text = getText()
				end)
			end
			return l
		end

		function tab.Container(height: number): Frame
			return (makeRow(height, ""))
		end

		return tab
	end

	return menu
end

----------------------------------------------------------------------
-- HUD MANAGER
----------------------------------------------------------------------
export type Tag = {
	-- world-space name tag
	Gui: BillboardGui,
	Group: CanvasGroup,
	Name: TextLabel,
	Info: TextLabel,
	BarBack: Frame,
	Ghost: Frame,
	Fill: Frame,
	-- screen-space overlay
	Box: CanvasGroup,
	BoxFill: Frame,
	Brackets: { Frame },
	BracketH: { boolean }, -- parallel to Brackets: true = horizontal arm
	Tracer: Frame,
	Chams: Highlight,
}

type Record = {
	Player: Player,
	Character: Model?,
	Anchor: BasePart?, -- Head: name tag attachment
	Root: BasePart?, -- HumanoidRootPart: culling + box centre
	Tag: Tag?,
	Arrow: TextLabel?,
	ArrowAccent: Color3?,
	Alpha: number,
	AppliedAlpha: number,
	Health: number,
	MaxHealth: number,
	HealthFrac: number,
	GhostFrac: number,
	GhostHold: number,
	Alive: boolean,
	Occluded: boolean,
	NextOcclusionCheck: number,
	BindToken: number,
	-- style cache: properties are only rewritten when one of these changes
	Tier: number,
	Focused: boolean,
	Accent: Color3?,
	AppliedCfg: number,
	LastDistM: number,
	CharJanitor: Janitor,
	PlayerJanitor: Janitor,
}

local HUDManager = {}
HUDManager.__index = HUDManager

local function createTag(tagParent: Instance, overlay: Instance): Tag
	local gui = New("BillboardGui", {
		Name = "Tag", Size = Config.TagSize, StudsOffset = Config.TagStudsOffset,
		-- Bottom edge sits on the anchor so the tag stays above the box at any range.
		-- If it sits below instead, negate the Y.
		SizeOffset = Vector2.new(0, 0.5), AlwaysOnTop = true, LightInfluence = 0, ResetOnSpawn = false,
		MaxDistance = math.huge, -- distance culling is ours, not the engine's
		Enabled = false,
	})
	local group = New("CanvasGroup", {
		Name = "Group", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), GroupTransparency = 1,
	}, gui)
	local nameLabel = New("TextLabel", {
		Name = "Name", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Config.NameTextSize + 2),
		Font = Config.NameFont, TextSize = Config.NameTextSize, TextStrokeTransparency = 0.4,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = "",
	}, group)

	local back = New("Frame", {
		Name = "BarBack", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, Config.NameTextSize + 5),
		Size = UDim2.new(0.8, 0, 0, Config.BarHeight), BackgroundColor3 = Config.BarBackColor,
		BackgroundTransparency = Config.BarBackTransparency, BorderSizePixel = 0,
	}, group)
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, back)
	New("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.35, Thickness = 1 }, back)

	local ghost = New("Frame", {
		Name = "Ghost", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.GhostColor,
		BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 1,
	}, back)
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ghost)
	local fill = New("Frame", {
		Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Config.ColorFull, BorderSizePixel = 0, ZIndex = 2,
	}, back)
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
	New("UIGradient", {
		Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)),
	}, fill)
	for i = 1, 3 do -- 25/50/75% tick marks
		New("Frame", {
			Size = UDim2.new(0, 1, 1, 0), Position = UDim2.fromScale(i / 4, 0), BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 3,
		}, back)
	end

	local info = New("TextLabel", {
		Name = "Info", BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, Config.NameTextSize + Config.BarHeight + 8), Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.fromRGB(205, 210, 220),
		TextStrokeTransparency = 0.5, Text = "",
	}, group)
	gui.Parent = tagParent

	-- Screen-space box ------------------------------------------------------
	local box = New("CanvasGroup", {
		Name = "Box", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false,
	}, overlay)
	local boxFill = New("Frame", {
		Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundTransparency = Config.BoxFillTransparency,
		BackgroundColor3 = Config.AllyColor,
	}, box)

	local brackets: { Frame } = {}
	local bracketH: { boolean } = {}
	for _, corner in { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } } do
		for _, horizontal in { true, false } do
			table.insert(brackets, New("Frame", {
				AnchorPoint = Vector2.new(corner[1], corner[2]), Position = UDim2.fromScale(corner[1], corner[2]),
				BorderSizePixel = 0, BackgroundColor3 = Config.AllyColor,
			}, box))
			table.insert(bracketH, horizontal)
		end
	end

	local tracer = New("Frame", {
		Name = "Tracer", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, BackgroundTransparency = 1, Visible = false,
	}, overlay)

	local chams = New("Highlight", {
		Name = "Chams", DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillTransparency = 1,
		OutlineTransparency = 1, Enabled = false,
	}, tagParent)

	return {
		Gui = gui, Group = group, Name = nameLabel, Info = info, BarBack = back, Ghost = ghost, Fill = fill,
		Box = box, BoxFill = boxFill, Brackets = brackets, BracketH = bracketH, Tracer = tracer, Chams = chams,
	}
end

local function resetTag(tag: Tag)
	tag.Gui.Enabled = false
	tag.Gui.Adornee = nil
	tag.Group.GroupTransparency = 1
	tag.Box.Visible = false
	tag.Box.GroupTransparency = 1
	tag.Tracer.Visible = false
	tag.Chams.Enabled = false
	tag.Chams.Adornee = nil
end

local function destroyTag(tag: Tag)
	tag.Gui:Destroy()
	tag.Box:Destroy()
	tag.Tracer:Destroy()
	tag.Chams:Destroy()
end

local function applyHealth(tag: Tag, frac: number, ghostFrac: number)
	tag.Fill.Size = UDim2.fromScale(frac, 1)
	tag.Fill.BackgroundColor3 = Utils.HealthColor(frac)
	tag.Ghost.Size = UDim2.fromScale(ghostFrac, 1)
end

local function createArrow(overlay: Instance): TextLabel
	return New("TextLabel", {
		Name = "Arrow", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextSize = 22, Text = "▲", TextStrokeTransparency = 0.3, Visible = false,
	}, overlay)
end

function HUDManager.new()
	local self = setmetatable({}, HUDManager) :: any
	self._destroyed = false
	self._janitor = Utils.NewJanitor()
	self._records = {} :: { [Player]: Record }
	self._count = 0
	self._cfgVersion = 0
	self._focusRec = nil :: Record?

	local playerGui = localPlayer:WaitForChild("PlayerGui")
	self._folder = New("Folder", { Name = "TacticalHUD_Tags" }, playerGui)
	-- IgnoreGuiInset so overlay pixels match WorldToViewportPoint output.
	self._overlay = New("ScreenGui", {
		Name = "TacticalHUD_Overlay", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	self._static = New("ScreenGui", {
		Name = "TacticalHUD_Static", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)

	self._pool = Pool.new(Config.PoolSize, function()
		return createTag(self._folder, self._overlay)
	end, resetTag, destroyTag)
	self._arrowPool = Pool.new(Config.ArrowPoolSize, function()
		return createArrow(self._overlay)
	end, function(a: TextLabel)
		a.Visible = false
	end, function(a: TextLabel)
		a:Destroy()
	end)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	self._rayParams = params

	self._camera = nil :: Camera?
	self._camJanitor = Utils.NewJanitor()
	self._cx, self._cy, self._vh, self._k, self._tracerY = 0, 0, 0, 1, 0

	self._distTimer, self._distTick = 0, false
	self._statsTimer, self._radarTimer = 0, 0
	self._fpsFrames, self._fpsTimer, self._fps = 0, 0, 60
	self._stats = { Total = 0, Mode = 0, Range = 0, Screen = 0, Radius = 0, Visible = 0, Arrows = 0 }

	-- Spectate / freecam state
	self._specPlayer = nil :: Player?
	self._specJanitor = Utils.NewJanitor()
	self._freecam = false
	self._fcSavedType = Enum.CameraType.Custom
	self._fcPos, self._fcPitch, self._fcYaw = Vector3.zero, 0, 0

	-- Soft-lock state
	self._assistHeld, self._assistToggled = false, false
	self._assistW = 0 -- smoothed 0..1 engagement weight (ramps in and out)
	self._assistRec = nil :: Record?
	self._assistPart = nil :: BasePart?
	self._los, self._losTimer = true, 0
	self._assistLabelOn, self._assistLabelPlayer = false, nil :: Player?
	return self
end

function HUDManager._invalidate(self: any)
	self._cfgVersion += 1
	self:_applyStatic()
end

-- Camera / viewport -----------------------------------------------------
function HUDManager._setCamera(self: any, camera: Camera?)
	self._camJanitor:Clean()
	self._camera = camera
	if not camera then
		return
	end
	local function updateCenter()
		local vs = camera.ViewportSize
		self._cx, self._cy, self._vh = vs.X * 0.5, vs.Y * 0.5, vs.Y
	end
	updateCenter()
	self._camJanitor:Add(camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateCenter))
end

-- Tag lifecycle ---------------------------------------------------------
function HUDManager._bindTag(self: any, rec: Record, tag: Tag)
	tag.Gui.Adornee = rec.Anchor
	tag.Chams.Adornee = rec.Character
	tag.Name.Text = rec.Player.DisplayName
	rec.GhostFrac = rec.HealthFrac
	applyHealth(tag, rec.HealthFrac, rec.GhostFrac)
	tag.Group.GroupTransparency = 1
	tag.Box.GroupTransparency = 1
	tag.Gui.Enabled = true
	rec.Tag = tag
	rec.Alpha, rec.AppliedAlpha = 0, 0
	rec.Tier, rec.AppliedCfg, rec.LastDistM = -1, -1, -1 -- forces a full restyle
end

function HUDManager._releaseTag(self: any, rec: Record)
	local tag = rec.Tag
	if tag then
		rec.Tag = nil
		self._pool:Release(tag)
	end
	rec.Alpha, rec.AppliedAlpha = 0, 0
end

function HUDManager._releaseArrow(self: any, rec: Record)
	local arrow = rec.Arrow
	if arrow then
		rec.Arrow = nil
		rec.ArrowAccent = nil
		self._arrowPool:Release(arrow)
	end
end

-- Character handling ----------------------------------------------------
function HUDManager._unbindCharacter(self: any, rec: Record)
	rec.BindToken += 1
	rec.CharJanitor:Clean()
	rec.Character, rec.Anchor, rec.Root = nil, nil, nil
	rec.Alive = false
	rec.Occluded = false
	self:_releaseTag(rec) -- immediate: the anchor is gone, nothing to fade
	self:_releaseArrow(rec)
end

function HUDManager._bindCharacter(self: any, rec: Record, character: Model)
	self:_unbindCharacter(rec)
	local token = rec.BindToken
	-- Parts replicate slightly after CharacterAdded; wait off the hot path.
	task.spawn(function()
		local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
		local head = character:WaitForChild("Head", 10) :: BasePart?
		local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if self._destroyed or rec.BindToken ~= token or not hum or not head or not root then
			return
		end
		rec.Character, rec.Anchor, rec.Root = character, head, root

		-- Event-driven health: runs only when Health/MaxHealth change.
		local first = true
		local function refresh()
			local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			if frac > rec.GhostFrac or first then
				rec.GhostFrac = frac -- heals / first read: no trail
			elseif frac < rec.HealthFrac then
				rec.GhostHold = os.clock() + Config.GhostDelay
			end
			first = false
			rec.Health, rec.MaxHealth = hum.Health, hum.MaxHealth
			rec.HealthFrac = frac
			rec.Alive = hum.Health > 0
			rec.LastDistM = -1 -- re-render the info line on the next tick
			local tag = rec.Tag
			if tag then
				applyHealth(tag, frac, rec.GhostFrac)
			end
		end
		refresh()
		rec.CharJanitor:Add(hum.HealthChanged:Connect(refresh))
		rec.CharJanitor:Add(hum:GetPropertyChangedSignal("MaxHealth"):Connect(refresh))
	end)
end

-- Player handling -------------------------------------------------------
function HUDManager._addPlayer(self: any, player: Player)
	if player == localPlayer or self._records[player] then
		return
	end
	local rec: Record = {
		Player = player, Character = nil, Anchor = nil, Root = nil, Tag = nil, Arrow = nil, ArrowAccent = nil,
		Alpha = 0, AppliedAlpha = 0, Health = 100, MaxHealth = 100, HealthFrac = 1, GhostFrac = 1, GhostHold = 0,
		Alive = false, Occluded = false,
		NextOcclusionCheck = os.clock() + math.random() * Config.OcclusionInterval, -- spread raycasts across frames
		BindToken = 0, Tier = -1, Focused = false, Accent = nil, AppliedCfg = -1, LastDistM = -1,
		CharJanitor = Utils.NewJanitor(), PlayerJanitor = Utils.NewJanitor(),
	}
	self._records[player] = rec
	self._count += 1

	rec.PlayerJanitor:Add(player.CharacterAdded:Connect(function(char)
		self:_bindCharacter(rec, char)
	end))
	rec.PlayerJanitor:Add(player.CharacterRemoving:Connect(function()
		self:_unbindCharacter(rec)
	end))
	if player.Character then
		self:_bindCharacter(rec, player.Character)
	end
	self:_playersChanged()
end

function HUDManager._removePlayer(self: any, player: Player)
	local rec = self._records[player]
	if not rec then
		return
	end
	self._records[player] = nil
	self._count -= 1
	if self._focusRec == rec then
		self._focusRec = nil
	end
	if self._specPlayer == player then
		self:Spectate(nil)
	end
	self:_unbindCharacter(rec) -- tag returns to the pool immediately
	rec.PlayerJanitor:Clean()
	self:_playersChanged()
end

function HUDManager._playersChanged(self: any)
	if self._rebuildList then
		self._rebuildList()
	end
end

-- Classification / culling helpers ----------------------------------------
function HUDManager._passesMode(self: any, player: Player): boolean
	if Config.Mode == "All" then
		return true
	end
	local mine, theirs = localPlayer.Team, player.Team
	if mine == nil and theirs == nil then
		return Config.NeutralCountsAsTeam
	end
	return mine == theirs
end

-- 0 neutral, 1 ally, 2 enemy
function HUDManager._relation(self: any, player: Player): number
	local mine, theirs = localPlayer.Team, player.Team
	if mine == nil and theirs == nil then
		return 0
	end
	return if mine == theirs then 1 else 2
end

function HUDManager._accentFor(self: any, player: Player): Color3
	local r = self:_relation(player)
	if r == 1 then
		return Config.AllyColor
	elseif r == 2 then
		return Config.EnemyColor
	end
	return Config.NeutralColor
end

-- Raycasts are the priciest cull: they run last, only for targets that
-- already passed distance + screen tests, and are throttled per target.
function HUDManager._isOccluded(self: any, rec: Record, camPos: Vector3, targetPos: Vector3, now: number): boolean
	if now >= rec.NextOcclusionCheck then
		rec.NextOcclusionCheck = now + Config.OcclusionInterval
		local hit = Workspace:Raycast(camPos, targetPos - camPos, self._rayParams)
		local character = rec.Character
		rec.Occluded = hit ~= nil and character ~= nil and not hit.Instance:IsDescendantOf(character)
	end
	return rec.Occluded
end

-- Style: runs only when tier, focus, relation colour or menu config changes.
function HUDManager._restyle(self: any, rec: Record, tag: Tag, tier: number, focused: boolean, accent: Color3)
	rec.Tier, rec.Focused, rec.Accent = tier, focused, accent
	rec.AppliedCfg = self._cfgVersion
	rec.LastDistM = -1

	local color = if focused then Config.FocusColor else accent
	local full = Config.BoxStyle == "Full"
	local T = Config.BracketThickness
	for i, b in tag.Brackets do
		b.BackgroundColor3 = color
		if tag.BracketH[i] then
			b.Size = UDim2.new(if full then 1 else Config.BracketLenX, 0, 0, T)
		else
			b.Size = UDim2.new(0, T, if full then 1 else Config.BracketLenY, 0)
		end
	end
	tag.BoxFill.BackgroundColor3 = color
	tag.BoxFill.BackgroundTransparency = if focused then Config.FocusFillTransparency else Config.BoxFillTransparency
	tag.Tracer.BackgroundColor3 = color
	tag.Name.TextColor3 = color

	tag.Box.Visible = Config.ShowBoxes
	tag.Tracer.Visible = Config.ShowTracers
	tag.Name.Visible = Config.ShowNames and tier <= 1
	tag.BarBack.Visible = Config.ShowHealth and tier == 0
	tag.Info.Visible = Config.ShowDistance

	local chams = tag.Chams
	chams.FillColor, chams.OutlineColor = color, color
	chams.FillTransparency = 1 - rec.Alpha * (1 - Config.ChamsFillTransparency)
	chams.OutlineTransparency = 1 - rec.Alpha
	chams.Enabled = Config.ShowChams and tier <= 1
end

-- Positions the screen-space pieces for one visible target.
function HUDManager._layout(self: any, rec: Record, tag: Tag, vx: number, vy: number, depth: number, dist: number)
	local tier = if dist <= Config.NearDetailDistance then 0 elseif dist <= Config.MidDetailDistance then 1 else 2
	local focused = rec == self._focusRec
	local accent = self:_accentFor(rec.Player)
	if tier ~= rec.Tier or focused ~= rec.Focused or accent ~= rec.Accent or rec.AppliedCfg ~= self._cfgVersion then
		self:_restyle(rec, tag, tier, focused, accent)
	end

	-- Pixel size from FOV: studs * (viewportH / (2 * depth * tan(fov/2))).
	local s = self._k / depth
	local w = math.max(s * Config.BoxWidthStuds, Config.MinBoxWidth)
	local h = math.max(s * Config.BoxHeightStuds, Config.MinBoxHeight)

	if Config.ShowBoxes then
		tag.Box.Position = UDim2.fromOffset(vx, vy)
		tag.Box.Size = UDim2.fromOffset(w, h)
	end

	if Config.ShowTracers then
		local ox, oy = self._cx, self._tracerY
		local tx = vx
		local ty = if oy >= self._cy then vy + h * 0.5 else vy - h * 0.5
		local dx, dy = tx - ox, ty - oy
		tag.Tracer.Position = UDim2.fromOffset((tx + ox) * 0.5, (ty + oy) * 0.5)
		tag.Tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), Config.TracerThickness)
		tag.Tracer.Rotation = math.deg(math.atan2(dy, dx))
	end

	-- Info text allocates, so it updates on the 10 Hz tick and only when the shown value changed.
	if self._distTick and Config.ShowDistance then
		local m = math.floor(dist * Config.StudsToMeters)
		if m ~= rec.LastDistM then
			rec.LastDistM = m
			if tier == 0 and Config.ShowHealth then
				tag.Info.Text = string.format("%dm  |  %d HP", m, math.ceil(rec.Health))
			else
				tag.Info.Text = string.format("%dm", m)
			end
		end
	end
end

-- Static overlay (crosshair, ring, watermark, radar, focus card) --------
function HUDManager._buildStatic(self: any)
	local root = self._static
	local accent = Theme.Accent

	-- Crosshair: four arms + dot around the screen centre
	local ch = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(), BackgroundTransparency = 1,
	}, root)
	local arms = {}
	for i = 1, 4 do
		arms[i] = New("Frame", { BorderSizePixel = 0 }, ch)
	end
	local dot = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0 }, ch)
	self._ch, self._chArms, self._chDot = ch, arms, dot

	-- Focus ring
	local ring = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
	}, root)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, ring)
	self._ringStroke = New("UIStroke", { Thickness = 1.5, Transparency = 0.45, Color = accent }, ring)
	self._ring = ring

	-- Watermark pill
	local wm = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.2, BorderSizePixel = 0,
	}, root)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, wm)
	self._wmStroke = New("UIStroke", { Thickness = 1, Transparency = 0.5, Color = accent }, wm)
	New("UIPadding", {
		PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
	}, wm)
	self._wmLabel = New("TextLabel", {
		AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12,
		TextColor3 = Theme.Text, Text = "TACTICAL HUD",
	}, wm)
	self._wm = wm

	-- Radar
	local radar = New("Frame", {
		BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.3, BorderSizePixel = 0,
