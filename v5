	function menu.HandleKey(input: InputObject): boolean
		local l = listening
		if not l or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return false
		end
		listening = nil
		if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
			l.Set(input.KeyCode)
			onChange()
		end
		refreshAll()
		return true
