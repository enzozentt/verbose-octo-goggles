		function tab.Slider(text: string, min: number, max: number, get: () -> number, set: (number) -> (), opts: any?)
			local o: any = opts or {}
			local step: number? = o.Step
			local isLog: boolean = o.Log == true
			local fmt: (number) -> string = o.Format or function(v: number)
				return tostring(math.floor(v * 100 + 0.5) / 100)
			end
			local row, hov = makeRow(58, text)
			rowLabel(row, text, -130).Position = UDim2.fromOffset(18, -8)
			-- Editable value: type a number (units are inferred from the display format)
			local value = New("TextBox", {
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8), Size = UDim2.fromOffset(104, 22),
				BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Font = Enum.Font.GothamBold,
				TextSize = 12, ClearTextOnFocus = false, Text = "", TextXAlignment = Enum.TextXAlignment.Center,
			}, row)
			accent(value, "TextColor3")
			New("UICorner", { CornerRadius = UDim.new(0, 6) }, value)
			local vStroke = New("UIStroke", { Thickness = 1, Transparency = 1 }, value)
			accent(vStroke, "Color")
			janitor:Add(value.Focused:Connect(function()
				tween(vStroke, fast, { Transparency = 0.2 })
			end))
			local track = New("Frame", {
				Position = UDim2.new(0, 18, 1, -19), Size = UDim2.new(1, -36, 0, 6),
				BackgroundColor3 = if o.Rainbow then Color3.new(1, 1, 1) else Theme.Off, BorderSizePixel = 0,
			}, row)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
			if not o.Rainbow then
				for i = 1, 3 do -- notch ticks at 25/50/75%
					New("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(i / 4, 0.5), Size = UDim2.fromOffset(1, 10),
						BackgroundColor3 = Theme.Muted, BackgroundTransparency = 0.7, BorderSizePixel = 0,
					}, track)
				end
			end
			local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Visible = not o.Rainbow }, track)
			accent(fill, "BackgroundColor3")
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
			New("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 185)) }, fill)
			if o.Rainbow then
				local keys = {}
				for i = 0, 6 do
					table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.85, 1)))
				end
				New("UIGradient", { Color = ColorSequence.new(keys) }, track)
			end
			local knob = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2,
			}, track)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
			local kStroke = New("UIStroke", { Thickness = 2, Transparency = 0.4 }, knob)
			accent(kStroke, "Color")
			local hit = New("TextButton", {
				Position = UDim2.new(0, 18, 1, -30), Size = UDim2.new(1, -36, 0, 28),
				BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
			}, row)
			hov(hit)

			local function commit(v: number)
				if step then
					v = math.floor(v / step + 0.5) * step
				end
				set(math.clamp(v, min, max))
				onChange()
				refreshAll()
			end
			local function fromX(x: number)
				local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				commit(if isLog then min * (max / min) ^ a else min + (max - min) * a)
			end
			janitor:Add(hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					tween(knob, fast, { Size = UDim2.fromOffset(19, 19) })
					tween(kStroke, fast, { Transparency = 0, Thickness = 3 })
					activeDrag = function(i)
						fromX(i.Position.X)
					end
					activeEnd = function()
						tween(knob, fast, { Size = UDim2.fromOffset(14, 14) })
						tween(kStroke, fast, { Transparency = 0.4, Thickness = 2 })
					end
					fromX(input.Position.X)
				end
			end))
			janitor:Add(value.FocusLost:Connect(function()
				tween(vStroke, fast, { Transparency = 1 })
				local typed = tonumber(value.Text:match("-?%d+%.?%d*"))
				if typed then
					-- infer the display scale (e.g. 35 shown for 0.35 -> 100x) from the current value
					local v = get()
					local shownN = tonumber(fmt(v):match("-?%d+%.?%d*"))
					local sc = if shownN and math.abs(v) > 1e-9 then shownN / v else 1
					if sc == 0 or sc ~= sc then
						sc = 1
					end
					commit(typed / sc)
				else
					refreshAll()
				end
			end))
			register(function()
				local v = get()
				local a = if isLog then math.log(v / min) / math.log(max / min) else (v - min) / (max - min)
				a = math.clamp(a, 0, 1)
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.fromScale(a, 0.5)
				if not value:IsFocused() then
					value.Text = fmt(v)
				end
			end)
		end

