-- Re-applies all config-driven static layout. Called from UI events only.
function HUDManager._applyStatic(self: any)
	if not self._ch then
		return
	end
	local accent = Theme.Accent
	local s, g, t = Config.CrosshairSize, Config.CrosshairGap, Config.CrosshairThickness
	local c = Config.CrosshairColor
	local a = self._chArms
	self._ch.Visible = Config.ShowCrosshair
	a[1].AnchorPoint, a[1].Position, a[1].Size = Vector2.new(0.5, 1), UDim2.fromOffset(0, -g), UDim2.fromOffset(t, s)
	a[2].AnchorPoint, a[2].Position, a[2].Size = Vector2.new(0.5, 0), UDim2.fromOffset(0, g), UDim2.fromOffset(t, s)
	a[3].AnchorPoint, a[3].Position, a[3].Size = Vector2.new(1, 0.5), UDim2.fromOffset(-g, 0), UDim2.fromOffset(s, t)
	a[4].AnchorPoint, a[4].Position, a[4].Size = Vector2.new(0, 0.5), UDim2.fromOffset(g, 0), UDim2.fromOffset(s, t)
	for i = 1, 4 do
		a[i].BackgroundColor3 = c
	end
	self._chDot.Visible = Config.CrosshairDot
	self._chDot.Size = UDim2.fromOffset(t + 1, t + 1)
	self._chDot.BackgroundColor3 = c

	self._assistRing.Visible = Config.AssistEnabled and Config.ShowAssistFov
	self._assistRing.Size = UDim2.fromOffset(Config.AssistFov * 2, Config.AssistFov * 2)
	self._ring.Visible = Config.ShowFocusRing
	self._ring.Size = UDim2.fromOffset(Config.FocusRadius * 2, Config.FocusRadius * 2)
	self._ringStroke.Color, self._wmStroke.Color = accent, accent
	self._radarStroke.Color, self._cardStroke.Color = accent, accent
	self._wm.Visible = Config.ShowWatermark

	local radar = self._radar
	local size = Config.RadarSize
	radar.Visible = Config.ShowRadar
	radar.Size = UDim2.fromOffset(size, size)
	local corner = Config.RadarCorner
	local right = corner == "TopRight" or corner == "BottomRight"
	local bottom = corner == "BottomLeft" or corner == "BottomRight"
	radar.AnchorPoint = Vector2.new(if right then 1 else 0, if bottom then 1 else 0)
	radar.Position = UDim2.new(if right then 1 else 0, if right then -14 else 14, if bottom then 1 else 0, if bottom then -14 else 14)
	self._radarRange.Text = ("%dm"):format(math.floor(Config.RadarRange * Config.StudsToMeters))
end

-- Radar: fixed dot array, throttled to 30 Hz, forward = up.
function HUDManager._updateRadar(self: any, camera: Camera, camPos: Vector3)
	local dots = self._radarDots :: { Frame }
	local look = camera.CFrame.LookVector
	local len = math.sqrt(look.X * look.X + look.Z * look.Z)
	if len < 1e-3 then
		return -- looking straight up/down: heading undefined, keep last frame
	end
	local fx, fz = look.X / len, look.Z / len
	local rx, rz = -fz, fx
	local R = Config.RadarSize * 0.5
	local maxR = R - 5
	local pxPerStud = maxR / Config.RadarRange
	local cap = #dots
	local used = 0
	for _, rec in self._records do
		local root = rec.Root
		if root and rec.Alive and used < cap and self:_passesMode(rec.Player) then
			local p = root.Position - camPos
			local dx, dy = (p.X * rx + p.Z * rz) * pxPerStud, (p.X * fx + p.Z * fz) * pxPerStud
			local m = math.sqrt(dx * dx + dy * dy)
			local far = m > maxR
			if far then -- out of radar range: pin to the rim, dimmed
				dx, dy = dx / m * maxR, dy / m * maxR
			end
			used += 1
			local dot = dots[used]
			dot.Position = UDim2.fromOffset(R + dx, R - dy)
			dot.BackgroundColor3 = self:_accentFor(rec.Player)
			dot.BackgroundTransparency = if far then 0.65 else 0
			dot.Visible = true
		end
	end
	for i = used + 1, self._radarUsed do
		dots[i].Visible = false
	end
	self._radarUsed = used
end

-- Focus card refresh (10 Hz).
function HUDManager._updateCard(self: any, camPos: Vector3)
	local rec = self._focusRec :: Record?
	local card = self._card :: Frame
	if not (Config.ShowFocusCard and rec and rec.Root and rec.Alive) then
		card.Visible = false
		return
	end
	card.Visible = true
	local relation = self:_relation(rec.Player)
	if rec.Player ~= self._cardPlayer then
		self._cardPlayer = rec.Player
		self._cardName.Text = rec.Player.DisplayName
		self._cardKey = ""
	end
	local color = self:_accentFor(rec.Player)
	self._cardRel.Text = if relation == 1 then "ALLY" elseif relation == 2 then "ENEMY" else "NEUTRAL"
	self._cardRel.TextColor3 = color
	self._cardFill.Size = UDim2.fromScale(rec.HealthFrac, 1)
	self._cardFill.BackgroundColor3 = Utils.HealthColor(rec.HealthFrac)
	local root = rec.Root :: BasePart
	local m = math.floor((root.Position - camPos).Magnitude * Config.StudsToMeters)
	local speed = math.floor(root.AssemblyLinearVelocity.Magnitude)
	local hp = math.ceil(rec.Health)
	local key = m * 1e6 + speed * 1e3 + hp -- cheap change detector: avoids string churn
	if key ~= self._cardKey then
		self._cardKey = key
		self._cardInfo.Text = string.format("%dm  |  %d studs/s  |  %d/%d HP", m, speed, hp, math.ceil(rec.MaxHealth))
	end
end

-- Per-frame update ------------------------------------------------------
-- Hot path creates no Instances, tables, closures or Vector2s. Distance and
-- radius tests use squared values to skip sqrt. UDim2/Color3 writes happen
-- only for targets that survive culling.
function HUDManager.Update(self: any, dt: number)
	local camera = Workspace.CurrentCamera
	if camera ~= self._camera then
		self:_setCamera(camera)
	end
	if not camera then
		return
	end

	-- Soft-lock runs FIRST so every projection below uses the camera that is
	-- actually rendered this frame (otherwise boxes would lag the assist).
	self:_applyAssist(camera, dt)

	local camCF = camera.CFrame
	local camPos = camCF.Position
	local cx, cy = self._cx, self._cy
	local maxDist = Config.MaxRenderDistance
	local maxDistSq = maxDist * maxDist
	local radius = Config.ScreenRadius
	local radiusSq = radius * radius
	local useOcclusion = Config.UseOcclusion
	local enabled = Config.Enabled
	local showArrows = Config.ShowArrows
	local arrowR = math.min(cx, cy) * Config.ArrowRadius
	local fadeStep = dt / math.max(Config.FadeTime, 0.001) -- delta-time independent
	local now = os.clock()
	local pool, arrowPool = self._pool, self._arrowPool
	local chamsOn = Config.ShowChams
	local fillMul = 1 - Config.ChamsFillTransparency
	local tracerOpacity = Config.TracerOpacity
	local maxTags = math.min(Config.MaxActiveTags, pool:Capacity())
	local activeCount = pool:Capacity() - pool:FreeCount()

	self._k = self._vh / (2 * math.tan(math.rad(camera.FieldOfView) * 0.5))
	local origin = Config.TracerOrigin
	self._tracerY = if origin == "Bottom" then self._vh elseif origin == "Center" then cy else 0

	self._distTimer += dt
	self._distTick = self._distTimer >= 0.1
	if self._distTick then
		self._distTimer = 0
	end

	local bestSq = Config.FocusRadius * Config.FocusRadius
	local bestRec: Record? = nil

	-- Soft-lock target pick (sticky: the current target keeps priority and a wider
	-- capture radius, so the lock doesn't flicker between two close targets).
	local assistOn = self:_assistWanted()
	local assistFovSq = Config.AssistFov * Config.AssistFov
	local assistKeepSq = assistFovSq * 1.56
	local assistEnemiesOnly = Config.AssistEnemiesOnly
	local assistCur = self._assistRec :: Record?
	local assistScore = math.huge
	local assistBest: Record? = nil
	local nTotal, nMode, nRange, nScreen, nRadius, nVisible, nArrows = 0, 0, 0, 0, 0, 0, 0

	for _, rec in self._records do
		local want, wantArrow = false, false
		local vx, vy, depth, dist = 0, 0, 1, 0
		local root = rec.Root
		local arrowPos = Vector3.zero
		if enabled and root and rec.Alive then
			nTotal += 1
			if self:_passesMode(rec.Player) then
				nMode += 1
				-- root + bounding-box centre offset, so boxes/tracers centre on the whole rig
				local pos = root.Position + Vector3.new(0, rec.CenterY, 0)
				local d = pos - camPos
				local dSq = d:Dot(d)
				if dSq <= maxDistSq then -- distance cull
					nRange += 1
					local vp, onScreen = camera:WorldToViewportPoint(pos)
					if onScreen then -- frustum cull
						nScreen += 1
						local dx, dy = vp.X - cx, vp.Y - cy
						local cdSq = dx * dx + dy * dy
						if cdSq <= radiusSq then -- FOV radius cull
							nRadius += 1
							want = true
							if useOcclusion then
								want = not self:_isOccluded(rec, camPos, pos, now)
							end
							if want then
								nVisible += 1
								vx, vy, depth = vp.X, vp.Y, math.max(vp.Z, 0.1)
								dist = math.sqrt(dSq)
								if cdSq < bestSq then
									bestSq, bestRec = cdSq, rec
								end
								if assistOn then
									local isCur = rec == assistCur
									if cdSq <= (if isCur then assistKeepSq else assistFovSq)
										and (not assistEnemiesOnly or self:_relation(rec.Player) ~= 1) then
										local score = if isCur then cdSq * 0.4 else cdSq
										if score < assistScore then
											assistScore, assistBest = score, rec
										end
									end
								end
							end
						end
					elseif showArrows then
						wantArrow, arrowPos = true, pos
					end
				end
			end
		end

		-- Off-screen arrow (pooled, pinned to a ring around the screen centre)
		if wantArrow then
			local arrow = rec.Arrow
			if not arrow then
				arrow = arrowPool:Acquire()
				rec.Arrow = arrow
				if arrow then
					arrow.Visible = true
				end
			end
			if arrow then
				nArrows += 1
				local rel = camCF:PointToObjectSpace(arrowPos)
				local ax, ay = rel.X, -rel.Y
				local len = math.sqrt(ax * ax + ay * ay)
				if len < 1e-3 then
					ax, ay, len = 0, 1, 1
				end
				local ux, uy = ax / len, ay / len
				arrow.Position = UDim2.fromOffset(cx + ux * arrowR, cy + uy * arrowR)
				arrow.Rotation = math.deg(math.atan2(ux, -uy))
				local accent = self:_accentFor(rec.Player)
				if accent ~= rec.ArrowAccent then
					rec.ArrowAccent = accent
					arrow.TextColor3 = accent
				end
			end
		elseif rec.Arrow then
			self:_releaseArrow(rec)
		end

		-- Tag acquire / fade / release
		if want then
			if not rec.Tag and activeCount < maxTags then
				local acquired = pool:Acquire()
				if acquired then
					self:_bindTag(rec, acquired)
					activeCount += 1
				end
			end
			if rec.Tag and rec.Alpha < 1 then
				rec.Alpha = math.min(1, rec.Alpha + fadeStep)
			end
		elseif rec.Tag then
			rec.Alpha = math.max(0, rec.Alpha - fadeStep)
			if rec.Alpha <= 0 then
				self:_releaseTag(rec)
				activeCount -= 1
			end
		end

		local tag = rec.Tag
		if tag then
			if rec.Alpha ~= rec.AppliedAlpha then
				local a = rec.Alpha
				rec.AppliedAlpha = a
				tag.Group.GroupTransparency = 1 - a
				tag.Box.GroupTransparency = 1 - a
				tag.Tracer.BackgroundTransparency = 1 - a * tracerOpacity
				if chamsOn then
					tag.Chams.FillTransparency = 1 - a * fillMul
					tag.Chams.OutlineTransparency = 1 - a
				end
			end

			-- Damage trail: waits GhostDelay after a hit, then drains.
			if rec.GhostFrac > rec.HealthFrac and now >= rec.GhostHold then
				rec.GhostFrac = math.max(rec.HealthFrac, rec.GhostFrac - dt * Config.GhostDrain)
				tag.Ghost.Size = UDim2.fromScale(rec.GhostFrac, 1)
			end

			if want then
				self:_layout(rec, tag, vx, vy, depth, dist)
			end
		else
			rec.GhostFrac = rec.HealthFrac -- nothing visible to animate
		end
	end

	self._focusRec = bestRec
	self._assistRec = assistBest
	local stats = self._stats
	stats.Total, stats.Mode, stats.Range, stats.Screen = nTotal, nMode, nRange, nScreen
	stats.Radius, stats.Visible, stats.Arrows = nRadius, nVisible, nArrows

	-- Throttled extras ---------------------------------------------------
	self._radarTimer += dt
	if self._radarTimer >= 1 / 30 then
		self._radarTimer = 0
		if Config.ShowRadar then
			self:_updateRadar(camera, camPos)
		end
	end
	if self._distTick then
		self:_updateCard(camPos)
	end

	-- Rig upkeep: one target per frame (character swaps, box size, polled health)
	local list = self._list
	local nList = #list
	if nList > 0 then
		self._cursor = self._cursor % nList + 1
		self:_rescan(list[self._cursor], now)
	end
	-- Keep our own (possibly custom) character out of occlusion rays
	self._localTimer += dt
	if self._localTimer >= 1 then
		self._localTimer = 0
		local lc = self:_resolveCharacter(localPlayer)
		if lc ~= self._lastLocal then
			self._lastLocal = lc
			self._rayParams.FilterDescendantsInstances = if lc then { lc } else {}
		end
	end

	self._fpsFrames += 1
	self._fpsTimer += dt
	if self._fpsTimer >= 0.5 then
		self._fps = self._fpsFrames / self._fpsTimer
		self._fpsFrames, self._fpsTimer = 0, 0
	end

	-- Text readouts at 4 Hz (string formatting allocates)
	self._statsTimer += dt
	if self._statsTimer >= 0.25 then
		self._statsTimer = 0
		if Config.ShowWatermark then
			self._wmLabel.Text = string.format(
				"TACTICAL HUD   %d FPS   %d ms   %d players   %d tags",
				math.floor(self._fps), math.floor(localPlayer:GetNetworkPing() * 1000), self._count + 1, activeCount
			)
		end
		local dbg = self._debugInfo
		if dbg and self._menu.Gui.Enabled then
			local fr = self._focusRec :: Record?
			dbg.Text = string.format(
				"tracked   %d\npass mode %d\nin range  %d\non screen %d\nin radius %d\nvisible   %d\narrows    %d\npool free %d/%d\n\nfocus rig: %s",
				stats.Total, stats.Mode, stats.Range, stats.Screen, stats.Radius, stats.Visible, stats.Arrows,
				pool:FreeCount(), pool:Capacity(), if fr then fr.RigInfo else "(aim near a target)"
			)
		end
	end
end

-- Spectate / freecam ----------------------------------------------------
-- Soft-lock ---------------------------------------------------------------
-- Is the assist currently requested (key held / toggled on / always-on)?
function HUDManager._assistWanted(self: any): boolean
	if not Config.AssistEnabled or self._freecam or self._specPlayer then
		return false
	end
	local m = Config.AssistMode
	if m == "Always" then
		return true
	elseif m == "Toggle" then
		return self._assistToggled
	end
	return self._assistHeld
end

-- Eases the camera toward the chosen target by Strength * weight, where the
-- weight ramps 0 -> 1 on engage and back to 0 on release (Smoothness sets the
-- ramp speed), so the camera never snaps. The camera script re-derives its
-- orientation from player input every frame, so this acts as a bounded pull,
-- not a permanent rewrite of the player's aim.
function HUDManager._applyAssist(self: any, camera: Camera, dt: number)
	local rec = self._assistRec :: Record?
	local engaged = rec ~= nil and self:_assistWanted()
	local part: BasePart? = nil
	if engaged and rec then
		part = if Config.AssistPart == "Head" then rec.Anchor else rec.Root
		engaged = part ~= nil and rec.Alive
	end

	local pos = camera.CFrame.Position
	if engaged and part and rec and Config.AssistRequireLos then
		self._losTimer += dt
		if self._losTimer >= 0.05 then -- 20 Hz line-of-sight check
			self._losTimer = 0
			local hit = Workspace:Raycast(pos, part.Position - pos, self._rayParams)
			local character = rec.Character
			self._los = hit == nil or (character ~= nil and hit.Instance:IsDescendantOf(character))
		end
		engaged = self._los
	end

	if engaged and part then
		self._assistPart = part -- remembered so the release ramp can finish smoothly
	end
	local speed = 3 + (1 - Config.AssistSmoothness) * 27
	self._assistW += ((if engaged then 1 else 0) - self._assistW) * (1 - math.exp(-speed * dt))

	local aimPart = self._assistPart :: BasePart?
	if self._assistW < 0.002 or not aimPart or not aimPart:IsDescendantOf(Workspace) then
		self._assistW = 0
		self._assistPart = nil
	else
		local cf = camera.CFrame
		if (aimPart.Position - pos).Magnitude > 1e-3 then
			-- lookAt keeps the world-up axis, so the pull never introduces camera roll
			camera.CFrame = cf:Lerp(CFrame.lookAt(pos, aimPart.Position), math.clamp(Config.AssistStrength, 0, 1) * self._assistW)
		end
	end

	-- Indicator label (written only on state change)
	local showLabel = engaged and self._assistW > 0.3
	local target = if showLabel and rec then rec.Player else nil
	if showLabel ~= self._assistLabelOn or target ~= self._assistLabelPlayer then
		self._assistLabelOn, self._assistLabelPlayer = showLabel, target
		self._assistLabel.Visible = showLabel
		if target then
			self._assistLabel.Text = "ASSIST  " .. target.DisplayName
			self._assistLabel.TextColor3 = Theme.Accent
		end
	end
end

function HUDManager.Spectate(self: any, player: Player?)
	self._specJanitor:Clean()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if self._freecam then
		self:SetFreecam(false)
	end
	-- CameraSubject accepts a Humanoid or a BasePart, so rigs without a
	-- Humanoid are followed by their root part instead.
	local function follow(char: Model?)
		if not char then
			return
		end
		local hum = char:FindFirstChildWhichIsA("Humanoid", true)
		if hum then
			camera.CameraSubject = hum
			return
		end
		local part = Utils.ResolveRoot(char)
		if part then
			camera.CameraSubject = part
		end
	end
	if not player then
		self._specPlayer = nil
		follow(self:_resolveCharacter(localPlayer))
	else
		self._specPlayer = player
		follow(self:_resolveCharacter(player))
		self._specJanitor:Add(player.CharacterAdded:Connect(function(char)
			task.wait(0.3) -- let the rig's parts replicate
			if self._specPlayer == player and not self._destroyed then
				follow(char)
			end
		end))
	end
	self:_playersChanged()
	if self._menu then
		self._menu.Refresh()
	end
end

function HUDManager._specCycle(self: any, dir: number)
	local list = {} :: { Player }
	for _, p in Players:GetPlayers() do
		if p ~= localPlayer then
			table.insert(list, p)
		end
	end
	if #list == 0 then
		return
	end
	local idx = table.find(list, self._specPlayer :: any) or 0
	if idx == 0 and dir < 0 then
		idx = 1
	end
	self:Spectate(list[(idx - 1 + dir) % #list + 1])
end

function HUDManager._freecamStep(self: any, dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local rot = CFrame.fromOrientation(self._fcPitch, self._fcYaw, 0)
	local move = Vector3.zero
	local key = UserInputService.IsKeyDown
	if key(UserInputService, Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
	if key(UserInputService, Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
	if key(UserInputService, Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
	if key(UserInputService, Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
	local up = 0
	if key(UserInputService, Enum.KeyCode.E) or key(UserInputService, Enum.KeyCode.Space) then up += 1 end
	if key(UserInputService, Enum.KeyCode.Q) then up -= 1 end
	local speed = Config.FreecamSpeed
	if key(UserInputService, Enum.KeyCode.LeftShift) then speed *= 3 end
	if key(UserInputService, Enum.KeyCode.LeftControl) then speed *= 0.25 end
	self._fcPos += (rot:VectorToWorldSpace(move) + Vector3.new(0, up, 0)) * speed * dt
	camera.CFrame = CFrame.new(self._fcPos) * rot
end

function HUDManager.SetFreecam(self: any, on: boolean)
	if on == self._freecam then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if on then
		if self._specPlayer then
			self:Spectate(nil)
		end
		local cf = camera.CFrame
		self._fcPitch, self._fcYaw = cf:ToOrientation()
		self._fcPos = cf.Position
		self._fcSavedType = camera.CameraType
		camera.CameraType = Enum.CameraType.Scriptable
		-- Sink movement keys so the character doesn't walk while flying the camera.
		ContextActionService:BindActionAtPriority("TacticalHUD_FreecamSink", function()
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value,
			Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Q, Enum.KeyCode.E,
			Enum.KeyCode.Space, Enum.KeyCode.LeftShift)
		RunService:BindToRenderStep("TacticalHUD_Freecam", Enum.RenderPriority.Camera.Value, function(dt)
			self:_freecamStep(dt)
		end)
		self._freecam = true
	else
		self._freecam = false
		RunService:UnbindFromRenderStep("TacticalHUD_Freecam")
		ContextActionService:UnbindAction("TacticalHUD_FreecamSink")
		camera.CameraType = self._fcSavedType
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	if self._menu then
		self._menu.Refresh()
	end
end

