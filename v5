-- UTILS
----------------------------------------------------------------------
local function New(className, props, parent)
	local inst = Instance.new(className)
	for k, v in props do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function Janitor()
	local conns = {}
	local j = {}
	function j.Add(_, c)
		conns[#conns + 1] = c
		return c
	end
	function j.Clean(_)
		for i = #conns, 1, -1 do
			conns[i]:Disconnect()
		end
		table.clear(conns)
	end
	return j
end

-- Fixed-size object pool: everything is built once; the render loop only recycles.
local Pool = {}
Pool.__index = Pool

function Pool.new(size, factory, reset, destroy)
	local self = setmetatable({
		all = {}, free = {}, freeCount = 0, inPool = {}, reset = reset, destroy = destroy,
	}, Pool)
	for i = 1, size do
		local item = factory()
		reset(item)
		self.all[i], self.free[i], self.inPool[item] = item, item, true
	end
	self.freeCount = size
	return self
end

function Pool:Acquire()
	local n = self.freeCount
	if n == 0 then
		return nil
	end
	local item = self.free[n]
	self.free[n] = nil
	self.freeCount = n - 1
	self.inPool[item] = false
	return item
end

function Pool:Release(item)
	if self.inPool[item] ~= false then
		return
	end
	local ok, err = pcall(self.reset, item) -- a failing reset must never strand the item
	if not ok and not self.warned then
		self.warned = true
		warn("[TacticalHUD] pool reset error: " .. tostring(err))
	end
	self.inPool[item] = true
	self.freeCount += 1
	self.free[self.freeCount] = item
end

-- Items marked in-use that nothing holds (leaks) go back to the pool.
function Pool:Reclaim(held)
	local n = 0
	for _, item in self.all do
		if self.inPool[item] == false and not held[item] then
			self:Release(item)
			n += 1
		end
	end
	return n
end

function Pool:Destroy()
	for _, item in self.all do
		pcall(self.destroy, item)
	end
	table.clear(self.all)
	table.clear(self.free)
	table.clear(self.inPool)
	self.freeCount = 0
end

-- Binds are an Enum.KeyCode or a mouse button (Enum.UserInputType).
local function bindMatches(input, bind)
	if bind.EnumType == Enum.KeyCode then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == bind
	end
	return input.UserInputType == bind
end
local MouseNames = { MouseButton1 = "Mouse 1", MouseButton2 = "Mouse 2", MouseButton3 = "Mouse 3" }
local function bindName(bind)
	return MouseNames[bind.Name] or bind.Name
end

-- Rig helpers -------------------------------------------------------------
-- Direct children win over deeper matches, so an accessory part named "Head" is never picked.
local function findPart(model, names)
	for _, n in names do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	for _, n in names do
		local p = model:FindFirstChild(n, true)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return nil
end

-- Root = Humanoid.RootPart, else a named root, else PrimaryPart, else (only if allowed) the
-- biggest part. The biggest-part fallback is delayed so a half-replicated rig can't pick a limb.
local function resolveRoot(model, allowLargest)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.RootPart and hum.RootPart:IsDescendantOf(model) then
		return hum.RootPart
	end
	local named = findPart(model, RigConfig.RootPartNames)
	if named then
		return named
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	if allowLargest == false then
		return nil
	end
	local best, bestVol = nil, 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local s = d.Size
			local v = s.X * s.Y * s.Z
			if v > bestVol then
				best, bestVol = d, v
			end
		end
	end
	return best
end

-- Rejects map props that merely share a name with a player.
local function plausible(model)
	if model:FindFirstChildOfClass("Humanoid") or model.PrimaryPart then
		return true
	end
	for _, n in RigConfig.RootPartNames do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return true
		end
	end
	return false
end

local function isBodyPart(p)
	return p.Name ~= "Handle" and p:FindFirstAncestorWhichIsA("Accessory") == nil and p:FindFirstAncestorWhichIsA("Tool") == nil
end

local function healthColor(f)
	f = math.clamp(f, 0, 1)
	local g, y, r = Color3.fromRGB(96, 200, 120), Color3.fromRGB(235, 200, 80), Color3.fromRGB(226, 80, 80)
	if f >= 0.5 then
		return y:Lerp(g, (f - 0.5) * 2)
	end
	return r:Lerp(y, f * 2)
end

-- Team ids are normalised to lowercase strings so different sources compare equal.
local function normTeam(v)
	local t = typeof(v)
	if t == "Instance" then
		if v:IsA("ValueBase") then
			return normTeam(v.Value)
		end
		return v.Name:lower()
	elseif t == "string" then
		return if v == "" then nil else v:lower()
	elseif t == "number" then
		return tostring(v)
	elseif t == "BrickColor" then
		return "color:" .. v.Name
	elseif t == "Color3" then
		return "color:" .. v:ToHex()
	end
	return nil
end

