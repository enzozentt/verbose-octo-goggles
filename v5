	local pvLastHp = -1
	local function updatePreview()
		local color = if pvAlly then Config.AllyColor else Config.EnemyColor
		pvChip.Text = if pvAlly then "ALLY" else "ENEMY"
		pvChip.TextColor3 = color

		pvBox.Visible = Config.ShowBoxes
		local full = Config.BoxStyle == "Full"
		for i, b in pvBrackets do
			b.BackgroundColor3 = color
			if pvBracketH[i] then
				b.Size = UDim2.new(if full then 1 else Config.BracketLenX, 0, 0, Config.BracketThickness)
			else
				b.Size = UDim2.new(0, Config.BracketThickness, if full then 1 else Config.BracketLenY, 0)
			end
		end
		pvFill.BackgroundColor3, pvFill.BackgroundTransparency = color, Config.BoxFillTransparency

		pvName.Visible, pvName.TextColor3 = Config.ShowNames, color
		pvBar.Visible = Config.ShowHealth
		pvInfo.Visible = Config.ShowDistance

		pvTracer.Visible = Config.ShowTracers
		if Config.ShowTracers then
			local ox = SW / 2
			local oy = if Config.TracerOrigin == "Bottom" then SH elseif Config.TracerOrigin == "Center" then SH / 2 else 0
			local ty = if oy >= SH / 2 then BCY + BH / 2 else BCY - BH / 2
			local dx, dy = BCX - ox, ty - oy
			pvTracer.BackgroundColor3 = color
			pvTracer.Position = UDim2.fromOffset((BCX + ox) / 2, (ty + oy) / 2)
			pvTracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), Config.TracerThickness)
			pvTracer.Rotation = math.deg(math.atan2(dy, dx))
		end

		for _, f in figure do
			f.BackgroundColor3 = if Config.ShowChams then color else Color3.fromRGB(70, 80, 100)
			f.BackgroundTransparency = if Config.ShowChams then Config.ChamsFillTransparency else 0
		end
