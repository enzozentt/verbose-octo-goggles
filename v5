	New("UICorner", { CornerRadius = UDim.new(0, 7) }, win)

	local baseScale = 1
	local function fit()
		local a = gui.AbsoluteSize
		if a.X < 100 or a.Y < 100 then -- not laid out yet: fall back to the camera's viewport
			local cam = Workspace.CurrentCamera
			a = cam and cam.ViewportSize or Vector2.new(1280, 720)
		end
		baseScale = Config.MenuScale * math.min(1, math.max((a.X - 24) / W, 0.4), math.max((a.Y - 24) / H, 0.4))
