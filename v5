				jan:Add(b.MouseEnter:Connect(function()
					if get() ~= opt then
						tween(b, fast, { TextColor3 = Theme.Text })
					end
				end))
				jan:Add(b.MouseLeave:Connect(function()
					if get() ~= opt then
						tween(b, fast, { TextColor3 = Theme.Muted })
					end
				end))
				jan:Add(b.Activated:Connect(function()
					set(opt)
					onChange()
					refreshAll()
				end))
			end
			local lastSel
			register(function()
				local cur = get()
				if cur == lastSel then
					return -- unchanged: don't re-tween on every slider tick elsewhere
				end
				for i, b in buttons do
					local on = options[i] == cur
					if lastSel == nil then
						b.BackgroundTransparency = on and 0 or 1
						b.TextColor3 = on and Theme.Text or Theme.Muted
					else
						tween(b, fast, { BackgroundTransparency = on and 0 or 1, TextColor3 = on and Theme.Text or Theme.Muted })
