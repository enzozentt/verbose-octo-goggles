	self._chamList = {} :: { Record }
	self._chamTimer, self._chamsDirty = 0, true
	self._projX, self._projY, self._projOk = table.create(40, 0), table.create(40, 0), table.create(40, false)
	self._pRight, self._pUp, self._pLook, self._pPos = Vector3.xAxis, Vector3.yAxis, -Vector3.zAxis, Vector3.zero
	self:_createVisuals()

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
