function HUD:_addPlayer(p)
	if p == localPlayer or self.recs[p] then
		return
	end
	local rec = {
		Player = p, Char = nil, Root = nil, Head = nil, Torso = nil, Pending = nil, Token = 0,
		InWorld = false, Missing = nil, NextScan = 0, Alive = false, DeadSince = nil,
		Health = 100, MaxHealth = 100, HealthFrac = 1, Ghost = 1, GhostHold = 0, HasHealth = false, HealthSource = "none yet",
		Refresh = nil, Verify = nil, BadReads = 0, ObservedMax = 0,
		BoxW = 3.6, BoxH = 6.2, CenterY = 0, HeadOffset = 2.4, HeadRadius = 0.7,
		Body = {}, BodyVol = {}, Bones = {},
		Tag = nil, Arrow = nil, Skel = nil, Applied = nil, ArrowColor = nil,
		Visible = true, Dist = 0, LastDistM = -1, Detail = false, ChamWant = false,
		Jan = Janitor(), PJan = Janitor(), Info = "not bound yet",
	}
	self.recs[p] = rec
	self.list[#self.list + 1] = rec
	self.teamIds[p] = self:_computeTeam(p, nil)
	for _, prop in { "Team", "TeamColor", "Neutral" } do
		rec.PJan:Add(p:GetPropertyChangedSignal(prop):Connect(function()
			self.teamIds[p] = self:_computeTeam(p, rec.Char)
		end))
	end
	rec.PJan:Add(p.CharacterAdded:Connect(function(c)
		self:_bind(rec, c)
	end))
	rec.PJan:Add(p.CharacterRemoving:Connect(function()
		self:_unbind(rec)
	end))
	local c = self:_resolveCharacter(p)
	if c then
		self:_bind(rec, c)
	end
	if self.refreshSpectateList then
		self.refreshSpectateList()
	end
end

function HUD:_removePlayer(p)
	local rec = self.recs[p]
	if not rec then
		return
	end
	self.recs[p] = nil
	local i = table.find(self.list, rec)
	if i then
		table.remove(self.list, i)
	end
	if self.lockRec == rec then
		self.lockRec = nil
	end
	if self.specPlayer == p then
		self:Spectate(nil)
	end
	self:_unbind(rec)
	rec.PJan:Clean()
	if self.refreshSpectateList then
		self.refreshSpectateList()
	end
end

function HUD:_unbind(rec)
	rec.Token += 1
	rec.Jan:Clean()
	rec.Char, rec.Root, rec.Head, rec.Torso, rec.Pending = nil, nil, nil, nil, nil
	rec.Refresh, rec.Verify, rec.HasHealth, rec.InWorld, rec.Missing, rec.DeadSince = nil, nil, false, false, nil, nil
	rec.Alive = false
	table.clear(rec.Body)
	table.clear(rec.BodyVol)
	table.clear(rec.Bones)
	self:_hide(rec)
end

-- Finds a player's rig: your hook, Player.Character, then a model named after them.
function HUD:_resolveCharacter(p)
	local hook = Hooks.GetCharacter
	if hook then
		local ok, r = pcall(hook, p)
		return if ok and typeof(r) == "Instance" and r:IsA("Model") then r else nil
	end
	local c = p.Character
	if c and c:IsDescendantOf(Workspace) then
		return c
	end
	local folder = Hooks.CharacterFolder or Workspace
	local f = folder:FindFirstChild(p.Name) or folder:FindFirstChild(p.DisplayName)
	if f and f:IsA("Model") and plausible(f) then
		return f
	end
	for _, child in folder:GetChildren() do
		if child:IsA("Folder") or child:IsA("Model") then
			local g = child:FindFirstChild(p.Name) or child:FindFirstChild(p.DisplayName)
			if g and g:IsA("Model") and plausible(g) then
				return g
			end
		end
	end
	return nil
end

-- `force` re-binds a character that is already bound (re-detect health/bones) while keeping
-- its tag on screen; without it, duplicate calls for a character already bound/pending are ignored.
function HUD:_bind(rec, character, force)
	if not force and (rec.Pending == character or (rec.Char == character and rec.Root)) then
		return
	end
	if force and rec.Char == character then
		rec.Token += 1
		rec.Jan:Clean()
	else
		self:_unbind(rec)
	end
	local token = rec.Token
	rec.Pending = character
	task.spawn(function()
		local root
		for i = 1, 30 do -- rigs can stream in late; largest-part fallback only after 1.5 s
			root = resolveRoot(character, i > 15)
			if root or self.destroyed or rec.Token ~= token then
				break
			end
			task.wait(0.1)
		end
		if self.destroyed or rec.Token ~= token then
			return
		end
		if not root then
			rec.Pending = nil -- the rescan retries
			return
		end
		local hum = character:FindFirstChildWhichIsA("Humanoid", true)
		if not hum then
			for _ = 1, 3 do
				task.wait(0.1)
				hum = character:FindFirstChildWhichIsA("Humanoid", true)
				if hum or self.destroyed or rec.Token ~= token then
					break
				end
			end
			if self.destroyed or rec.Token ~= token then
				return
			end
		end
		local hrp = hum and hum.RootPart
		if hrp and hrp:IsDescendantOf(character) then
			root = hrp
		end
		local head = findPart(character, RigConfig.HeadPartNames)
		if head and (head.Position - root.Position).Magnitude > 10 then
			head = nil -- a same-named part somewhere else
		end
		rec.Char, rec.Root, rec.Head, rec.Pending = character, root, head, nil
		rec.Torso = findPart(character, RigConfig.TorsoPartNames) or root
		rec.InWorld = character:IsDescendantOf(Workspace)
		rec.Missing = nil
		rec.Jan:Add(character.AncestryChanged:Connect(function()
			rec.InWorld = character:IsDescendantOf(Workspace)
			if not rec.InWorld then
				rec.NextScan = 0
			end
		end))
		self.teamIds[rec.Player] = self:_computeTeam(rec.Player, character) -- before anything can draw
		self:_setupHealth(rec, character, hum)
		self:_scan(rec)
		rec.Info = ("root=%s head=%s health=%s"):format(root.Name, head and head.Name or "estimated", rec.HealthSource)
	end)
end

----------------------------------------------------------------------
-- Health: finds every source the rig exposes, picks one that returns numbers, and keeps
-- verifying it. Event-driven where possible, plus a 1 s safety re-read.
----------------------------------------------------------------------
function HUD:_healthCandidates(p, ch, hum)
	local list = {}
	local hook = Hooks.GetHealth
	if hook then
		list[#list + 1] = {
			Group = "Hook", Name = "Hooks.GetHealth",
			Get = function()
				local ok, h, m = pcall(hook, p, ch)
				if ok then
					return h, m
				end
			end,
		}
	end
	if hum then
		list[#list + 1] = {
			Group = "Humanoid", Name = "Humanoid",
			Get = function()
				return hum.Health, hum.MaxHealth
			end,
			Connect = function(j, f)
				j:Add(hum.HealthChanged:Connect(f))
				j:Add(hum:GetPropertyChangedSignal("MaxHealth"):Connect(f))
			end,
		}
	end
	for _, holder in { { ch, "character" }, { p, "player" } } do
		local obj = holder[1]
		for _, hn in RigConfig.HealthAttributes do
			if type(obj:GetAttribute(hn)) == "number" then
				local mn
				for _, cand in RigConfig.MaxHealthAttributes do
					if type(obj:GetAttribute(cand)) == "number" then
						mn = cand
						break
					end
				end
				list[#list + 1] = {
					Group = "Attr", Name = holder[2] .. " attribute '" .. hn .. "'",
					Get = function()
						return obj:GetAttribute(hn), mn and obj:GetAttribute(mn) or nil
					end,
					Connect = function(j, f)
						j:Add(obj:GetAttributeChangedSignal(hn):Connect(f))
						if mn then
							j:Add(obj:GetAttributeChangedSignal(mn):Connect(f))
						end
					end,
				}
				break
			end
		end
	end
	for _, hn in RigConfig.HealthValueNames do
		local hv = ch:FindFirstChild(hn, true) or p:FindFirstChild(hn, true)
		if hv and hv:IsA("ValueBase") and type(hv.Value) == "number" then
			local mv
			for _, mn in RigConfig.MaxHealthValueNames do
				local c = hv.Parent and hv.Parent:FindFirstChild(mn)
				if c and c:IsA("ValueBase") then
					mv = c
					break
				end
			end
			list[#list + 1] = {
				Group = "Value", Name = "Value '" .. hv.Name .. "'",
				Get = function()
					return hv.Value, mv and mv.Value or nil
				end,
				Connect = function(j, f)
					j:Add(hv.Changed:Connect(f))
					if mv then
						j:Add(mv.Changed:Connect(f))
					end
				end,
			}
			break
		end
	end
	return list
end

function HUD:_setupHealth(rec, ch, hum)
	local cands = {}
	for _, c in self:_healthCandidates(rec.Player, ch, hum) do
		local h = c.Get()
		if type(h) == "number" and h == h then
			cands[#cands + 1] = c
		end
	end
	local chosen = cands[1]
	-- A Humanoid parked at 100/100 (or 0) while the game keeps real health elsewhere is the
	-- classic custom-health setup: prefer the next source that returns a number.
	local function humanoidIsDecoy()
		return hum and chosen and chosen.Group == "Humanoid" and ((hum.Health == 100 and hum.MaxHealth == 100) or hum.Health <= 0)
	end
	if humanoidIsDecoy() and cands[2] then
		chosen = cands[2]
	end

	rec.HealthSource = chosen and chosen.Name or "none found"
	rec.HasHealth = chosen ~= nil
	rec.ObservedMax, rec.BadReads = 0, 0
	local first = true
	local function refresh()
		local h, m = rec.Health, rec.MaxHealth
		if chosen then
			local rh, rm = chosen.Get()
			if type(rh) == "number" then
				h = rh
				rec.ObservedMax = math.max(rec.ObservedMax, h)
				m = (type(rm) == "number" and rm > 0) and rm or math.max(rec.ObservedMax, 1)
				rec.BadReads = 0
			else
				rec.BadReads += 1
			end
		else
			h, m = 100, 100
		end
		local frac = math.clamp(h / m, 0, 1)
		if frac > rec.Ghost or first then
			rec.Ghost = frac
		elseif frac < rec.HealthFrac then
			rec.GhostHold = os.clock() + 0.35
		end
		first = false
		rec.Health, rec.MaxHealth, rec.HealthFrac = h, m, frac
		if h > 0 or not chosen then
			rec.DeadSince, rec.Alive = nil, true
		else -- 0.25 s grace so one bad read can't blink the ESP
			rec.DeadSince = rec.DeadSince or os.clock()
			rec.Alive = os.clock() - rec.DeadSince < 0.25
		end
		rec.LastDistM = -1
		if rec.Tag then
			rec.Tag.Hp.Size = UDim2.fromScale(frac, 1)
			rec.Tag.Hp.BackgroundColor3 = healthColor(frac)
		end
	end
	rec.Refresh = refresh
	refresh()
	if chosen and chosen.Connect then
		chosen.Connect(rec.Jan, refresh)
	end
	rec.Verify = function()
		if rec.BadReads >= 3 then
			return true
		end
		return chosen ~= nil and chosen.Group == "Humanoid" and humanoidIsDecoy() and cands[2] ~= nil
	end
end

----------------------------------------------------------------------
-- Teams: every source that can name a team, normalised and compared by id.
----------------------------------------------------------------------
function HUD:_computeTeam(p, ch)
	local hook = Hooks.GetTeam
	if hook then
		local ok, r = pcall(hook, p, ch)
		if ok then
			local id = normTeam(r)
			if id then
				return id
			end
		end
	end
	local id = normTeam(p.Team)
	if id then
		return id
	end
	for _, key in RigConfig.TeamKeys do
		id = normTeam(p:GetAttribute(key))
		if id then
			return id
		end
		if ch then
			id = normTeam(ch:GetAttribute(key))
			if id then
				return id
			end
		end
	end
	if ch then
		for _, key in RigConfig.TeamKeys do
			local o = ch:FindFirstChild(key)
			if o and o:IsA("ValueBase") then
				id = normTeam(o)
				if id then
					return id
				end
			end
		end
	end
	if not p.Neutral then
		return normTeam(p.TeamColor)
	end
	return nil
end

-- 0 no teams known, 1 teammate, 2 enemy
function HUD:_relation(p)
	local theirs, mine = self.teamIds[p], self.localTeam
	if theirs == nil and mine == nil then
		return 0
	end
	return (theirs ~= nil and theirs == mine) and 1 or 2
end

function HUD:_isAlly(p)
	return self:_relation(p) == 1
end

-- Show = "Enemies": teammates are never drawn. "Team": only teammates. "Everyone": all.
function HUD:_blocked(p)
	local s = Config.Show
	if s == "Everyone" then
		return false
	end
	local r = self:_relation(p)
	if s == "Team" then
		return r ~= 1
	end
	return r == 1
end

function HUD:_refreshTeams()
	self.localTeam = self:_computeTeam(localPlayer, self:_resolveCharacter(localPlayer))
end

----------------------------------------------------------------------
-- Scan (about once a second per target): size, body parts, skeleton bones.
-- One pass over the rig's descendants feeds the box, the lock aim points and the skeleton.
----------------------------------------------------------------------
function HUD:_scan(rec)
	local ch, root = rec.Char, rec.Root
	if not (ch and root) then
		return
	end
	local rp = root.Position
	local parts = {}
	local minX, maxX, minY, maxY, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge, math.huge, -math.huge
	local joints = {}
	local wantBones = Config.Skeleton
	for _, d in ch:GetDescendants() do
		if d:IsA("BasePart") then
			local cf = d.CFrame
			local p = cf.Position
			if (p - rp).Magnitude <= 14 and isBodyPart(d) then
				local s = d.Size * 0.5
				local rx, ry, rz = cf.RightVector, cf.UpVector, cf.LookVector
				local ex = math.abs(rx.X) * s.X + math.abs(ry.X) * s.Y + math.abs(rz.X) * s.Z
				local ey = math.abs(rx.Y) * s.X + math.abs(ry.Y) * s.Y + math.abs(rz.Y) * s.Z
				local ez = math.abs(rx.Z) * s.X + math.abs(ry.Z) * s.Y + math.abs(rz.Z) * s.Z
				minX, maxX = math.min(minX, p.X - ex), math.max(maxX, p.X + ex)
				minY, maxY = math.min(minY, p.Y - ey), math.max(maxY, p.Y + ey)
				minZ, maxZ = math.min(minZ, p.Z - ez), math.max(maxZ, p.Z + ez)
				local sz = d.Size
				parts[#parts + 1] = { d, sz.X * sz.Y * sz.Z }
			end
		elseif wantBones then
			-- each joint: parent part, child part, joint position in the parent's space, in the child's space
			if d:IsA("Motor6D") then
				joints[#joints + 1] = { d.Part0, d.Part1, d.C0.Position, d.C1.Position }
			elseif JointConstraints[d.ClassName] then
				local a0, a1 = d.Attachment0, d.Attachment1
				if a0 and a1 and a0.Parent and a1.Parent then
					joints[#joints + 1] = { a0.Parent, a1.Parent, a0.Position, a1.Position }
				end
			end
		end
	end

	local h = maxY - minY
	if #parts == 0 or h < 1 or h > 30 then
		rec.BoxW, rec.BoxH, rec.CenterY = 3.6, 6.2, 0 -- nothing sensible to measure
		rec.HeadOffset, rec.HeadRadius = 2.4, 0.7
	else
		h *= 1.04
		rec.BoxH = h
		rec.BoxW = math.clamp(math.max(maxX - minX, maxZ - minZ) * 0.8, h * 0.3, h * 0.7)
		rec.CenterY = math.clamp((minY + maxY) * 0.5 - rp.Y, -h, h)
		rec.HeadRadius = math.min(0.7, h * 0.12)
		rec.HeadOffset = math.max(maxY - rec.HeadRadius - rp.Y, 0.5)
	end

	-- largest body parts (aim fallback + skeleton fallback)
	table.sort(parts, function(a, b)
		return a[2] > b[2]
	end)
	table.clear(rec.Body)
	table.clear(rec.BodyVol)
	for i = 1, math.min(#parts, 14) do
		rec.Body[i], rec.BodyVol[i] = parts[i][1], parts[i][2]
	end

	if wantBones then
		self:_buildBones(rec, joints)
	end
end

-- Builds the skeleton as bones between JOINT PIVOTS, not part centres, so it reads like a
-- real skeleton. Every bone is stored as {partA, localOffsetA, partB, localOffsetB}, so it
-- follows the animation each frame with no extra work.
--   * a part with joints below it  -> a bone from its own joint to each child joint
--     (a torso gets spine -> neck and neck -> shoulders, plus hips; arms and legs chain)
--   * a part with no children      -> a bone from its joint to the far end of the part
--   * rigs with no usable joints   -> a spanning tree over the largest parts
function HUD:_buildBones(rec, joints)
	local ch, root = rec.Char, rec.Root
	local bones = rec.Bones
	table.clear(bones)
	local function ok(p)
		return p ~= nil and p:IsA("BasePart") and p:IsDescendantOf(ch) and isBodyPart(p)
	end
	local function add(pa, oa, pb, ob)
		if #bones >= BONES then
			return
		end
		if pa == pb and (oa - ob).Magnitude < 0.05 then
			return -- zero-length bone
		end
		bones[#bones + 1] = { pa, oa, pb, ob }
	end

	local byChild, byParent = {}, {}
	for _, j in joints do
		local p0, p1 = j[1], j[2]
		if p0 ~= p1 and ok(p0) and ok(p1) and not byChild[p1] then
			local jj = { p0 = p0, p1 = p1, o0 = j[3], o1 = j[4] }
			byChild[p1] = jj
			byParent[p0] = byParent[p0] or {}
			table.insert(byParent[p0], jj)
		end
	end

	for p1, j in byChild do
		local kids = byParent[p1]
		local s = j.o1 -- this part's own joint, in this part's space
		if not kids then
			add(p1, s, p1, -s) -- leaf: the joint to the opposite end of the part
		else
			local upper, lower = {}, {}
			for _, k in kids do
				if k.o0.Y > s.Y + 0.15 then
					upper[#upper + 1] = k
				else
					lower[#lower + 1] = k
				end
			end
			table.sort(upper, function(a, b)
				return a.o0.Y > b.o0.Y
			end)
			local main = upper[1]
			if main then
				add(p1, s, p1, main.o0) -- spine
				for i = 2, #upper do
					add(p1, main.o0, p1, upper[i].o0) -- neck -> shoulders
				end
			end
			for _, k in lower do
				add(p1, s, p1, k.o0) -- hips / lower attachments
			end
		end
	end

	if #bones < 5 then
		-- Universal fallback for ANY rig: spanning tree over the largest body parts, from the root.
		table.clear(bones)
		local nodes = { root }
		for _, p in rec.Body do
			if p ~= root and #nodes < 14 then
				nodes[#nodes + 1] = p
			end
		end
		local inTree = { [1] = true }
		for _ = 2, #nodes do
			local bi, bj, bd = 0, 0, math.huge
			for i = 1, #nodes do
				if inTree[i] then
					for j = 1, #nodes do
						if not inTree[j] then
							local dd = (nodes[i].Position - nodes[j].Position).Magnitude
							if dd < bd then
								bi, bj, bd = i, j, dd
							end
						end
					end
				end
			end
			if bj == 0 then
				break
			end
			inTree[bj] = true
			if #bones < BONES then
				bones[#bones + 1] = { nodes[bi], Vector3.zero, nodes[bj], Vector3.zero }
			end
		end
	end
end

-- World position the lock aims at. Follows the rig live, so crouching or leaning is tracked.
function HUD:_aimPoint(rec, which)
	local root = rec.Root
	if not root or not root.Parent then
		return nil
	end
	if which == "Head" then
		local h = rec.Head
		if h and h.Parent then
			return h.Position
		end
		-- no head part: the highest sizeable body part near the root, minus a head radius
		local topPart, topY = nil, -math.huge
		local rpos = root.Position
		local minVol = (rec.BodyVol[1] or 0) * 0.25
		for i, p in rec.Body do
			if p.Parent and rec.BodyVol[i] >= minVol then
				local cf, s = p.CFrame, p.Size * 0.5
				local pos = cf.Position
				local rx, ry, rz = cf.RightVector, cf.UpVector, cf.LookVector
				local top = pos.Y + math.abs(rx.Y) * s.X + math.abs(ry.Y) * s.Y + math.abs(rz.Y) * s.Z
				local dx, dz = pos.X - rpos.X, pos.Z - rpos.Z
				if dx * dx + dz * dz <= 12 and top > topY then
					topPart, topY = p, top
				end
			end
		end
		if topPart then
			local p = topPart.Position
			return Vector3.new(p.X, topY - rec.HeadRadius, p.Z)
		end
		return rpos + Vector3.new(0, rec.HeadOffset, 0)
	end
	local t = rec.Torso
	if t and t.Parent then
		return t.Position
	end
	return root.Position + Vector3.new(0, rec.CenterY, 0)
end

----------------------------------------------------------------------
-- Per-frame update
----------------------------------------------------------------------
function HUD:_hide(rec)
	local t = rec.Tag
	if t then
		rec.Tag = nil
		self.tagPool:Release(t)
	end
	self:_releaseSkel(rec)
	self:_releaseArrow(rec)
	rec.Applied = nil
end

function HUD:_releaseArrow(rec)
	local a = rec.Arrow
	if a then
		rec.Arrow, rec.ArrowColor, rec.ArrowClose = nil, nil, nil
		self.arrowPool:Release(a)
	end
end

function HUD:_releaseSkel(rec)
	local s = rec.Skel
	if s then
		rec.Skel = nil
		self.skelPool:Release(s)
	end
end

function HUD:_releaseTagOnly(rec)
	local t = rec.Tag
	if t then
		rec.Tag, rec.Applied = nil, nil
		self.tagPool:Release(t)
	end
	self:_releaseSkel(rec)
end

-- The pool is full: a nearer target takes the tag of the farthest one shown.
function HUD:_stealFarthest(dist)
	local worst, worstD = nil, dist * 1.15 + 5
	for _, r in self.list do
		if r.Tag and r.Dist > worstD then
			worst, worstD = r, r.Dist
		end
	end
	if worst then
		self:_releaseTagOnly(worst)
		return self.tagPool:Acquire()
	end
	return nil
end

function HUD:_colorFor(rec)
	if rec == self.lockRec and self.lockW > 0.05 then
		return Color3.new(1, 1, 1)
	end
	local r = self:_relation(rec.Player)
	local col = r == 1 and Config.AllyColor or (r == 2 and Config.EnemyColor or Config.NeutralColor)
	if Config.VisTint and not rec.Visible then
		col = col:Lerp(Color3.fromRGB(110, 112, 118), 0.55)
	end
	return col
end

function HUD:_updateRec(rec, c)
	local root = rec.Root
	if not (c.show and root and rec.Alive and rec.InWorld) or self:_blocked(rec.Player) then
		return self:_hide(rec)
	end
	if not root.Parent then
		rec.NextScan = 0 -- parts were swapped (round reset): re-check this target next
		return self:_hide(rec)
	end

	local pos = root.Position + Vector3.new(0, rec.CenterY, 0)
	local d = pos - c.camPos
	local dSq = d:Dot(d)
	local shown = rec.Tag ~= nil
	local maxR = Config.MaxRange * (shown and 1.05 or 1) -- hysteresis: no flicker at the limit
	if dSq > maxR * maxR then
		return self:_hide(rec)
	end
	local dist = math.sqrt(dSq)
	c.count += 1 -- feeds the threat readout
	if dist < c.nearest then
		c.nearest = dist
	end

	-- manual perspective projection (independent of Camera.ViewportSize, which can be stale)
	local z = d:Dot(c.look)
	local px, py, onScreen = 0, 0, false
	if z > 0.1 then
		px = c.cx + d:Dot(c.right) / z * c.k
		py = c.cy - d:Dot(c.up) / z * c.k
		local m = shown and 48 or 0
		onScreen = px >= -m and px <= c.vw + m and py >= -m and py <= c.vh + m
	end

	if not onScreen then
		self:_releaseTagOnly(rec)
		if Config.Arrows then
			self:_drawArrow(rec, d, c)
		else
			self:_releaseArrow(rec)
		end
		return
	end
	self:_releaseArrow(rec)

	local tag = rec.Tag
	if not tag then
		tag = self.tagPool:Acquire() or self:_stealFarthest(dist)
		if not tag then
			return
		end
		rec.Tag, rec.Applied = tag, nil
		local nm = tostring(rec.Player.DisplayName or "")
		tag.Name.Text = nm ~= "" and nm or rec.Player.Name
		tag.Chams.Adornee = rec.Char
		tag.Hp.Size = UDim2.fromScale(rec.HealthFrac, 1)
		tag.Hp.BackgroundColor3 = healthColor(rec.HealthFrac)
		tag.Ghost.Size = UDim2.fromScale(rec.Ghost, 1)
		rec.LastDistM = -1
	end
	rec.Dist = dist
	self:_layout(rec, tag, px, py, z, dist, c)

	-- lock-on candidate
	if c.lockOn and not (Config.LockSkipTeam and self:_isAlly(rec.Player)) then
		local dx, dy = px - c.cx, py - c.cy
		local d2 = dx * dx + dy * dy
		local cur = rec == self.lockRec
		local lim = Config.LockRadius * (cur and 1.4 or 1)
		if d2 <= lim * lim and (not Config.LockLOS or rec.Visible) then
			local score = cur and d2 * 0.4 or d2
			if score < c.bestScore then
				c.bestScore, c.bestRec = score, rec
			end
		end
	end
end

function HUD:_layout(rec, tag, px, py, z, dist, c)
	local detail = dist <= Config.DetailRange * (rec.Detail and 1.1 or 1)
	rec.Detail = detail
	local color = self:_colorFor(rec)

	-- restyle only when something actually changed
	local ap = rec.Applied
	if not ap or ap.color ~= color or ap.style ~= Config.BoxStyle or ap.ver ~= self.cfgVer then
		rec.Applied = { color = color, style = Config.BoxStyle, ver = self.cfgVer }
		local full = Config.BoxStyle == "Full"
		for i, b in tag.Brackets do
			b.BackgroundColor3 = color
			if tag.Horiz[i] then
				b.Size = UDim2.new(full and 1 or 0.3, 0, 0, 2)
			else
				b.Size = UDim2.new(0, 2, full and 1 or 0.22, 0)
			end
		end
		tag.Fill.BackgroundColor3 = color
		tag.Tracer.BackgroundColor3 = color
		tag.Chams.FillColor, tag.Chams.OutlineColor = color, color
		tag.Chams.FillTransparency = Config.ChamsFill
		self.chamsDirty = true
	end

	local s = c.k / z
	local w, h = math.max(s * rec.BoxW, 8), math.max(s * rec.BoxH, 14)

	tag.Box.Visible = Config.Boxes
	if Config.Boxes then
		tag.Box.Position = UDim2.fromOffset(px, py)
		tag.Box.Size = UDim2.fromOffset(w, h)
	end

	local anyLabel = (Config.Names and detail) or (Config.Health and detail and rec.HasHealth) or Config.Distance
	tag.Label.Visible = anyLabel
	if anyLabel then
		tag.Label.Position = UDim2.fromOffset(px, py - h * 0.5 - 3)
		tag.Name.Visible = Config.Names and detail
		local bar = Config.Health and detail and rec.HasHealth
		tag.BarBack.Visible = bar
		tag.Info.Visible = Config.Distance
		if bar and rec.Ghost > rec.HealthFrac and os.clock() >= rec.GhostHold then
			rec.Ghost = math.max(rec.HealthFrac, rec.Ghost - c.dt * 0.8)
			tag.Ghost.Size = UDim2.fromScale(rec.Ghost, 1)
		end
		if self.tick and Config.Distance then
			local m = math.floor(dist * 0.28)
			if m ~= rec.LastDistM then
				rec.LastDistM = m
				tag.Info.Text = m .. " m"
			end
		end
	end

	tag.Tracer.Visible = Config.Tracers
	if Config.Tracers then
		local ox, oy = c.cx, c.tracerY
		local ty = oy >= c.cy and py + h * 0.5 or py - h * 0.5
		local dx, dy = px - ox, ty - oy
		tag.Tracer.Position = UDim2.fromOffset((px + ox) * 0.5, (ty + oy) * 0.5)
		tag.Tracer.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1)
		tag.Tracer.Rotation = math.deg(math.atan2(dy, dx))
	end

	if Config.Skeleton and detail and dist <= Config.SkeletonRange then
		self:_drawSkeleton(rec, color, c)
	elseif rec.Skel then
		self:_releaseSkel(rec)
	end
end

function HUD:_drawArrow(rec, d, c)
	local a = rec.Arrow
	if not a then
		a = self.arrowPool:Acquire()
		if not a then
			return
		end
		rec.Arrow = a
		a.Visible = true
	end
	local ax, ay = d:Dot(c.right), -d:Dot(c.up)
	local len = math.sqrt(ax * ax + ay * ay)
	if len < 1e-3 then
		ax, ay, len = 0, 1, 1
	end
	local ux, uy = ax / len, ay / len
	local R = math.min(c.cx, c.cy) * 0.88
	a.Position = UDim2.fromOffset(c.cx + ux * R, c.cy + uy * R)
	a.Rotation = math.deg(math.atan2(uy, ux))
	-- proximity alert: a player inside the alert radius makes the tick longer and white
	local close = Config.Alert and d.Magnitude <= Config.AlertRadius
	if close ~= rec.ArrowClose then
		rec.ArrowClose = close
		a.Size = close and UDim2.fromOffset(30, 4) or UDim2.fromOffset(16, 3)
	end
	local col = close and Color3.new(1, 1, 1) or self:_colorFor(rec)
	if col ~= rec.ArrowColor then
		rec.ArrowColor = col
		a.BackgroundColor3 = col
	end
end

function HUD:_drawSkeleton(rec, color, c)
	local bones = rec.Bones
	local n = #bones
	if n == 0 then
		return
	end
	local skel = rec.Skel
	if not skel then
		skel = self.skelPool:Acquire()
		if not skel then
			return
		end
		rec.Skel = skel
	end
	local lines = skel.Lines
	if skel.Color ~= color then
		skel.Color = color
		for _, l in lines do
			l.BackgroundColor3 = color
		end
	end
	-- about 0.12 studs wide on screen: thicker up close, never thinner than a hairline
	local thick = math.clamp(c.k * 0.12 / math.max(rec.Dist, 1), 1.2, 3)
	local camPos, look, right, up, cx, cy, k = c.camPos, c.look, c.right, c.up, c.cx, c.cy, c.k
	local used = 0
	for i = 1, n do
		local b = bones[i]
		local pa, pb = b[1], b[3]
		if pa.Parent and pb.Parent then
			-- both ends follow the animation: part CFrame * local joint offset
			local da = pa.CFrame * b[2] - camPos
			local db = pb.CFrame * b[4] - camPos
			local za, zb = da:Dot(look), db:Dot(look)
			if za > 0.1 and zb > 0.1 then
				used += 1
				local line = lines[used]
				if not line then
					used -= 1
					break
				end
				local x1, y1 = cx + da:Dot(right) / za * k, cy - da:Dot(up) / za * k
				local x2, y2 = cx + db:Dot(right) / zb * k, cy - db:Dot(up) / zb * k
				local dx, dy = x2 - x1, y2 - y1
				line.Position = UDim2.fromOffset((x1 + x2) * 0.5, (y1 + y2) * 0.5)
				line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thick)
				line.Rotation = math.deg(math.atan2(dy, dx))
				line.Visible = true
			end
		end
	end
	for i = used + 1, skel.Used do
		lines[i].Visible = false
	end
	skel.Used = used
end

-- Two line-of-sight rays per frame, round-robin over the targets on screen.
function HUD:_visCheck(c)
	if not (Config.VisTint or (Config.Lock and Config.LockLOS)) then
		return
	end
	local list = self.list
	local n = #list
	local done = 0
	for _ = 1, n do
		self.visCursor = self.visCursor % n + 1
		local rec = list[self.visCursor]
		if rec.Tag and rec.Char then
			local aim = self:_aimPoint(rec, "Chest")
			if aim then
				local res = Workspace:Raycast(c.camPos, aim - c.camPos, self.rayParams)
				rec.Visible = res == nil or res.Instance:IsDescendantOf(rec.Char)
			end
			done += 1
			if done >= 2 then
				break
			end
		end
	end
end

-- Highlights: only ~31 render, so the nearest ChamsMax get them.
function HUD:_updateChams()
	local list = self.chamList
	table.clear(list)
	for _, rec in self.list do
		rec.ChamWant = false
		if Config.Chams and rec.Tag and rec.Dist <= Config.ChamsRange then
			list[#list + 1] = rec
		end
	end
	table.sort(list, function(a, b)
		return a.Dist < b.Dist
	end)
	for i = 1, math.min(#list, Config.ChamsMax) do
		list[i].ChamWant = true
	end
	for _, rec in self.list do
		local t = rec.Tag
		if t and t.Chams.Enabled ~= rec.ChamWant then
			t.Chams.Enabled = rec.ChamWant
		end
	end
end

-- One target per frame: character swaps, box size, health safety-net, health re-detection.
function HUD:_rescan(rec, now)
	if now < rec.NextScan then
		return
	end
	rec.NextScan = now + 1
	local resolved = self:_resolveCharacter(rec.Player)
	local cur = rec.Char
	if cur and not cur:IsDescendantOf(Workspace) then
		-- rigs are often re-parented briefly (round reset): keep the binding for a moment
		rec.Missing = rec.Missing or now
		if now - rec.Missing > 1.5 then
			self:_unbind(rec)
			cur, rec.Missing = nil, nil
		else
			return
		end
	else
		rec.Missing = nil
	end
	if rec.Pending then
		return
	end
	if resolved and resolved ~= cur then
		self:_bind(rec, resolved)
	elseif not resolved and cur then
		self:_unbind(rec)
	elseif cur then
		if rec.Root and not rec.Root:IsDescendantOf(cur) then
			return self:_bind(rec, cur, true)
		end
		local better = resolveRoot(cur, false)
		if better and better ~= rec.Root then
			return self:_bind(rec, cur, true)
		end
		self:_scan(rec)
		if not rec.HasHealth then
			self:_setupHealth(rec, cur, cur:FindFirstChildWhichIsA("Humanoid", true))
		end
		if rec.Refresh then
			rec.Refresh()
		end
		if rec.Verify and rec.Verify() then
			return self:_bind(rec, cur, true)
		end
		self.teamIds[rec.Player] = self:_computeTeam(rec.Player, cur)
	end
end

function HUD:Update(dt)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()

	-- FOV changer: applied every frame because many games reset it (sprint effects etc.).
	-- Done before the projection maths below so the ESP always matches the real FOV.
	-- Hold-to-zoom wins over the FOV changer; both ease in and out, and releasing the last one
	-- eases back to the FOV the game had before we touched it.
	local wantFov
	if Config.ZoomOn and self.zoomHeld then
		wantFov = Config.ZoomFov
	elseif Config.FovOn then
		wantFov = Config.Fov
	end
	-- Games and custom camera systems set FOV from their own render steps, tweens and loops, and
	-- often run after this script. So besides writing it every frame, we watch the property:
	-- the instant anything changes it, our value is put straight back (before it can render).
	if camera ~= self.fovCam then
		self.fovCam = camera
		if self.fovConn then
			self.fovConn:Disconnect()
		end
		self.fovConn = camera:GetPropertyChangedSignal("FieldOfView"):Connect(function()
			local target = self.fovTarget
			if target and not self.settingFov and math.abs(camera.FieldOfView - target) > 0.01 then
				self.settingFov = true
				camera.FieldOfView = target
				self.settingFov = false
			end
		end)
	end
	local function setFov(v)
		self.settingFov = true
		camera.FieldOfView = v -- Roblox clamps this to 1..120; nothing can go past that
		self.settingFov = false
	end
	if wantFov then
		if not self.fovCur then
			self.fovOrig = camera.FieldOfView
			self.fovCur = self.fovOrig
		end
		-- fovCur is the "virtual" FOV and may exceed 120. The real camera FOV is capped at 120
		-- (Roblox's hard limit); the excess is shown by pulling the camera back (_applyWide).
		self.fovCur += (math.clamp(wantFov, 5, 200) - self.fovCur) * (1 - math.exp(-14 * dt))
		self.fovTarget = math.min(self.fovCur, 120)
		setFov(self.fovTarget)
	elseif self.fovCur then
		self.fovCur += (self.fovOrig - self.fovCur) * (1 - math.exp(-14 * dt))
		self.fovTarget = math.min(self.fovCur, 120)
		setFov(self.fovTarget)
		if math.abs(self.fovCur - self.fovOrig) < 0.3 then
			self.fovTarget = nil
			setFov(self.fovOrig)
			self.fovCur = nil
		end
	else
		self.fovTarget = nil
	end

	if Config.ColorCycle then
		self:_lighting() -- the colour cycle animates, so it re-applies every frame
	end

	local okLock, eLock = pcall(self._applyLock, self, camera, dt)
	if not okLock then
		self:_err("lock-on", eLock)
	end
	local okWide, eWide = pcall(self._applyWide, self, camera)
	if not okWide then
		self:_err("wide view", eWide)
	end

	-- the overlay's AbsoluteSize is the real screen size and never goes stale
	local vsz = self.overlay.AbsoluteSize
	if vsz.X < 50 or vsz.Y < 50 then
		vsz = camera.ViewportSize
	end
	local vw, vh = math.max(vsz.X, 2), math.max(vsz.Y, 2)
	local cf = camera.CFrame
	local tanHalf = math.tan(math.rad(math.clamp(camera.FieldOfView, 1, 120)) * 0.5)
	local mode = camera.FieldOfViewMode
	if mode == Enum.FieldOfViewMode.Diagonal then
		tanHalf = tanHalf * vh / math.sqrt(vw * vw + vh * vh)
	elseif mode == Enum.FieldOfViewMode.MaxAxis then
		tanHalf = tanHalf * vh / math.max(vw, vh)
	end
	local c = self.ctx
	c.camPos, c.right, c.up, c.look = cf.Position, cf.RightVector, cf.UpVector, cf.LookVector
	c.vw, c.vh, c.cx, c.cy, c.k, c.dt = vw, vh, vw * 0.5, vh * 0.5, vh / (2 * tanHalf), dt
	c.tracerY = Config.TracerFrom == "Bottom" and vh or (Config.TracerFrom == "Center" and vh * 0.5 or 0)
	c.lockOn = self:_lockWanted()
	c.bestRec, c.bestScore = nil, math.huge
	c.show = Config.Enabled and (not Config.PeekMode or self.peekHeld)
	c.count, c.nearest = 0, math.huge

	self.tickTimer += dt
	self.tick = self.tickTimer >= 0.1
	if self.tick then
		self.tickTimer = 0
	end

	local list = self.list
	for i = 1, #list do
		local ok, e = pcall(self._updateRec, self, list[i], c)
		if not ok then
			self:_err("update", e)
		end
	end
	self.lockRec = c.bestRec
	if self.tick then
		self:_updateReadout(c)
	end

	local ok2, e2 = pcall(self._visCheck, self, c)
	if not ok2 then
		self:_err("visibility", e2)
	end

	local n = #list
	if n > 0 then
		self.cursor = self.cursor % n + 1
		local ok3, e3 = pcall(self._rescan, self, list[self.cursor], now)
		if not ok3 then
			self:_err("rescan", e3)
		end
	end

	self.chamTimer += dt
	if self.chamsDirty or self.chamTimer >= 0.25 then
		self.chamTimer, self.chamsDirty = 0, false
		local okc, ec = pcall(self._updateChams, self)
		if not okc then
			self:_err("chams", ec)
		end
	end

	self.slowTimer += dt
	if self.slowTimer >= 1 then
		self.slowTimer = 0
		self:_refreshTeams()
		self:_lighting() -- games that rewrite Lighting get corrected again every second
		self:_applyZoomOut()
		local okh, eh = pcall(self._heal, self)
		if not okh then
			self:_err("heal", eh)
		end
		local lc = self:_resolveCharacter(localPlayer)
		if lc ~= self.lastLocal then
			self.lastLocal = lc
			self.rayParams.FilterDescendantsInstances = lc and { lc } or {}
		end
	end

	local okr, er = pcall(self._updateRadar, self, camera, c, dt)
	if not okr then
		self:_err("radar", er)
	end
end

----------------------------------------------------------------------
-- Lock-on assist
-- Eases the visible camera toward the chosen part. Frame-rate independent, turn-speed
-- limited, with a dead-zone so it never jitters, and capped (it assists; it does not snap).
----------------------------------------------------------------------
function HUD:_lockWanted()
	if not Config.Lock or self.freecam or self.specPlayer or UserInputService:GetFocusedTextBox() then
		return false
	end
	if Config.LockMode == "Toggle" then
		return self.lockToggled
	end
	return self.lockHeld
end

function HUD:_applyLock(camera, dt)
	local rec = self.lockRec
	local engaged = rec ~= nil and rec.Alive and self:_lockWanted()
	local aim = engaged and self:_aimPoint(rec, Config.LockPart) or nil
	if not aim then
		self.lockW = 0
		return
	end
	local cf = camera.CFrame
	local pos = cf.Position
	if Config.LockLOS then
		self.losTimer += dt
		if self.losTimer >= 0.05 then -- 20 Hz line of sight check on the current target
			self.losTimer = 0
			local hit = Workspace:Raycast(pos, aim - pos, self.rayParams)
			self.losOk = hit == nil or hit.Instance:IsDescendantOf(rec.Char)
		end
		if not self.losOk then
			self.lockW = 0
			return
		end
	end
	self.lockW = math.min(1, self.lockW + dt * 8) -- ~0.12 s ramp-in, so engaging is never abrupt
	local want = aim - pos
	local mag = want.Magnitude
	if mag < 0.5 then
		return
	end
	local dir = want / mag
	if math.abs(dir.Y) > 0.999 then
		return -- straight up/down: lookAt would be degenerate
	end
	local ang = math.acos(math.clamp(cf.LookVector:Dot(dir), -1, 1))
	if ang < math.rad(0.2) then
		return -- dead-zone
	end
	local rate = 2 + math.clamp(Config.LockStrength, 0.05, 0.6) * 30
	local step = ang * (1 - math.exp(-rate * dt)) * self.lockW
	step = math.min(step, math.rad(math.clamp(Config.LockMaxTurn, 30, 720)) * dt)
	camera.CFrame = cf:Lerp(CFrame.lookAt(pos, aim), step / ang)
end

----------------------------------------------------------------------
-- HUD overlay: radar, crosshair, lock capture ring
----------------------------------------------------------------------
function HUD:_buildHud()
	local root = self.hudGui
	self.ring = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false,
	}, root)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, self.ring)
	self.ringStroke = New("UIStroke", { Thickness = 1, Transparency = 0.7, Color = Color3.new(1, 1, 1) }, self.ring)

	self.ch = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(), BackgroundTransparency = 1,
	}, root)
	self.chArms = {}
	for i = 1, 4 do
		self.chArms[i] = New("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1) }, self.ch)
	end

	self.radar = New("Frame", { BackgroundColor3 = Color3.fromRGB(14, 15, 17), BackgroundTransparency = 0.25, BorderSizePixel = 0 }, root)
	New("UICorner", { CornerRadius = UDim.new(1, 0) }, self.radar)
	New("UIStroke", { Thickness = 1, Color = Theme.Line }, self.radar)
	New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(5, 5),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, self.radar)
	self.dots = {}
	for i = 1, 48 do
		self.dots[i] = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(5, 5), BorderSizePixel = 0, Visible = false,
		}, self.radar)
		New("UICorner", { CornerRadius = UDim.new(1, 0) }, self.dots[i])
	end
	self.dotsUsed = 0

	-- threat readout (top centre) and a short-lived notice (bottom centre)
	self.readout = New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 16), Size = UDim2.fromOffset(300, 20), BackgroundTransparency = 1,
		Font = FONT_BOLD, TextSize = 15, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.6, Text = "", Visible = false,
	}, root)
	self.notice = New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Size = UDim2.fromOffset(320, 22), BackgroundTransparency = 1,
		Font = FONT_BOLD, TextSize = 15, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.5, TextTransparency = 1, Text = "",
	}, root)
	self.noticeToken = 0
end

function HUD:_notify(text)
	local n = self.notice
	if not n then
		return
	end
	self.noticeToken += 1
	local my = self.noticeToken
	n.Text = text
	n.TextTransparency, n.TextStrokeTransparency = 0, 0.5
	n.Position = UDim2.new(0.5, 0, 1, -100)
	TweenService:Create(n, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 1, -110) }):Play()
	task.delay(1.4, function()
		if my == self.noticeToken and n.Parent then
			TweenService:Create(n, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

function HUD:_updateReadout(c)
	local r = self.readout
	if not r then
		return
	end
	if Config.Readout and c.show and c.count > 0 then
		r.Visible = true
		r.Text = ("%d in range  ·  nearest %d m"):format(c.count, math.floor(c.nearest * 0.28))
	else
		r.Visible = false
	end
end

function HUD:_applyHud()
	local ringD = Config.LockRadius * 2
	self.ring.Size = UDim2.fromOffset(ringD, ringD)
	self.ring.Visible = Config.Lock and Config.LockRing
	self.ch.Visible = Config.Crosshair
	local s, g = Config.CrosshairSize, Config.CrosshairGap
	local a = self.chArms
	a[1].AnchorPoint, a[1].Position, a[1].Size = Vector2.new(0.5, 1), UDim2.fromOffset(0, -g), UDim2.fromOffset(2, s)
	a[2].AnchorPoint, a[2].Position, a[2].Size = Vector2.new(0.5, 0), UDim2.fromOffset(0, g), UDim2.fromOffset(2, s)
	a[3].AnchorPoint, a[3].Position, a[3].Size = Vector2.new(1, 0.5), UDim2.fromOffset(-g, 0), UDim2.fromOffset(s, 2)
	a[4].AnchorPoint, a[4].Position, a[4].Size = Vector2.new(0, 0.5), UDim2.fromOffset(g, 0), UDim2.fromOffset(s, 2)
	local r = self.radar
	r.Visible = Config.Radar
	r.Size = UDim2.fromOffset(Config.RadarSize, Config.RadarSize)
	local corner = Config.RadarCorner
	local right = corner == "TopRight" or corner == "BottomRight"
	local bottom = corner == "BottomLeft" or corner == "BottomRight"
	r.AnchorPoint = Vector2.new(right and 1 or 0, bottom and 1 or 0)
	r.Position = UDim2.new(right and 1 or 0, right and -16 or 16, bottom and 1 or 0, bottom and -16 or 16)
end

-- Radar: forward is up. Fixed dot array, so it never allocates.
function HUD:_updateRadar(camera, c, dt)
	if not Config.Radar then
		return
	end
	self.radarTimer = (self.radarTimer or 0) + dt
	if self.radarTimer < 1 / 30 then
		return
	end
	self.radarTimer = 0
	local look = c.look
	local len = math.sqrt(look.X * look.X + look.Z * look.Z)
	if len < 1e-3 then
		return
	end
	local fx, fz = look.X / len, look.Z / len
	local rx, rz = -fz, fx
	local R = Config.RadarSize * 0.5
	local maxR = R - 4
	local scale = maxR / Config.RadarRange
	local used = 0
	for _, rec in self.list do
		local root = rec.Root
		if root and root.Parent and rec.Alive and rec.InWorld and not self:_blocked(rec.Player) and used < #self.dots then
			local p = root.Position - c.camPos
			local dx, dy = (p.X * rx + p.Z * rz) * scale, (p.X * fx + p.Z * fz) * scale
			local m = math.sqrt(dx * dx + dy * dy)
			local far = m > maxR
			if far then
				dx, dy = dx / m * maxR, dy / m * maxR
			end
			used += 1
			local dot = self.dots[used]
			dot.Position = UDim2.fromOffset(R + dx, R - dy)
			dot.BackgroundColor3 = self:_colorFor(rec)
			dot.BackgroundTransparency = far and 0.65 or 0
			dot.Visible = true
		end
	end
	for i = used + 1, self.dotsUsed do
		self.dots[i].Visible = false
	end
	self.dotsUsed = used
end

----------------------------------------------------------------------
-- Spectate / freecam
----------------------------------------------------------------------
function HUD:Spectate(p)
	self.specJan:Clean()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if self.freecam then
		self:SetFreecam(false)
	end
	local function follow(ch)
		if not ch then
			return
		end
		local hum = ch:FindFirstChildWhichIsA("Humanoid", true)
		if hum then
			camera.CameraSubject = hum
			return
		end
		local part = resolveRoot(ch)
		if part then
			camera.CameraSubject = part
		end
	end
	self.specPlayer = p
	if p then
		follow(self:_resolveCharacter(p))
		self.specJan:Add(p.CharacterAdded:Connect(function(ch)
			task.wait(0.3)
			if self.specPlayer == p and not self.destroyed then
				follow(ch)
			end
		end))
	else
		follow(self:_resolveCharacter(localPlayer))
	end
	if self.refreshSpectateList then
		self.refreshSpectateList()
	end
end

function HUD:_specCycle(dir)
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= localPlayer then
			list[#list + 1] = p
		end
	end
	if #list == 0 then
		return
	end
	local idx = table.find(list, self.specPlayer) or 0
	if idx == 0 and dir < 0 then
		idx = 1
	end
	self:Spectate(list[(idx - 1 + dir) % #list + 1])
end

function HUD:SetFreecam(on)
	if on == self.freecam then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if on then
		if self.specPlayer then
			self:Spectate(nil)
		end
		local cf = camera.CFrame
		self.fcPitch, self.fcYaw = cf:ToOrientation()
		self.fcPos = cf.Position
		self.fcSaved = camera.CameraType
		camera.CameraType = Enum.CameraType.Scriptable
		-- sink movement keys so the character doesn't walk while flying the camera
		ContextActionService:BindActionAtPriority("TacticalHUD_FreecamSink", function()
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
			Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.Space, Enum.KeyCode.LeftShift)
		RunService:BindToRenderStep("TacticalHUD_Freecam", Enum.RenderPriority.Camera.Value, function(dt)
			local cam = Workspace.CurrentCamera
			if not cam then
				return
			end
			local rot = CFrame.fromOrientation(self.fcPitch, self.fcYaw, 0)
			local key = function(k)
				return UserInputService:IsKeyDown(k)
			end
			local move = Vector3.zero
			if key(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
			if key(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
			if key(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
			if key(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
			local up = (key(Enum.KeyCode.E) or key(Enum.KeyCode.Space)) and 1 or 0
			if key(Enum.KeyCode.Q) then up -= 1 end
			local speed = Config.FreecamSpeed * (key(Enum.KeyCode.LeftShift) and 3 or 1) * (key(Enum.KeyCode.LeftControl) and 0.25 or 1)
			self.fcPos += (rot:VectorToWorldSpace(move) + Vector3.new(0, up, 0)) * speed * dt
			cam.CFrame = CFrame.new(self.fcPos) * rot
		end)
		self.freecam = true
	else
		self.freecam = false
		RunService:UnbindFromRenderStep("TacticalHUD_Freecam")
		ContextActionService:UnbindAction("TacticalHUD_FreecamSink")
		camera.CameraType = self.fcSaved
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	if self.menu then
		self.menu.Refresh()
	end
end

----------------------------------------------------------------------
-- Diagnostics
----------------------------------------------------------------------
function HUD:_verdict(rec)
	if not rec then
		return "no record"
	end
	if not rec.Root then
		return "NOT BOUND (no character / root part found)"
	end
	if not rec.InWorld then
		return "character not in Workspace"
	end
	if not rec.Alive then
		return "treated as dead (health " .. tostring(rec.Health) .. ")"
	end
	if self:_blocked(rec.Player) then
		return ("HIDDEN BY 'Show: %s' (their team '%s', yours '%s')"):format(
			Config.Show, tostring(self.teamIds[rec.Player]), tostring(self.localTeam)
		)
	end
	local cam = Workspace.CurrentCamera
	if cam then
		local dist = (rec.Root.Position - cam.CFrame.Position).Magnitude
		if dist > Config.MaxRange then
			return ("out of range (%d studs)"):format(math.floor(dist))
		end
	end
	return rec.Tag and "SHOWN" or "eligible (off-screen, or no free tag)"
end

function HUD:PrintDiagnostics()
	local out = { ("[TacticalHUD] %d players tracked | rebuilds %d | reclaimed %d | errors %d"):format(
		#self.list, self.stats.rebuilds, self.stats.reclaimed, self.stats.errors) }
	for _, p in Players:GetPlayers() do
		if p ~= localPlayer then
			local rec = self.recs[p]
			local found = self:_resolveCharacter(p)
			out[#out + 1] = ("%s | char=%s | %s | %s"):format(
				p.Name, found and found:GetFullName() or "NOT FOUND", rec and rec.Info or "-", self:_verdict(rec))
		end
	end
	out[#out + 1] = ("you: team '%s'"):format(tostring(self.localTeam))
	print(table.concat(out, "\n"))
end

