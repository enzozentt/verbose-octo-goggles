	self._statsTimer, self._radarTimer = 0, 0
	self._fpsFrames, self._fpsTimer, self._fps = 0, 0, 60
	self._stats = { Total = 0, Mode = 0, Range = 0, Screen = 0, Radius = 0, Visible = 0, Arrows = 0, Bound = 0 }

