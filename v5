----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------
----------------------------------------------------------------------
-- World: fullbright and the FPS booster. Both record what they change and put it back.
----------------------------------------------------------------------
-- Lighting manager --------------------------------------------------------------
-- Every lighting feature (fullbright, fog colour, sky tint, time lock, no shadows, hide sun,
-- colour cycle) is computed together from a snapshot of the game's own values, so they combine
-- cleanly and switching them all off restores the original look exactly.
local LIGHT_PROPS = {
	"Brightness", "ClockTime", "FogColor", "FogEnd", "FogStart", "GlobalShadows", "Ambient", "OutdoorAmbient",
	"ExposureCompensation", "ColorShift_Top", "ColorShift_Bottom",
}
local WHITE = Color3.new(1, 1, 1)

function HUD:_lightingActive()
	return Config.Fullbright or Config.NoShadows or Config.LockTime or Config.FogOn or Config.SkyOn or Config.HideSun or Config.ColorCycle
end

function HUD:_lightingRestore()
	local s = self.lightSaved
	self.lightSaved = nil
	if self.ownAtmos then
		self.ownAtmos:Destroy()
		self.ownAtmos = nil
	end
	if not s then
		return
	end
	for _, p in LIGHT_PROPS do
		pcall(function()
			Lighting[p] = s[p]
		end)
	end
	for a, base in s.atmos do
		if a.Parent then
			for k, v in base do
				a[k] = v
			end
		end
	end
	for sky, base in s.skies do
		if sky.Parent then
			for k, v in base do
				sky[k] = v
			end
		end
	end
end

function HUD:_lighting()
	if not self:_lightingActive() then
		if self.lightSaved then
			self:_lightingRestore()
		end
		return
	end
	if not self.lightSaved then
		local s = { atmos = {}, skies = {} }
		for _, p in LIGHT_PROPS do
			s[p] = Lighting[p]
		end
		for _, o in Lighting:GetChildren() do
			if o:IsA("Atmosphere") then
				s.atmos[o] = { Color = o.Color, Decay = o.Decay, Density = o.Density, Haze = o.Haze, Offset = o.Offset, Glare = o.Glare }
			elseif o:IsA("Sky") then
				s.skies[o] = { SunAngularSize = o.SunAngularSize, MoonAngularSize = o.MoonAngularSize, StarCount = o.StarCount }
			end
		end
		self.lightSaved = s
	end
	local s = self.lightSaved

	local fogOn, skyOn = Config.FogOn, Config.SkyOn
	local fogColor, skyColor = Config.FogColor, Config.SkyColor
	if Config.ColorCycle then
		local c = Color3.fromHSV((os.clock() * Config.CycleSpeed) % 1, 0.55, 1)
		fogColor, skyColor, fogOn, skyOn = c, c, true, true
	end

	local brightness, ambient, outdoor, exposure = s.Brightness, s.Ambient, s.OutdoorAmbient, s.ExposureCompensation
	local shadows, clock, fogStart, fogEnd = s.GlobalShadows, s.ClockTime, s.FogStart, s.FogEnd
	local clearHaze = false
	if Config.Fullbright then
		brightness, ambient, outdoor, exposure = 2, Color3.fromRGB(170, 170, 170), Color3.fromRGB(170, 170, 170), 0
		shadows, clock, fogStart, fogEnd, clearHaze = false, 14, 0, 1000000, true
	end
	if Config.NoShadows then
		shadows = false
	end
	if Config.LockTime then
		clock = Config.TimeOfDay
	end
	local fogDensity = math.clamp(220 / math.max(Config.FogDistance, 10), 0.05, 0.95)
	if fogOn then
		fogStart, fogEnd = 0, Config.FogDistance
	end

	Lighting.Brightness, Lighting.Ambient, Lighting.OutdoorAmbient = brightness, ambient, outdoor
	Lighting.ExposureCompensation, Lighting.GlobalShadows, Lighting.ClockTime = exposure, shadows, clock
	Lighting.FogStart, Lighting.FogEnd = fogStart, fogEnd
	Lighting.FogColor = fogOn and fogColor or s.FogColor
	Lighting.ColorShift_Top = skyOn and skyColor or s.ColorShift_Top
	Lighting.ColorShift_Bottom = skyOn and skyColor:Lerp(WHITE, 0.35) or s.ColorShift_Bottom

	-- Atmosphere (newer places ignore plain fog and use this instead)
	local hasAtmos = false
	for a, base in s.atmos do
		if a.Parent then
			hasAtmos = true
			local density, haze, color, decay = base.Density, base.Haze, base.Color, base.Decay
			if clearHaze then
				density, haze = 0, 0
			end
			if fogOn then
				density, color, haze = fogDensity, fogColor, math.max(haze, 1)
			end
			if skyOn then
				decay = skyColor
				if not fogOn then
					color = skyColor:Lerp(WHITE, 0.5)
				end
			end
			a.Density, a.Haze, a.Color, a.Decay = density, haze, color, decay
		end
	end
	if (fogOn or skyOn) and not hasAtmos then
		-- the place has no Atmosphere: make one of our own so fog / sky colour still show
		local own = self.ownAtmos
		if not own or not own.Parent then
			own = New("Atmosphere", { Name = "FF_Atmosphere", Offset = 0.25 }, Lighting)
			self.ownAtmos = own
		end
		own.Density = fogOn and fogDensity or 0.3
		own.Color = fogOn and fogColor or skyColor:Lerp(WHITE, 0.5)
		own.Decay = skyOn and skyColor or fogColor
		own.Haze = 1
	elseif self.ownAtmos then
		self.ownAtmos:Destroy()
		self.ownAtmos = nil
	end

	for sky, base in s.skies do
		if sky.Parent then
			if Config.HideSun then
				sky.SunAngularSize, sky.MoonAngularSize, sky.StarCount = 0, 0, 0
			else
				sky.SunAngularSize, sky.MoonAngularSize, sky.StarCount = base.SunAngularSize, base.MoonAngularSize, base.StarCount
			end
		end
	end
end

-- Screen filters / bloom / sun rays: our own post-effect instances, switched on and off.
local FILTERS = {
	Warm = { b = 0.02, c = 0.1, s = 0.15, t = Color3.fromRGB(255, 225, 190) },
	Cool = { b = 0, c = 0.1, s = 0.05, t = Color3.fromRGB(190, 215, 255) },
	Noir = { b = 0, c = 0.25, s = -1, t = Color3.new(1, 1, 1) },
	Vivid = { b = 0, c = 0.15, s = 0.6, t = Color3.new(1, 1, 1) },
	Night = { b = 0.05, c = 0.15, s = -0.3, t = Color3.fromRGB(150, 255, 170) },
}

function HUD:_post()
	local function effect(key, class, name)
		local e = self[key]
		if not e or not e.Parent then
			e = New(class, { Name = name, Enabled = false }, Lighting)
			self[key] = e
		end
		return e
	end
	local f = FILTERS[Config.Filter]
	if f then
		local cc, i = effect("fxCC", "ColorCorrectionEffect", "FF_ColorCorrection"), Config.FilterAmount
		cc.Brightness, cc.Contrast, cc.Saturation = f.b * i, f.c * i, f.s * i
		cc.TintColor = WHITE:Lerp(f.t, i)
		cc.Enabled = true
	elseif self.fxCC then
		self.fxCC.Enabled = false
	end
	if Config.Bloom then
		local b = effect("fxBloom", "BloomEffect", "FF_Bloom")
		b.Intensity, b.Size, b.Threshold = Config.BloomAmount, 24, 0.9
		b.Enabled = true
	elseif self.fxBloom then
		self.fxBloom.Enabled = false
	end
	if Config.SunRays then
		local r = effect("fxRays", "SunRaysEffect", "FF_SunRays")
		r.Intensity, r.Spread = 0.25, 1
		r.Enabled = true
	elseif self.fxRays then
		self.fxRays.Enabled = false
	end
end

-- "Wide view": Roblox caps FOV at 120, so anything above that is faked by pulling the camera
-- straight back along its look direction (about a quarter stud per extra degree). You see more
-- of the scene around you, much like a wider lens. The pull-back stops at walls.
function HUD:_applyWide(camera)
	local excess = self.fovCur and math.max(self.fovCur - 120, 0) or 0
	if excess <= 0 or self.freecam then
		self.wideBase = nil
		return
	end
	local cf = camera.CFrame
	local want = excess * 0.25
	local hit = Workspace:Raycast(cf.Position, -cf.LookVector * (want + 0.5), self.rayParams)
	local d = hit and math.max(hit.Distance - 0.5, 0) or want
	self.wideBase = cf
	camera.CFrame = cf * CFrame.new(0, 0, d)
	self.wideApplied = camera.CFrame
end

-- Lets the camera zoom out further than the game normally allows.
function HUD:_applyZoomOut()
	if Config.ZoomOut then
		if self.zoomMaxOrig == nil then
			self.zoomMaxOrig = localPlayer.CameraMaxZoomDistance
		end
		localPlayer.CameraMaxZoomDistance = Config.MaxZoomDist
	elseif self.zoomMaxOrig ~= nil then
		localPlayer.CameraMaxZoomDistance = self.zoomMaxOrig
		self.zoomMaxOrig = nil
	end
end

local BOOST_EFFECTS = { ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true }

-- Strips one instance. Originals are recorded the first time a property is touched.
--   Textures: decals / textures, SurfaceAppearance, mesh texture maps, material patterns
--   Max     : also particles, trails, post-processing, shadows, terrain decoration, render quality
function HUD:_boostOne(inst, level)
	local saved = self.boostSaved
	local function keep(prop, value)
		local s = saved[inst]
		if not s then
			s = {}
			saved[inst] = s
		end
		if s[prop] == nil then
			s[prop] = inst[prop]
		end
		inst[prop] = value
	end
	if inst:IsA("Decal") or inst:IsA("Texture") then
		keep("Transparency", 1)
	elseif inst:IsA("SurfaceAppearance") then
		table.insert(self.boostDetached, { inst, inst.Parent })
		inst.Parent = nil
	elseif inst:IsA("Terrain") then
		return
	elseif inst:IsA("BasePart") then
		if inst.Material ~= Enum.Material.SmoothPlastic then
			keep("Material", Enum.Material.SmoothPlastic)
		end
		if inst.Reflectance ~= 0 then
			keep("Reflectance", 0)
		end
		if inst:IsA("MeshPart") and inst.TextureID ~= "" then
			keep("TextureID", "")
		end
	elseif level == "Max" and (BOOST_EFFECTS[inst.ClassName] or inst:IsA("PostEffect")) then
		keep("Enabled", false)
	end
end

function HUD:_boostStart()
	self.boostSaved = setmetatable({}, { __mode = "k" }) -- weak: destroyed instances drop out
	self.boostDetached = {}
	self.boostToken = (self.boostToken or 0) + 1
	local token, level = self.boostToken, Config.BoostLevel
	if level == "Max" then
		self.boostShadows = Lighting.GlobalShadows
		Lighting.GlobalShadows = false
		pcall(function()
			self.boostQuality = settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		pcall(function()
			self.boostDeco = Workspace.Terrain.Decoration
			Workspace.Terrain.Decoration = false
		end)
	end
	-- anything that streams in later is stripped too
	self.boostConn = Workspace.DescendantAdded:Connect(function(inst)
		if token == self.boostToken then
			pcall(self._boostOne, self, inst, level)
		end
	end)
	-- the existing world, in chunks so enabling it never freezes the game
	task.spawn(function()
		local n = 0
		for _, d in Workspace:GetDescendants() do
			if token ~= self.boostToken or self.destroyed then
				return
			end
			pcall(self._boostOne, self, d, level)
			n += 1
			if n % 400 == 0 then
				task.wait()
			end
		end
	end)
end

function HUD:_boostStop()
	self.boostToken = (self.boostToken or 0) + 1
	if self.boostConn then
		self.boostConn:Disconnect()
		self.boostConn = nil
	end
	local saved, detached = self.boostSaved, self.boostDetached
	self.boostSaved, self.boostDetached = nil, nil
	if self.boostShadows ~= nil then
		Lighting.GlobalShadows = self.boostShadows
		self.boostShadows = nil
	end
	if self.boostQuality then
		local q = self.boostQuality
		self.boostQuality = nil
		pcall(function()
			settings().Rendering.QualityLevel = q
		end)
	end
	if self.boostDeco ~= nil then
		local d = self.boostDeco
		self.boostDeco = nil
		pcall(function()
			Workspace.Terrain.Decoration = d
		end)
	end
	if detached then
		for _, e in detached do
			if e[2] and e[2].Parent then
				pcall(function()
					e[1].Parent = e[2]
				end)
			end
		end
	end
	if saved then
		task.spawn(function()
			local n = 0
			for inst, props in saved do
				if inst.Parent then
					for p, v in props do
						pcall(function()
							inst[p] = v
						end)
					end
				end
				n += 1
				if n % 400 == 0 then
					task.wait()
				end
			end
		end)
	end
end

-- Called from _bump on every menu change; only acts when a setting actually flipped.
function HUD:_applyWorld()
	self:_lighting()
	local want = Config.Boost and Config.BoostLevel or nil
	if want ~= self.boostWant then
		if self.boostWant then
			self:_boostStop()
		end
		self.boostWant = want
		if want then
			self:_boostStart()
		end
	end
	self:_post()
	self:_applyZoomOut()
end

function HUD:Start()
	local j = self.jan
	self:_refreshTeams()
	for _, prop in { "Team", "TeamColor", "Neutral" } do
		j:Add(localPlayer:GetPropertyChangedSignal(prop):Connect(function()
			self:_refreshTeams()
		end))
	end
	-- round changes usually respawn us and/or swap the camera: re-verify shortly after
	j:Add(localPlayer.CharacterAdded:Connect(function()
		self:_scheduleHeal(1)
	end))
	j:Add(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		self:_scheduleHeal(0.5)
	end))

	self:_buildMenu()
	j:Add(Players.PlayerAdded:Connect(function(p)
		self:_addPlayer(p)
	end))
	j:Add(Players.PlayerRemoving:Connect(function(p)
		self:_removePlayer(p)
	end))
	for _, p in Players:GetPlayers() do
		self:_addPlayer(p)
	end

	j:Add(UserInputService.InputBegan:Connect(function(input, processed)
		if self.menu.HandleInput(input) then
			return
		end
		if self.freecam and input.UserInputType == Enum.UserInputType.MouseButton2 then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
		if processed then
			return
		end
		if bindMatches(input, Config.LockBind) then
			if Config.LockMode == "Hold" then
				self.lockHeld = true
			else
				self.lockToggled = not self.lockToggled
				if Config.Lock then
					self:_notify(self.lockToggled and "Lock-on on" or "Lock-on off")
				end
			end
		end
		if Config.PeekMode and bindMatches(input, Config.PeekKey) then
			self.peekHeld = true
		end
		if Config.ZoomOn and bindMatches(input, Config.ZoomKey) then
			self.zoomHeld = true
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local k = input.KeyCode
		if k == Config.MenuKey then
			self.menu.Toggle()
		elseif k == Config.ToggleKey then
			Config.Enabled = not Config.Enabled
			self:_notify(Config.Enabled and "ESP on" or "ESP off")
			self.menu.Refresh()
		elseif k == Config.SpecNext then
			self:_specCycle(1)
		elseif k == Config.SpecPrev then
			self:_specCycle(-1)
		end
	end))
	j:Add(UserInputService.InputEnded:Connect(function(input)
		if bindMatches(input, Config.LockBind) then
			self.lockHeld = false
		end
		if bindMatches(input, Config.PeekKey) then
			self.peekHeld = false
		end
		if bindMatches(input, Config.ZoomKey) then
			self.zoomHeld = false
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and self.freecam then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end))
	j:Add(UserInputService.InputChanged:Connect(function(input)
		if self.freecam and input.UserInputType == Enum.UserInputType.MouseMovement
			and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			self.fcYaw -= input.Delta.X * 0.003
			self.fcPitch = math.clamp(self.fcPitch - input.Delta.Y * 0.003, -1.5, 1.5)
		end
	end))

	-- Runs LAST in the frame, after every camera script, so projections match what is rendered.
	-- Unique name per instance: a stale copy of this script can never unbind or collide with it.
	self.stepName = "TacticalHUD_" .. tostring(math.random(1, 1000000000))
	-- First thing each frame: take the wide-view pull-back off again, so a camera script that reads
	-- the previous CFrame never sees it (otherwise the offset could compound frame after frame).
	RunService:BindToRenderStep(self.stepName .. "_first", Enum.RenderPriority.First.Value, function()
		local cam = Workspace.CurrentCamera
		if cam and self.wideBase and cam.CFrame == self.wideApplied then
			cam.CFrame = self.wideBase
		end
		self.wideBase = nil
	end)
	RunService:BindToRenderStep(self.stepName, Enum.RenderPriority.Last.Value, function(dt)
		local ok, e = pcall(self.Update, self, dt)
		if not ok then
			self:_err("frame", e)
		end
	end)
end

function HUD:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	if self.stepName then
		RunService:UnbindFromRenderStep(self.stepName)
		RunService:UnbindFromRenderStep(self.stepName .. "_first")
		local cam = Workspace.CurrentCamera
		if cam and self.wideBase and cam.CFrame == self.wideApplied then
			cam.CFrame = self.wideBase
		end
	end
	if self.freecam then
		self:SetFreecam(false)
	end
	-- put the world back the way we found it
	pcall(function()
		self.fovTarget = nil
		if self.fovConn then
			self.fovConn:Disconnect()
			self.fovConn = nil
		end
		self:_lightingRestore()
		self:_boostStop()
		for _, k in { "fxCC", "fxBloom", "fxRays" } do
			if self[k] then
				self[k]:Destroy()
			end
		end
		Config.ZoomOut = false
		self:_applyZoomOut()
		if self.fovCur and self.fovOrig and Workspace.CurrentCamera then
			Workspace.CurrentCamera.FieldOfView = self.fovOrig
		end
	end)
	self.specJan:Clean()
	self.jan:Clean()
	for _, rec in self.list do
		rec.Jan:Clean()
		rec.PJan:Clean()
	end
	for _, pool in { self.tagPool, self.arrowPool, self.skelPool } do
		pool:Destroy()
	end
	for _, inst in { self.overlay, self.hudGui, self.chamFolder } do
		pcall(function()
			inst:Destroy()
		end)
	end
	if self.menu then
		self.menu.Destroy()
	end
end

