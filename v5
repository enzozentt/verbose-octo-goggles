local Utils = {}

-- Green (1.0) -> Yellow (0.5) -> Red (0.0). Only called on health events.
function Utils.HealthColor(frac: number): Color3
	frac = math.clamp(frac, 0, 1)
	if frac >= 0.5 then
		return Config.ColorHalf:Lerp(Config.ColorFull, (frac - 0.5) * 2)
	end
	return Config.ColorEmpty:Lerp(Config.ColorHalf, frac * 2)
end

-- Instance factory: properties first, Parent last (avoids redundant re-layout).
function Utils.New(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className :: any) :: any
	for k, v in props do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local New = Utils.New

-- Rig helpers (custom characters). Run at bind / rescan time, never per frame. --
-- Direct children win over deeper matches, so an accessory's part that happens to
-- be named "Head" or "Root" can never be mistaken for the rig's own.
function Utils.FindPart(model: Model, names: { string }): BasePart?
	for _, n in names do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	for _, n in names do
		local p = model:FindFirstChild(n, true)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return nil
end

-- Root = Humanoid.RootPart, else first matching name, else PrimaryPart, and only
-- if allowLargest ~= false, the largest part by volume (a last resort: using it
-- too early picks a random limb while the rig is still replicating).
function Utils.ResolveRoot(model: Model, allowLargest: boolean?): BasePart?
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.RootPart and hum.RootPart:IsDescendantOf(model) then
		return hum.RootPart
	end
	local named = Utils.FindPart(model, RigConfig.RootPartNames)
	if named then
		return named
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	if allowLargest == false then
		return nil
	end
	local best: BasePart? = nil
	local bestVol = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local s = d.Size
			local vol = s.X * s.Y * s.Z
			if vol > bestVol then
				best, bestVol = d, vol
			end
		end
	end
	return best
end

-- Does this model plausibly look like a character? Used to reject map objects that
-- merely share a name with a player.
function Utils.Plausible(model: Model): boolean
	if model:FindFirstChildOfClass("Humanoid") then
		return true
	end
	for _, n in RigConfig.RootPartNames do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return true
		end
	end
	return model.PrimaryPart ~= nil
end

function Utils.ResolveHead(model: Model): BasePart?
	return Utils.FindPart(model, RigConfig.HeadPartNames)
end

-- "Looks like a character": has a root-named part AND a head-named part.
-- Direct children only, so container folders/models that merely hold rigs don't match.
local function hasDirectPart(model: Model, names: { string }): boolean
	for _, n in names do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return true
		end
	end
	return false
end
function Utils.LooksLikeRig(model: Model): boolean
	return hasDirectPart(model, RigConfig.RootPartNames) and hasDirectPart(model, RigConfig.HeadPartNames)
end

-- Wraps a bare Model in a Player-shaped table so the rest of the HUD
-- (names, teams, health attributes, spectate) treats it like any target.
function Utils.MakeEntity(model: Model): any
	local e: any = {
		IsEntity = true,
		Model = model,
		Name = model.Name,
		DisplayName = tostring(model:GetAttribute("DisplayName") or model.Name),
		UserId = 0,
		Team = nil,
	}
	function e.GetAttribute(self: any, name: string)
		return self.Model:GetAttribute(name)
	end
	function e.GetAttributeChangedSignal(self: any, name: string)
		return self.Model:GetAttributeChangedSignal(name)
	end
	return e
end

local function asNumber(x: any, default: number): number
	return if type(x) == "number" then x else default
end

-- A bind is an Enum.KeyCode or an Enum.UserInputType (mouse button).
function Utils.BindMatches(input: InputObject, bind: EnumItem): boolean
	if (bind :: any).EnumType == Enum.KeyCode then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == (bind :: any)
	end
	return input.UserInputType == (bind :: any)
end

local MouseBindNames: { [string]: string } = {
	MouseButton1 = "Mouse 1 (LMB)",
	MouseButton2 = "Mouse 2 (RMB)",
	MouseButton3 = "Mouse 3 (MMB)",
}
function Utils.BindName(bind: EnumItem): string
	return MouseBindNames[bind.Name] or bind.Name
end

export type Janitor = {
	Add: (self: Janitor, conn: RBXScriptConnection) -> RBXScriptConnection,
	Clean: (self: Janitor) -> (),
}

function Utils.NewJanitor(): Janitor
	local conns: { RBXScriptConnection } = {}
	local self = {}
	function self.Add(_, conn: RBXScriptConnection)
		table.insert(conns, conn)
		return conn
	end
	function self.Clean(_)
		for i = #conns, 1, -1 do
			conns[i]:Disconnect()
		end
		table.clear(conns)
	end
	return self :: any
end

----------------------------------------------------------------------
-- POOL
-- Why: Instance.new/Destroy churn creates garbage (GC hitches) and layout
-- work. Pay construction once at startup, then only recycle. Acquire()
-- returns nil when empty rather than allocating, so PoolSize is a hard
-- budget on worst-case UI cost.
----------------------------------------------------------------------
export type Pool<T> = {
	Acquire: (self: Pool<T>) -> T?,
	Release: (self: Pool<T>, item: T) -> (),
	FreeCount: (self: Pool<T>) -> number,
	Capacity: (self: Pool<T>) -> number,
	Destroy: (self: Pool<T>) -> (),
}

local Pool = {}
Pool.__index = Pool

function Pool.new<T>(size: number, factory: () -> T, onRelease: (T) -> (), onDestroy: (T) -> ()): Pool<T>
	local self = {
		_free = table.create(size) :: { T },
		_freeCount = 0,
		_all = table.create(size) :: { T },
		_inPool = {} :: { [T]: boolean }, -- pre-populated: flipping values never rehashes
		_onRelease = onRelease,
		_onDestroy = onDestroy,
	}
	for i = 1, size do
		local item = factory()
		onRelease(item)
		self._all[i] = item
		self._free[i] = item
		self._inPool[item] = true
	end
	self._freeCount = size
	return setmetatable(self, Pool) :: any
end

function Pool.Acquire<T>(self: any): T?
	local n: number = self._freeCount
	if n == 0 then
		return nil
	end
	local item = self._free[n]
	self._free[n] = nil
	self._freeCount = n - 1
	self._inPool[item] = false
	return item
end

function Pool.Release<T>(self: any, item: T)
	if self._inPool[item] ~= false then
		return -- unknown item or double release
	end
	-- A failing reset must never strand the item "in use" forever (that slowly starves
	-- the pool): log it and return the item anyway.
	local ok, err = pcall(self._onRelease, item)
	if not ok and not self._warned then
		self._warned = true
		warn("[TacticalHUD] pool reset error (item recycled anyway): " .. tostring(err))
	end
	self._inPool[item] = true
	local n: number = self._freeCount + 1
	self._free[n] = item
	self._freeCount = n
end

-- Leak recovery: anything marked in-use that nothing actually holds goes back to the pool.
function Pool.Reclaim(self: any, held: { [any]: boolean }): number
	local reclaimed = 0
	for _, item in self._all do
		if self._inPool[item] == false and not held[item] then
			Pool.Release(self, item)
			reclaimed += 1
		end
	end
	return reclaimed
end

function Pool.FreeCount(self: any): number
	return self._freeCount
end

function Pool.Capacity(self: any): number
	return #self._all
end

function Pool.Destroy(self: any)
	for _, item in self._all do
		self._onDestroy(item)
	end
	table.clear(self._all)
	table.clear(self._free)
	table.clear(self._inPool)
	self._freeCount = 0
end

