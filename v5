	-- Tabs ---------------------------------------------------------------
	local function selectTab(index: number, instant: boolean?)
		current = index
		for i, t in tabsData do
			if i == index then
				t.Wrapper.Visible = true
				if instant then
					t.Wrapper.GroupTransparency = 0
					t.Wrapper.Position = UDim2.fromOffset(RAIL, HEADER + 1)
				else
					t.Wrapper.GroupTransparency = 1
					t.Wrapper.Position = UDim2.fromOffset(RAIL, HEADER + 17)
					tween(t.Wrapper, med, { GroupTransparency = 0, Position = UDim2.fromOffset(RAIL, HEADER + 1) })
				end
			else
				t.Wrapper.Visible = false
			end
		end
		local y = tabsData[index].Y
		if instant then
			selector.Position = UDim2.fromOffset(8, y)
			railBar.Position = UDim2.fromOffset(0, y + 16)
		else
			tween(selector, slide, { Position = UDim2.fromOffset(8, y) })
			tween(railBar, slide, { Position = UDim2.fromOffset(0, y + 16) })
		end
		updateTabColors()
	end

	-- Search + card collapse share one visibility pass.
	local function applyFilter()
		local q = search.Text:lower()
		local firstHit: number? = nil
		for i, t in tabsData do
			local total = 0
			for _, sec in t.Cards do
				local vis = 0
				for _, r in sec.Rows do
					local match = q == "" or r.Text:find(q, 1, true) ~= nil
					if match then
						total += 1
						vis += 1
					end
					r.Row.Visible = match and not (q == "" and sec.Collapsed)
				end
				sec.Card.Visible = q == "" or vis > 0
			end
			t.Count = total
			t.Badge.Visible = q ~= "" and total > 0
			t.Badge.Text = tostring(total)
			local dim = if q ~= "" and total == 0 then 0.65 else 0
			t.Caption.TextTransparency, t.Icon.TextTransparency = dim, dim
			if q ~= "" and total > 0 and not firstHit then
				firstHit = i
			end
		end
		if q ~= "" and current > 0 and tabsData[current].Count == 0 and firstHit then
			selectTab(firstHit)
		end
	end
	janitor:Add(search:GetPropertyChangedSignal("Text"):Connect(applyFilter))

