	-- Returns true when the input was consumed by a pending bind capture.
	-- Keyboard keys always bind; mouse buttons only for binds that allow them.
	function menu.HandleKey(input: InputObject): boolean
		local l = listening
		if not l then
			return false
		end
		local t = input.UserInputType
		local bind: EnumItem? = nil
		if t == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				listening = nil
				refreshAll()
				return true
			end
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				bind = input.KeyCode
			end
		elseif l.AllowMouse and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3) then
			if t == Enum.UserInputType.MouseButton1 then
				-- clicking the capturing chip again cancels instead of binding LMB
				local m = UserInputService:GetMouseLocation()
				local p, s = l.Button.AbsolutePosition, l.Button.AbsoluteSize
				if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y then
					listening = nil
					refreshAll()
					return true
				end
			end
			bind = t
		else
			return false
		end
		listening = nil
		if bind then
			l.Set(bind)
			onChange()
		end
		refreshAll()
		return true
	end

