		menu.SetScale(Config.MenuScale)
		menu.SetOpacity(Config.MenuOpacity)
	end)
	return baseOnChange
end

-- Lifecycle -------------------------------------------------------------
function HUDManager.Start(self: any)
	local j = self._janitor

	-- Keep our own character out of occlusion rays; stop spectating on respawn
	-- (the default camera script resets the subject anyway).
	local function onLocalChar(char: Model?)
		self._rayParams.FilterDescendantsInstances = if char then { char } else {}
		if self._specPlayer then
			self._specPlayer = nil
			self._specJanitor:Clean()
			self:_playersChanged()
		end
	end
	onLocalChar(localPlayer.Character)
	j:Add(localPlayer.CharacterAdded:Connect(onLocalChar))

	self:_buildStatic()
	self:_buildMenu()
	self:_applyStatic()

	j:Add(Players.PlayerAdded:Connect(function(p)
		self:_addPlayer(p)
	end))
	j:Add(Players.PlayerRemoving:Connect(function(p)
		self:_removePlayer(p)
	end))
	for _, p in Players:GetPlayers() do
		self:_addPlayer(p)
	end

	local menu = self._menu
	j:Add(UserInputService.InputBegan:Connect(function(input, processed)
		if menu.HandleKey(input) then
			return
		end
		if self._freecam and input.UserInputType == Enum.UserInputType.MouseButton2 then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
		-- Soft-lock bind: a key OR a mouse button. Checked before the keyboard-only
		-- gate below; `processed` keeps clicks on the menu itself from triggering it.
		if not processed and Utils.BindMatches(input, Config.AssistKey) then
			if Config.AssistMode == "Hold" then
				self._assistHeld = true
			elseif Config.AssistMode == "Toggle" then
				self._assistToggled = not self._assistToggled
				menu.Toast(if self._assistToggled then "Soft-lock ON" else "Soft-lock OFF")
			end
		end
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local k = input.KeyCode
		if k == Config.ToggleHudKey then
			Config.Enabled = not Config.Enabled
			menu.Refresh()
		elseif k == Config.ToggleMenuKey then
			menu.Toggle()
		elseif k == Config.SpectateNextKey then
			self:_specCycle(1)
		elseif k == Config.SpectatePrevKey then
			self:_specCycle(-1)
		elseif k == Config.FreecamKey then
			self:SetFreecam(not self._freecam)
		end
	end))
	j:Add(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and self._freecam then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if Utils.BindMatches(input, Config.AssistKey) then
			self._assistHeld = false
		end
	end))
	j:Add(UserInputService.InputChanged:Connect(function(input)
		if self._freecam and input.UserInputType == Enum.UserInputType.MouseMovement
			and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			self._fcYaw -= input.Delta.X * 0.003
			self._fcPitch = math.clamp(self._fcPitch - input.Delta.Y * 0.003, -1.5, 1.5)
		end
	end))

	-- Camera priority + 1: runs after the camera moved this frame, so
	-- projected positions match what is rendered.
	RunService:BindToRenderStep("TacticalHUD", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:Update(dt)
	end)
end

function HUDManager.Destroy(self: any)
	if self._destroyed then
		return
	end
	self._destroyed = true
	RunService:UnbindFromRenderStep("TacticalHUD")
	if self._freecam then
		self:SetFreecam(false)
	end
	self._specJanitor:Clean()
	self._janitor:Clean()
	self._camJanitor:Clean()
	for player in self._records do
		self:_removePlayer(player)
	end
	self._pool:Destroy()
	self._arrowPool:Destroy()
	self._folder:Destroy()
	self._overlay:Destroy()
	self._static:Destroy()
	if self._menu then
		self._menu.Destroy()
	end
end

----------------------------------------------------------------------
-- MAIN LOOP
----------------------------------------------------------------------
local manager = HUDManager.new()
manager:Start()

script.Destroying:Connect(function()
	manager:Destroy()
end)
