			}, row)
			accent(value, "TextColor3")
			local track = New("Frame", {
				Position = UDim2.new(0, 14, 1, -17), Size = UDim2.new(1, -28, 0, 6),
				BackgroundColor3 = if o.Rainbow then Color3.new(1, 1, 1) else Theme.Off, BorderSizePixel = 0,
			}, row)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
			local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Visible = not o.Rainbow }, track)
			accent(fill, "BackgroundColor3")
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
			New("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 185)) }, fill)
			if o.Rainbow then
				local keys = {}
				for i = 0, 6 do
					table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.85, 1)))
				end
				New("UIGradient", { Color = ColorSequence.new(keys) }, track)
			end
			local knob = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2,
			}, track)
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
			local bubble = New("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -8), Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Theme.Bg, BorderSizePixel = 0,
				Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.Text, Visible = false, ZIndex = 6, Text = "",
			}, knob)
			New("UICorner", { CornerRadius = UDim.new(0, 6) }, bubble)
			New("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, bubble)
			local bubbleStroke = New("UIStroke", { Thickness = 1 }, bubble)
			accent(bubbleStroke, "Color")
			local hit = New("TextButton", {
				Position = UDim2.new(0, 14, 1, -28), Size = UDim2.new(1, -28, 0, 26),
				BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
			}, row)
			hov(hit)

			local function fromX(x: number)
				local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				local v = if isLog then min * (max / min) ^ a else min + (max - min) * a
				if step then
					v = math.floor(v / step + 0.5) * step
				end
				set(math.clamp(v, min, max))
				onChange()
				refreshAll()
			end
			janitor:Add(hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					bubble.Visible = true
					tween(knob, fast, { Size = UDim2.fromOffset(16, 16) })
					activeDrag = function(i)
						fromX(i.Position.X)
					end
					activeEnd = function()
						bubble.Visible = false
						tween(knob, fast, { Size = UDim2.fromOffset(12, 12) })
					end
					fromX(input.Position.X)
				end
			end))
			register(function()
				local v = get()
				local a = if isLog then math.log(v / min) / math.log(max / min) else (v - min) / (max - min)
				a = math.clamp(a, 0, 1)
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.fromScale(a, 0.5)
				local s = fmt(v)
				value.Text = s
				bubble.Text = s
			end)
		end

