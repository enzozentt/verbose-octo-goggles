		-- Returns the row and a hover binder. A refcount keeps hover stable when
		-- the cursor moves between the row and the buttons layered on top of it.
		local function makeRow(height: number, text: string): (Frame, (GuiObject) -> ())
			local r = New("Frame", {
				Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = Theme.Row,
				BorderSizePixel = 0, LayoutOrder = nextOrder(),
			}, page)
			New("UICorner", { CornerRadius = UDim.new(0, 7) }, r)
			local edge = New("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 3, 0, 0), BorderSizePixel = 0,
			}, r)
			accent(edge, "BackgroundColor3")
			New("UICorner", { CornerRadius = UDim.new(1, 0) }, edge)
			table.insert(td.Rows, { Row = r, Text = (text .. " " .. (if curSection then curSection.Title else "")):lower(), Section = curSection })

			local count = 0
			local function setHover(on: boolean)
				tween(r, fast, { BackgroundColor3 = if on then Theme.RowHover else Theme.Row })
				tween(edge, fast, { Size = if on then UDim2.new(0, 3, 0.6, 0) else UDim2.new(0, 3, 0, 0) })
				menu.SetTip(if on then (Tips[text] or "") else "")
			end
			local function hov(obj: GuiObject)
				janitor:Add(obj.MouseEnter:Connect(function()
					count += 1
					if count == 1 then
						setHover(true)
					end
				end))
				janitor:Add(obj.MouseLeave:Connect(function()
					count = math.max(0, count - 1)
					if count == 0 then
						setHover(false)
					end
				end))
			end
			hov(r)
			return r, hov
		end
