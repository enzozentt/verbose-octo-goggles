	self._entityCount = 0
	self._ownerMap = setmetatable({}, { __mode = "k" }) :: { [Player]: Model } -- Player -> rig found by attribute
	self._rejected = setmetatable({}, { __mode = "k" }) :: { [Instance]: number }
	self._sweepToken = 0
	self._list = {} :: { Record } -- same records as an array, for the time-sliced rescan
	self._cursor, self._localTimer = 0, 0
	self._lastLocal = nil :: Model?
	self._count = 0
	self._cfgVersion = 0
