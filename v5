		end
	end))
	jan:Add(UserInputService.InputChanged:Connect(function(input)
		local moving = input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
		if not moving then
			return
		end
		if dragStart then
			local d = (input.Position - dragStart) / scale.Scale
			shell.Position = UDim2.new(dragOrigin.X.Scale, dragOrigin.X.Offset + d.X, dragOrigin.Y.Scale, dragOrigin.Y.Offset + d.Y)
		elseif activeSlider then
			activeSlider(input.Position.X)
		end
	end))
	jan:Add(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragStart, activeSlider = nil, nil
			if activeEnd then
				activeEnd()
				activeEnd = nil
			end
		end
