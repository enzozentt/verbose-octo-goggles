	function menu.SetVisible(v)
		shown = v
		token += 1
		local my = token
		fit() -- so the open animation always targets the current size
		if v then
			gui.Enabled = true
			win.GroupTransparency = 1
			shellStroke.Transparency = 1
			scale.Scale = baseScale * 0.965
			tween(win, ti(0.16), { GroupTransparency = 0 })
			tween(shellStroke, ti(0.16), { Transparency = 0 })
			tween(scale, ti(0.2), { Scale = baseScale })
			task.delay(0.22, function()
				if token == my then
					placeUnderline(false)
				end
			end)
		else
			tween(win, ti(0.11), { GroupTransparency = 1 })
			tween(shellStroke, ti(0.11), { Transparency = 1 })
			tween(scale, ti(0.12), { Scale = baseScale * 0.98 })
			task.delay(0.13, function()
				if token == my then
					gui.Enabled = false
				end
			end)
		end
	end
