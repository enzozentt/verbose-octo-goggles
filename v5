	janitor:Add(RunService.RenderStepped:Connect(function(dt)
		if not shown then
			return
		end
		local now = os.clock()
		if Config.AnimatedBorder then
			borderGrad.Rotation = (now * 45) % 360
		end
		-- logo breathes
		logoCore.Size = UDim2.fromOffset(6 + math.sin(now * 3) * 2, 6 + math.sin(now * 3) * 2)
		-- preview scanner sweep
		scan.Position = UDim2.fromOffset(0, ((now * 70) % (SH + 72)) - 36)
		-- preview health loop: hit -> damage trail drains -> heal
		local t = now % 4
		local hp, ghost = 1, 1
		if t < 1 then
			hp, ghost = 1, 1
		elseif t < 1.4 then
			hp, ghost = 0.55, 1
		elseif t < 2.2 then
			hp, ghost = 0.55, 1 - (t - 1.4) / 0.8 * 0.45
		elseif t < 3 then
			hp, ghost = 0.55, 0.55
		else
			hp = 0.55 + (t - 3) * 0.45
			ghost = hp
		end
		pvHp.Size = UDim2.fromScale(hp, 1)
		pvGhost.Size = UDim2.fromScale(ghost, 1)
		pvHp.BackgroundColor3 = Utils.HealthColor(hp)
		local hpInt = math.ceil(hp * 100)
		if hpInt ~= pvLastHp then
			pvLastHp = hpInt
			pvInfo.Text = if Config.ShowHealth then string.format("142m  |  %d HP", hpInt) else "142m"
		end

		fpsFrames += 1
		fpsTimer += dt
		if fpsTimer >= 0.5 then
			chip.Text = string.format("%d FPS  |  %d ms", math.floor(fpsFrames / fpsTimer + 0.5), math.floor(localPlayer:GetNetworkPing() * 1000))
			fpsFrames, fpsTimer = 0, 0
		end
	end))

