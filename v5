local function createMenu(janitor: Janitor, onChange: () -> ()): any
	local menu: any = {}
	local accentRefs = {} :: { { Inst: any, Prop: string } }
	local refreshers = {} :: { () -> () }
	local tabsData = {} :: { any }
	local current = 0
	local activeDrag: ((InputObject) -> ())? = nil
	local activeEnd: (() -> ())? = nil
	local listening: { Button: TextButton, Set: (EnumItem) -> (), AllowMouse: boolean }? = nil
	local shown = Config.MenuStartsVisible
	local minimized = false
	local showToken = 0
	local fast = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local med = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local slide = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

	local W, H, HEADER, RAIL, PREV, FOOT = 860, 520, 52, 72, 250, 24
	local CONTENT_W = W - RAIL - PREV

	local function tween(inst: Instance, info: TweenInfo, props: { [string]: any })
		TweenService:Create(inst, info, props):Play()
	end
	local function accent(inst: any, prop: string)
		table.insert(accentRefs, { Inst = inst, Prop = prop })
		inst[prop] = Theme.Accent
	end
	local function register(f: () -> ())
		table.insert(refreshers, f)
		f()
	end
	local function refreshAll()
		for _, f in refreshers do
			f()
		end
	end
	menu.Refresh = refreshAll
	menu.Register = register

