		TweenService:Create(inst, info, props):Play()
	end
	local function accent(inst, prop)
		accentRefs[#accentRefs + 1] = { inst, prop }
		inst[prop] = Theme.Accent
	end
	local function register(f)
		refreshers[#refreshers + 1] = f
		f()
	end
